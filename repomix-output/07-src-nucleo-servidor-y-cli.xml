      failure.resolveCleanup();
      this.#cleanupFailures.delete(failure);
    }
  }
  #trackCleanupFailure(
    failure: AnalysisError,
    roots: readonly ArtifactAnalysisRuntime[],
    primaryFailure: AnalysisError | undefined,
