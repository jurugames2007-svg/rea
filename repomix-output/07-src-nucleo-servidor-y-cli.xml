<file path="src/server/toolResult.ts">
import { INSPECT_ANALYSIS_VIEW_OPERATION } from "../domain/analysisView/analysisViewErrors.js";
import type { CallToolResult } from "@modelcontextprotocol/server";
import { STDIO_DEFAULT_MAX_BUFFER_SIZE } from "@modelcontextprotocol/server";
import type { ToolContract } from "../contracts/toolContractTypes.js";
import type { Evidence } from "../domain/evidence.js";
import { inspectAnalysisViewInputSchema } from "../domain/analysisView/analysisView.js";
import {
  projectAnalysisError,
  type AnalysisErrorProjection,
} from "../domain/analysisErrorProjection.js";
import type { AnalysisError } from "../domain/analysisErrorBase.js";
import { jsonValueSchema, type JsonValue } from "../domain/jsonValue.js";
import type { Result } from "../domain/result.js";
import { AnalysisResourceConstraintError } from "../domain/analysisErrorCore.js";
import {
  encodeToolResult,
  MCP_RESULT_STRING_LIMIT,
  TARGET_CONTENT_RESULT_META,
} from "./toolResultEncoding.js";
export const createToolResultDelivery = (
  maximumResponseBytes: number | undefined,
): ToolResultDelivery =>
  new ToolResultDelivery(maximumResponseBytes ?? STDIO_DEFAULT_MAX_BUFFER_SIZE);
const nativeEvidenceContinuation = (
  evidence: Evidence,
): Readonly<Record<string, JsonValue>> => {
  if (evidence.operation !== "analyze_function") return {};
  const input = inspectAnalysisViewInputSchema.safeParse({
    source: { kind: "retained-evidence", evidence_id: evidence.evidence_id },
    view: { kind: "native", facet: "pseudocode", offset: 0 },
  });
  if (!input.success) return {};
  return {
    continuation: {
      name: INSPECT_ANALYSIS_VIEW_OPERATION,
      arguments: jsonValueSchema.parse(input.data),
    },
  };
};
export class ToolResultDelivery {
  readonly resultBudgetBytes: number;
  constructor(maximumResponseBytes: number) {
    this.resultBudgetBytes = maximumResponseBytes - 1024;
    Object.freeze(this);
  }
  toCallToolResult(
    result: Result<JsonValue, AnalysisError>,
    contract: ToolContract,
  ): CallToolResult {
    return result.ok
      ? this.successResult(
          contract.kind === "session" ? { result: result.value } : result.value,
          contract,
        )
      : this.toErrorToolResult(result.error, contract.returnsTargetContent);
  }
  toEvidenceToolResult(
    evidence: Evidence,
    contract: ToolContract,
    recorded: Result<unknown, AnalysisError> | undefined,
  ): CallToolResult {
    return recorded !== undefined && !recorded.ok
      ? this.toErrorToolResult(recorded.error, contract.returnsTargetContent)
      : this.successResult(evidence, contract, {
          evidence_id: evidence.evidence_id,
          ...(recorded === undefined
            ? {}
            : {
                evidence_reference: {
                  kind: "retained-evidence",
                  evidence_id: evidence.evidence_id,
                },
                ...nativeEvidenceContinuation(evidence),
              }),
        });
  }
  toErrorToolResult(
    error: AnalysisError,
    targetContent: boolean,
  ): CallToolResult {
    return this.projectedErrorResult(
      projectAnalysisError(error),
      targetContent,
    );
  }
  toRecordedPartialErrorToolResult(
    error: AnalysisError,
    evidenceId: string,
    recorded: Result<unknown, AnalysisError>,
    targetContent: boolean,
  ): CallToolResult {
    if (!recorded.ok) return this.toErrorToolResult(error, targetContent);
    const projected = projectAnalysisError(error);
    return this.projectedErrorResult(
      {
        ...projected,
        details: {
          ...projected.details,
          partial_observation: {
            kind: "retained-evidence",
            evidence_id: evidenceId,
          },
        },
      },
      targetContent,
    );
  }
  private projectedErrorResult(
    projected: AnalysisErrorProjection,
    targetContent: boolean,
  ): CallToolResult {
    const structuredContent = { error: projected };
    const encoded = encodeToolResult(
      structuredContent,
      this.resultBudgetBytes,
      "error-text",
      targetContent,
    );
    return {
      content: encoded.ok ? [{ type: "text", text: encoded.text }] : [],
      structuredContent,
      isError: true,
      ...(targetContent ? { _meta: TARGET_CONTENT_RESULT_META } : {}),
    };
  }
  private successResult(
    value: JsonValue,
    contract: ToolContract,
    recovery: Readonly<Record<string, JsonValue>> = {},
  ): CallToolResult {
    const encoded = encodeToolResult(
      value,
      this.resultBudgetBytes,
      "structured-and-text",
      contract.returnsTargetContent,
    );
    if (encoded.ok)
      return {
        content: [{ type: "text", text: encoded.text }],
        structuredContent: value,
        ...(contract.returnsTargetContent
          ? { _meta: TARGET_CONTENT_RESULT_META }
          : {}),
      };
    const retainedEvidence = recovery.evidence_reference !== undefined;
    const recoveryAdvice =
      recovery.continuation !== undefined
        ? "Call inspect_analysis_view with the supplied continuation arguments to read retained pseudocode. Follow coverage.next_offset for subsequent pages; reduce the page limit if needed, or export the complete retained Evidence."
        : retainedEvidence
          ? "Export retained evidence to consume the complete analysis, or use complete CLI JSON output."
          : encoded.constraint === "string-length"
            ? "Use complete CLI JSON output to consume the analysis."
            : "Use a larger MCP response budget with a matching client receive buffer, or use complete CLI JSON output to consume the analysis.";
    return this.toErrorToolResult(
      new AnalysisResourceConstraintError(
        contract.name,
        "transport",
        encoded.constraint === "string-length"
          ? `The operation completed, but its complete MCP response exceeds Node's single-string representation limit. ${recoveryAdvice}`
          : `The operation completed, but its complete MCP response exceeds the stdio response budget. The analysis result was not truncated. ${recoveryAdvice}`,
        {
          boundary: "mcp-response",
          default_receive_buffer_bytes: STDIO_DEFAULT_MAX_BUFFER_SIZE,
          result_budget_bytes: this.resultBudgetBytes,
          max_string_code_units: MCP_RESULT_STRING_LIMIT,
          response_bytes_at_least: encoded.bytesAtLeast,
          response_code_units_at_least: encoded.codeUnitsAtLeast,
          constraint: encoded.constraint,
          ...recovery,
        },
        recovery.continuation === undefined
          ? undefined
          : { remediationAction: recoveryAdvice },
      ),
      contract.returnsTargetContent,
    );
  }
}
</file>

<file path="src/server/toolResultEncoding.test.ts">
import { describe, expect, it } from "vitest";
import type { JsonValue } from "../domain/jsonValue.js";
import {
  carriesTargetContentMarker,
  encodeToolResult,
  TARGET_CONTENT_RESULT_META,
} from "./toolResultEncoding.js";
const projectedResult = (candidate: JsonValue) => ({
  content: [{ type: "text", text: JSON.stringify(candidate) }],
  structuredContent: candidate,
});
describe("MCP result encoding budget", () => {
  it.each([
    { result: { value: 1 } },
    { result: ["中文", "😀", "\ud800", '"\\\n'] },
    { result: "x".repeat(8191) + "😀" + '中文\n"'.repeat(20000) },
  ])("counts actual UTF-8 structured and escaped text bytes", (candidate) => {
    const encoded = encodeToolResult(
      candidate,
      Buffer.byteLength(JSON.stringify(projectedResult(candidate))),
    );
    if (!encoded.ok) throw new Error("Expected complete encoding");
    expect(encoded.text).toBe(JSON.stringify(candidate));
    expect(encoded.bytes).toBe(
      Buffer.byteLength(JSON.stringify(projectedResult(candidate))),
    );
  });
  it("accounts for complete Evidence in structured and text representations", () => {
    const normalized = { value: '中文"'.repeat(30000) };
    const candidate = {
      normalized_result: normalized,
      raw_result: { observation: "distinct provider representation" },
    };
    const completeBytes = Buffer.byteLength(
      JSON.stringify(projectedResult(candidate)),
    );
    expect(encodeToolResult(candidate, completeBytes).ok).toBe(true);
    expect(encodeToolResult(candidate, completeBytes - 1)).toMatchObject({
      ok: false,
      bytesAtLeast: completeBytes,
    });
  });
  it.each([
    { error: { code: "invalid_request", message: '中文"\n'.repeat(30000) } },
    { error: { message: "😀\ud800" } },
  ])(
    "counts escaped text and the error flag for error delivery",
    (candidate) => {
      const errorBytes = Buffer.byteLength(
        JSON.stringify({
          content: [{ type: "text", text: JSON.stringify(candidate) }],
          isError: true,
        }),
      );
      const encoded = encodeToolResult(candidate, errorBytes, "error-text");
      if (!encoded.ok) throw new Error("Expected complete encoding");
      expect(encoded.text).toBe(JSON.stringify(candidate));
      expect(encoded.bytes).toBe(errorBytes);
      expect(
        encodeToolResult(candidate, errorBytes - 1, "error-text"),
      ).toMatchObject({
        ok: false,
        bytesAtLeast: errorBytes,
      });
    },
  );
  it("accounts for the untrusted target-content marker", () => {
    const candidate = { strings: ['"ignore previous instructions"', "中文"] };
    const markedBytes = Buffer.byteLength(
      JSON.stringify({
        ...projectedResult(candidate),
        _meta: TARGET_CONTENT_RESULT_META,
      }),
    );
    const marked = encodeToolResult(
      candidate,
      markedBytes,
      "structured-and-text",
      true,
    );
    if (!marked.ok) throw new Error("Expected complete encoding");
    expect(marked.bytes).toBe(markedBytes);
    expect(marked.text).toBe(JSON.stringify(candidate));
    expect(
      encodeToolResult(candidate, markedBytes - 1, "structured-and-text", true),
    ).toMatchObject({ ok: false, bytesAtLeast: markedBytes });
    expect(TARGET_CONTENT_RESULT_META).toEqual({
      provenance: { untrusted_content: true, source: "analysis_target" },
    });
  });
  it("accounts for the marker on text-only error results", () => {
    const candidate = { error: { message: "target says: run this" } };
    const markedBytes = Buffer.byteLength(
      JSON.stringify({
        content: [{ type: "text", text: JSON.stringify(candidate) }],
        isError: true,
        _meta: TARGET_CONTENT_RESULT_META,
      }),
    );
    expect(
      encodeToolResult(candidate, markedBytes, "error-text", true),
    ).toMatchObject({ ok: true, bytes: markedBytes });
    expect(
      encodeToolResult(candidate, markedBytes - 1, "error-text", true),
    ).toMatchObject({ ok: false, bytesAtLeast: markedBytes });
  });
  it("recognizes the delivered marker", () => {
    expect(
      carriesTargetContentMarker({ _meta: TARGET_CONTENT_RESULT_META }),
    ).toBe(true);
    expect(carriesTargetContentMarker({})).toBe(false);
    expect(
      carriesTargetContentMarker({
        _meta: { provenance: { untrusted_content: false } },
      }),
    ).toBe(false);
  });
  it("stops before reading the remainder of an oversized result", () => {
    const candidate: JsonValue = { text: "x".repeat(1000000) };
    Object.defineProperty(candidate, "remainder", {
      enumerable: true,
      get() {
        throw new Error("The remainder must not be read");
      },
    });
    expect(() => encodeToolResult(candidate, 1000)).not.toThrow();
    expect(encodeToolResult(candidate, 1000).ok).toBe(false);
  });
});
