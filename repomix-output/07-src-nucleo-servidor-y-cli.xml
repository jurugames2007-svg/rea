          if (recordedSource !== undefined && !recordedSource.ok)
            return server.delivery.toCallToolResult(
              recordedSource,
              reconstructionContract,
            );
          const recorded = options.recordEvidence?.(result.value);
          return server.delivery.toEvidenceToolResult(
            result.value,
