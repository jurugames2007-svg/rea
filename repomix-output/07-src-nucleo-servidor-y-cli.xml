    ...accountFullyObservedProcessCapture({
      ...verified,
      frames: [{ sequence: 0, at_ms: 0, data: "observed output" }],
      process_samples: [
        {
          at_ms: 1,
          pid: 654,
          parent_pid: 321,
          command: "sanitized-detached-child",
          process_group_id: 654,
          session_id: 654,
        },
      ],
    }),
