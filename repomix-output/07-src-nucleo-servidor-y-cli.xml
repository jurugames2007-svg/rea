  try {
    await chmod(socketPath, 0o600);
  } catch (cause: unknown) {
    await closeServer(server);
    throw cause;
  }
  let released = false;
  return {
    acquired: true,
    lease: {
      socketPath,
      release: async () => {
        if (released) return;
        await closeServer(server);
        released = true;
