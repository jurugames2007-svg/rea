  logger[result.ok ? "info" : "warn"](
    {
      tool,
      durationMs: Math.round((performance.now() - startedAt) * 100) / 100,
      status: result.ok ? "ok" : "error",
    },
    "MCP tool execution completed",
  );
  return result;
};
