<file path="src/server/registerReverseEngineeringTools.ts">
import { projectAnalysisError } from "../domain/analysisErrorProjection.js";
import type {
  CallToolResult,
  McpServer,
  ServerContext,
} from "@modelcontextprotocol/server";
import type { Logger } from "pino";
import type { ReverseEngineeringService } from "../application/reverse/ReverseEngineeringService.js";
import type { EvidenceWriter } from "../application/investigation/InvestigationRecordPort.js";
import type { Evidence } from "../domain/evidence.js";
import { toolContract } from "../contracts/toolContracts.js";
import type { ToolContract } from "../contracts/toolContractTypes.js";
import { logToolExecution } from "./toolLogging.js";
import { toolRegistrationOptions } from "./toolRegistrationOptions.js";
import type { ToolResultDelivery } from "./toolResult.js";
import type { WithAdmittedAnalysis } from "./analysisAdmission.js";
import { rizinInputSchema } from "../domain/reverseEngineering.js";
import { AnalysisOutputError } from "../domain/analysisErrorCore.js";
import type { AnalysisError } from "../domain/analysisErrorBase.js";
import type { Result } from "../domain/result.js";
export const registerReverseEngineeringTools = (
  server: McpServer,
  service: ReverseEngineeringService,
  logger: Logger,
  delivery: ToolResultDelivery,
  recordEvidence?: EvidenceWriter["recordEvidence"],
  withAdmittedAnalysis?: WithAdmittedAnalysis,
  invalidateSnapshotForExternalMutation?: () => void,
  withAdmittedExternalMutation?: <Value>(
    path: string | undefined,
    signal: AbortSignal | undefined,
    operation: () => Promise<Result<Value, AnalysisError>>,
    retirementFailure: (
      value: Result<Value, AnalysisError>,
      error: AnalysisError,
    ) => AnalysisError,
  ) => Promise<Result<Result<Value, AnalysisError>, AnalysisError>>,
): void => {
  const objdump = toolContract("inspect_with_objdump");
  const rizin = toolContract("execute_rizin_command");
  server.registerTool(
    objdump.name,
    toolRegistrationOptions(objdump),
    (input, context: ServerContext) =>
      runAdmitted(
        objdump,
        context,
        withAdmittedAnalysis,
        delivery,
        async () => {
          const result = await logToolExecution(logger, objdump.name, () =>
            service.inspectWithObjdump(input, {
              signal: context.mcpReq.signal,
            }),
          );
          if (!result.ok)
            return deliverFailure(
              result.error,
              objdump,
              delivery,
              recordEvidence,
            );
          return delivery.toEvidenceToolResult(
            result.value,
            objdump,
            recordEvidence?.(result.value),
          );
        },
      ),
  );
  server.registerTool(
    rizin.name,
    toolRegistrationOptions(rizin),
    async (input, context: ServerContext) => {
      const parsed = rizinInputSchema.safeParse(input);
      if (parsed.success && withAdmittedExternalMutation !== undefined) {
        const cleanup = await service.retryCleanup(rizin.name);
        if (!cleanup.ok)
          return deliverFailure(cleanup.error, rizin, delivery, recordEvidence);
        const admitted = await withAdmittedExternalMutation(
          parsed.data.path,
          context.mcpReq.signal,
          async () => {
            invalidateSnapshotForExternalMutation?.();
            return logToolExecution(logger, rizin.name, () =>
              service.executeRizinCommand(parsed.data, {
                signal: context.mcpReq.signal,
              }),
            );
          },
          (value, cause) => {
            if (!value.ok)
              return value.error.retainSecondaryFailure(cause, {
                retirement_error: projectAnalysisError(cause),
              });
            const observation = value.value;
            return new AnalysisOutputError(
              rizin.name,
              "Rizin may have changed the bound artifact, but the active analysis session could not be retired.",
              {
                cause,
                ...(cause.cleanup === undefined
                  ? {}
                  : { cleanup: cause.cleanup }),
                ...(cause.capturedOutput === undefined
                  ? {}
                  : { capturedOutput: cause.capturedOutput }),
                ...(observation === undefined
                  ? {}
                  : { partialObservation: observation }),
              },
            );
          },
        );
        if (!admitted.ok)
          return deliverFailure(
            admitted.error,
            rizin,
            delivery,
            recordEvidence,
          );
        const result = admitted.value;
        if (!result.ok)
          return deliverFailure(result.error, rizin, delivery, recordEvidence);
        return delivery.toEvidenceToolResult(
          result.value,
          rizin,
          recordEvidence?.(result.value),
        );
      }
      return runAdmitted(
        rizin,
        context,
        withAdmittedAnalysis,
        delivery,
        async () => {
          if (
            invalidateSnapshotForExternalMutation !== undefined &&
            rizinInputSchema.safeParse(input).success
          )
            invalidateSnapshotForExternalMutation();
          const result = await logToolExecution(logger, rizin.name, () =>
            service.executeRizinCommand(input, {
              signal: context.mcpReq.signal,
            }),
          );
          if (!result.ok)
            return deliverFailure(
              result.error,
              rizin,
              delivery,
              recordEvidence,
            );
          return delivery.toEvidenceToolResult(
            result.value,
            rizin,
            recordEvidence?.(result.value),
          );
        },
      );
    },
  );
};
const runAdmitted = async (
  contract: ToolContract,
  context: ServerContext,
  admission: WithAdmittedAnalysis | undefined,
  delivery: ToolResultDelivery,
  operation: () => Promise<CallToolResult>,
): Promise<CallToolResult> => {
  if (admission === undefined) return operation();
  const admitted = await admission(
    contract.name,
    context.mcpReq.signal,
    async () => operation(),
  );
  return admitted.ok
    ? admitted.value
    : delivery.toErrorToolResult(admitted.error, contract.returnsTargetContent);
};
const deliverFailure = (
  error: import("../domain/analysisErrorBase.js").AnalysisError,
  contract: ToolContract,
  delivery: ToolResultDelivery,
  recordEvidence?: EvidenceWriter["recordEvidence"],
) => {
  const partial = error.partialObservation;
  if (isEvidence(partial) && recordEvidence !== undefined)
    return delivery.toRecordedPartialErrorToolResult(
      error,
      partial.evidence_id,
      recordEvidence(partial),
      contract.returnsTargetContent,
    );
  return delivery.toErrorToolResult(error, contract.returnsTargetContent);
};
const isEvidence = (value: unknown): value is Evidence =>
  typeof value === "object" &&
  value !== null &&
  "evidence_id" in value &&
  typeof value.evidence_id === "string";
</file>

<file path="src/server/registerRizinDebugTools.ts">
import type { McpServer, ServerContext } from "@modelcontextprotocol/server";
import type { Logger } from "pino";
import type { EvidenceWriter } from "../application/investigation/InvestigationRecordPort.js";
import { toolContract } from "../contracts/toolContracts.js";
import { AnalysisInputError } from "../domain/analysisErrorCore.js";
import type { RizinDebugSessionManager } from "../rizin/RizinDebugSessionManager.js";
import { evidenceSchema } from "../domain/evidence.js";
import {
  runOwnedCleanupWithExternalMutationAdmission,
  runWithExternalMutationAdmission,
  type ExternalMutationAdmission,
} from "./externalMutationAdmission.js";
import { logToolExecution } from "./toolLogging.js";
import { toolRegistrationOptions } from "./toolRegistrationOptions.js";
import type { ToolResultDelivery } from "./toolResult.js";
export type RizinDebugToolManager = Pick<
  RizinDebugSessionManager,
  "start" | "execute" | "status" | "close" | "retryCleanupFailures"
>;
export const registerRizinDebugTools = (
  server: McpServer,
  manager: RizinDebugToolManager,
  logger: Logger,
  delivery: ToolResultDelivery,
  recordEvidence?: EvidenceWriter["recordEvidence"],
  session?: ExternalMutationAdmission,
): void => {
  const start = toolContract("start_rizin_debug_session");
  const command = toolContract("rizin_debug_command");
  const status = toolContract("rizin_debug_session_status");
  const close = toolContract("close_rizin_debug_session");
  server.registerTool(
    start.name,
    toolRegistrationOptions(start),
    async (input, context: ServerContext) => {
      const result = await runWithExternalMutationAdmission(
        session,
        start.name,
        context.mcpReq.signal,
        () =>
          logToolExecution(logger, start.name, () =>
            manager.start(
              {
                path: input.path,
                inferior_tty: input.inferior_tty,
                ...(input.backend === undefined
                  ? {}
                  : { backend: input.backend }),
              },
              context.mcpReq.signal,
            ),
          ),
        undefined,
        () => manager.retryCleanupFailures(),
        (value) => ({ session_id: value.session_id }),
      );
      return result.ok
        ? delivery.toCallToolResult({ ok: true, value: result.value }, start)
        : delivery.toCallToolResult(result, start);
    },
  );
  server.registerTool(
    command.name,
    toolRegistrationOptions(command),
    async (input, context: ServerContext) => {
      const result = await runWithExternalMutationAdmission(
        session,
        command.name,
        context.mcpReq.signal,
        () =>
          logToolExecution(logger, command.name, () =>
            manager.execute(
              input.session_id,
              input.command,
              context.mcpReq.signal,
            ),
          ),
        (value) => value.evidence,
        () => manager.retryCleanupFailures(),
      );
      if (!result.ok) {
        const partial = evidenceSchema.safeParse(
          result.error.partialObservation,
        );
        if (partial.success) {
          const recorded = recordEvidence?.(partial.data);
          if (recorded !== undefined)
            return delivery.toRecordedPartialErrorToolResult(
              result.error,
              partial.data.evidence_id,
              recorded,
              command.returnsTargetContent,
            );
        }
        return delivery.toCallToolResult(result, command);
      }
      return delivery.toEvidenceToolResult(
        result.value.evidence,
        command,
        recordEvidence?.(result.value.evidence),
      );
    },
  );
  server.registerTool(
    status.name,
    toolRegistrationOptions(status),
    async (input) => {
      const result = manager.status(input.session_id);
      if (result === undefined)
        return delivery.toCallToolResult(
          { ok: false, error: new AnalysisInputError(status.name) },
          status,
        );
      return delivery.toCallToolResult(
        {
          ok: true,
          value: { ...result, recent_output: [...result.recent_output] },
        },
        status,
      );
    },
  );
  server.registerTool(
    close.name,
    toolRegistrationOptions(close),
    async (input, context: ServerContext) => {
      const result = await runOwnedCleanupWithExternalMutationAdmission(
        session,
        close.name,
        context.mcpReq.signal,
        input.session_id,
        () =>
          logToolExecution(logger, close.name, () =>
            manager.close(input.session_id),
          ),
      );
      return result.ok
        ? delivery.toCallToolResult({ ok: true, value: result.value }, close)
        : delivery.toCallToolResult(result, close);
    },
  );
};
</file>

