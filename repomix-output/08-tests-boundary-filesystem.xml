    { result: string; outputs?: Record<string, string> }
  > = {};
  for (const name of z.array(z.string()).parse(jobs.required?.needs)) {
    results[name] = {
      result:
        name === overrides.failed
          ? "failure"
          : changes.tier === "reused"
            ? "skipped"
            : "success",
    };
