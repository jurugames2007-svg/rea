  await writeFile(
    join(root, "package-lock.json"),
    JSON.stringify({
      packages: {
        "": {
          dependencies: { alpha: "1.0.0" },
          devDependencies: { beta: "2.0.0" },
        },
        "node_modules/alpha": { version: "1.0.0" },
