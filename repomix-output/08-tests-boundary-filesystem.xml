  if (options.mergePullRequest) {
    await git(directory, ["switch", "main"]);
    await git(
      directory,
      [
        "merge",
        "--no-ff",
        "change/contracts",
        "-m",
        "Merge pull request #948 from fixture/absolute-paths",
        "-m",
        subject,
      ],
      "2026-01-02T00:00:00Z",
