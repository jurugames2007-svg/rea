    properties: "application.version=12.1.4\n",
    compilerStatus: 1,
    error: "bridge/ghidra/ReaGhidraBridge.java:1: error: cannot find symbol",
  },
  { name: "colon separator", properties: "application.version : 12.1.4\n" },
  {
