      'case "$*" in',
      '  *actions/artifacts*) cat "$GH_FIXTURE_RESPONSE" ;;',
      "  *actions/runs/7*) node -e 'const x=require(process.env.GH_FIXTURE_RESPONSE); process.stdout.write(JSON.stringify(x.run))' ;;",
      "  *) exit 2 ;;",
      "esac",
      "",
