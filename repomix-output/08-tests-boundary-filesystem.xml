  results.changes = { result: "success", outputs: changes };
  const receiptDirectory = join(directory, ".cache", "receipt");
  const output = join(directory, "github-output");
  await writeFile(output, "");
  const env = {
    ...process.env,
    CI_JOBS: JSON.stringify(results),
