          reason: expect.stringContaining(closeFailure.message),
        },
      });
      expect(closeCalls).toBe(3);
      allowClose = true;
      await resources.close();
      expect(closeCalls).toBe(4);
      expect(openedHandle.fd).toBe(-1);
    } finally {
      allowClose = true;
      await resources.close().catch(() => undefined);
    }
  });
