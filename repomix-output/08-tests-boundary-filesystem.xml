        if (offset >= groupEnd) {
          if (result.code !== 0 || !result.stdout.includes("no changes made"))
            failures.push(`${context}: complete script did not dry-run`);
          return;
        }
        if (result.stdout !== "")
          failures.push(`${context}: stdout ${JSON.stringify(result.stdout)}`);
