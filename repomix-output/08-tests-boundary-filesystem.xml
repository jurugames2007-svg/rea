function completedJobs(
  name: string,
  conclusion: string,
  startedAt: string,
  seconds: number,
) {
  return [
    {
      jobs: [
        {
          name,
          status: "completed",
          conclusion,
          created_at: startedAt,
          started_at: startedAt,
          completed_at: new Date(
