      );
      expect(call?.source_node_id).toBe(entry?.target_node_id);
      const lazy = graph.edges.find(
        (edge) =>
          edge.source_node_id === entry?.target_node_id &&
          edge.properties.specifier === `chunk:${chunk}`,
      );
