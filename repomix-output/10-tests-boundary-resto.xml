<file path="tests/boundary/cli/hopperLaunchFailureCli.test.ts">
import { chmod, copyFile, rm } from "node:fs/promises";
import { describe, expect } from "vitest";
import { z } from "zod";
import { workspaceCliTest } from "../../support/cli/workspaceCliFixture.js";
import { acquireHopperTargetLease } from "../../../src/process/HopperLease.js";
const FAILED_LAUNCHER = `#!/bin/sh
printf 'Cannot launch Hopper!\\nDocument state is unknown.\\n' >&2
exit 2
`;
const RetainedRuntime = z.object({
  details: z.object({
    diagnostics: z.object({
      cleanup_error: z.object({
        details: z.object({
          diagnostics: z.object({ runtime_root: z.string() }),
        }),
      }),
    }),
  }),
});
describe("Hopper launcher failure through the one-shot CLI", () => {
  workspaceCliTest.skipIf(process.platform !== "darwin")(
    "exits after a retained-cleanup failure and releases the target to a retry",
    { timeout: 90_000 },
    async ({ cli, workspace }) => {
      const launcherPath = await workspace.write(
        "failure-helper",
        FAILED_LAUNCHER,
      );
      await chmod(launcherPath, 0o700);
      const targetPath = workspace.path("probe");
      await copyFile("/usr/bin/true", targetPath);
      const loaderArgs = ["--probe"];
      try {
        for (const attempt of ["first", "retry"]) {
          const result = await cli.run({
            arguments: [
              "analyze",
              targetPath,
              "--provider",
              "hopper",
              "--json",
            ],
            environment: {
              ...workspace.environment,
              HOPPER_LAUNCHER_PATH: launcherPath,
              HOPPER_LOADER_ARGS_JSON: JSON.stringify(loaderArgs),
              REA_LOG_LEVEL: "silent",
            },
            timeoutMs: 45_000,
          });
          const retained = RetainedRuntime.safeParse(result.json);
          if (retained.success)
            await rm(
              retained.data.details.diagnostics.cleanup_error.details
                .diagnostics.runtime_root,
              { recursive: true, force: true },
            );
          expect(result.exitCode, attempt).toBe(1);
          expect(result.json, attempt).toMatchObject({
            code: "cleanup_incomplete",
            details: {
              cleanup: "incomplete",
              diagnostics: {
                primary_error: {
                  code: "provider_unavailable",
                  details: {
                    stage: "launch",
                    launcher: {
                      exit_code: 2,
                      stderr: {
                        text: expect.stringContaining(
                          "Document state is unknown",
                        ),
                      },
                    },
                  },
                },
              },
            },
          });
        }
      } finally {
        const recovered = await acquireHopperTargetLease({
          targetPath,
          targetKind: "executable",
          loaderArgs,
          runId: "failed-cli-test-cleanup",
        });
        expect(recovered.acquired).toBe(true);
        if (recovered.acquired) await recovered.lease.release();
      }
    },
  );
});
</file>

<file path="tests/boundary/cli/httpCaptureComparison.test.ts">
import { writeFile } from "node:fs/promises";
import { join } from "node:path";
import { expect, it } from "vitest";
import { webPageInspectionSchema } from "../../../src/domain/browserObservationSchemas.js";
import { parseEvidence } from "../../../src/domain/evidence.js";
import { runCliJson } from "../../fixtures/cliJsonProcess.js";
import { startHttpComparisonBrowser } from "../../fixtures/httpComparisonBrowser.js";
import { createTestTempDirectory } from "../../fixtures/temporaryDirectory.js";
it("CLI compares incomplete HTTP responses without inventing changes", async () => {
  const root = await createTestTempDirectory("rea-http-comparison-");
  const response = {
    requestId: "request-1",
    status: 200,
    mimeType: "application/json",
  };
  const fixture = await startHttpComparisonBrowser([response]);
  try {
    const inspect = async () =>
      webPageInspectionSchema.parse(
        parseEvidence(
          await runCliJson([
            "inspect-web-page",
            fixture.browser.endpoint,
            "allowed-page",
            "--observation-ms",
            "0",
            "--json",
          ]),
        ).normalized_result,
      );
    const pending = await inspect();
    fixture.setRequests([{ ...response, encodedDataLength: 100 }]);
    const finished = await inspect();
    fixture.setRequests([{ ...response, status: 500, encodedDataLength: 100 }]);
    const changed = await inspect();
    expect(pending.network.requests).toMatchObject([
      { status: 200, mime_type: "application/json", encoded_data_length: null },
    ]);
    expect(finished.network.requests).toMatchObject([
      { status: 200, mime_type: "application/json", encoded_data_length: 100 },
    ]);
    const paths = [pending, finished, changed].map((_, index) =>
      join(root, `capture-${String(index)}.json`),
    );
    await Promise.all(
      [pending, finished, changed].map((inspection, index) =>
        writeFile(paths[index]!, JSON.stringify({ inspection })),
      ),
    );
    for (const [left, right, status, count] of [
      [0, 1, "unknown", 0],
      [1, 0, "unknown", 0],
      [0, 2, "changed", 1],
    ] as const) {
      const compared = await runCliJson([
        "compare-web-captures",
        paths[left]!,
        paths[right]!,
        "--json",
      ]);
      expect(compared).toMatchObject({
        operation: "compare_web_captures",
        normalized_result: {
          overall_status: status,
          dimensions: {
            network: { status, total_changes: count },
          },
        },
      });
    }
  } finally {
    await fixture.browser.close();
  }
}, 60_000);
