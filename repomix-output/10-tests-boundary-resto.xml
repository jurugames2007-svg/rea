<file path="tests/boundary/browser/optionalSourceMapRequire.test.ts">
import { createHash } from "node:crypto";
import { createServer } from "node:http";
import { expect, it } from "vitest";
import { fetchWebSourceMaps } from "../../../src/browser/WebSourceMapFetcher.js";
import { analyzeWebBundleInputSchema } from "../../../src/domain/webBundleAnalysis.js";
it("retains unshadowed optional require dependencies from HTTP source-map originals", async () => {
  const source = [
    'require("./normal.cjs");',
    'require?.("./optional.cjs");',
    'function local(require) { require?.("./shadowed.cjs"); }',
    "require?.(selectedModule);",
  ].join("\n");
  const text = JSON.stringify({
    version: 3,
    names: [],
    mappings: "AAAA",
    sources: ["main.cjs"],
    sourcesContent: [source],
  });
  const server = createServer((_request, response) => response.end(text));
  try {
    await new Promise<void>((resolve, reject) => {
      server.once("error", reject);
      server.listen(0, "127.0.0.1", resolve);
    });
    const address = server.address();
    if (address === null || typeof address === "string")
      throw new TypeError("Expected a TCP listener address");
    const origin = `http://127.0.0.1:${String(address.port)}`;
    const url = `${origin}/app.js.map`;
    const result = await fetchWebSourceMaps(
      [{ scriptKey: `scr_${"1".repeat(64)}`, declaredUrl: url, fetchUrl: url }],
      analyzeWebBundleInputSchema.parse({
        cdp_endpoint: origin,
        target_id: "fixture",
        allowed_origins: [origin],
        fetch_source_maps: true,
      }),
    );
    expect(result.items[0]).toMatchObject({
      status: "included",
      artifact: {
        text,
        bytes: Buffer.byteLength(text),
        sha256: createHash("sha256").update(text).digest("hex"),
      },
      original_sources: [{ artifact: { text: source } }],
      original_module_edges: ["./normal.cjs", "./optional.cjs"].map(
        (specifier) => ({
          from_source: `${origin}/main.cjs`,
          kind: "require",
          specifier,
          resolved_source: new URL(specifier, origin).href,
        }),
      ),
    });
  } finally {
    server.closeAllConnections();
    if (server.listening)
      await new Promise<void>((resolve, reject) => {
        server.close((error) =>
          error === undefined ? resolve() : reject(error),
        );
      });
  }
});
</file>

<file path="tests/boundary/browser/runtimeFixtureCleanup.test.ts">
import { execFile } from "node:child_process";
import { readdir } from "node:fs/promises";
import { promisify } from "node:util";
import { expect, it } from "vitest";
import { createTestTempDirectory } from "../../fixtures/temporaryDirectory.js";
it.skipIf(process.platform === "win32")(
  "rejects an exited fixture before returning a lease and removes its profile",
  async () => {
    const root = await createTestTempDirectory("rea-runtime-startup-failure-");
    const helper = new URL(
      "../../../scripts/lib/browser-runtime-fixture-lifecycle.mjs",
      import.meta.url,
    );
    const script = `
      const { startRuntimeFixtureBrowser } = await import(${JSON.stringify(helper.href)});
      // Node rejects Chrome's arguments immediately, exercising actual process exit.
      try {
        const fixture = await startRuntimeFixtureBrowser(process.execPath, 'http://127.0.0.1');
        await fixture.close();
        throw new Error('Expected startup failure');
      } catch (error) {
        if (error._tag !== 'BrowserStartupError') throw error;
        console.log(JSON.stringify({
          failure: error.failure,
          exitCode: error.exitCode,
          stderr: error.stderr,
        }));
      }
    `;
    const { stdout } = await promisify(execFile)(
      process.execPath,
      ["--input-type=module", "-e", script],
      {
        env: { ...process.env, TMPDIR: root, TMP: root, TEMP: root },
        timeout: 10_000,
      },
    );
    expect(JSON.parse(stdout)).toEqual({
      failure: "exited",
      exitCode: expect.any(Number),
      stderr: expect.stringContaining("bad option"),
    });
    expect(await readdir(root)).toEqual([]);
  },
);
