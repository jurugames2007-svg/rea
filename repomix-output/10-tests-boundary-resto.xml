      const nodes = new Map(graph.nodes.map((node) => [node.node_id, node]));
      expect(graph.coverage.status).toBe("complete");
      for (const [index, runtime] of scenario.runtimes.entries()) {
        const name = index === 0 ? "a" : "b";
