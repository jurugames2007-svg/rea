it("retains an owned debugger when inferior detach does not settle", async () => {
  vi.useFakeTimers();
  const signals: NodeJS.Signals[] = [];
  let detachCalls = 0;
  let resolveDetach!: (value: {
    readonly status: "detached";
    readonly outputSink: "durable";
  }) => void;
  let disposals = 0;
  try {
    const session = {
      id: "detach-timeout",
