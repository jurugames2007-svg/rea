          },
          original_sources: [{ source: `${localOrigin}/src/main.ts` }],
          mappings: [
            {
              generated_line: format === "indexed" ? 3 : 1,
              generated_column: format === "indexed" ? 5 : 0,
              source: `${localOrigin}/src/main.ts`,
              original_line: 1,
              original_column: 0,
              name: null,
