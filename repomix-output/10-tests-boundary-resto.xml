    expect(refused.error.cleanupResources).toContain(path);
    expect(decoderCalls).toBe(0);
    expect(closeAttempts).toBe(2);
    allowClose = true;
    await decoder.close();
    expect(closeAttempts).toBe(3);
  } finally {
