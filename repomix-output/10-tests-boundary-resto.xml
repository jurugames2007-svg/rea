  new PwntoolsDecoder(
    {
      identity: PWNTOOLS_PROVIDER_IDENTITY,
      operation: "test_pwntools_artifact_read",
      bridge: new URL("file:///unused-bridge.py"),
      payloadSchema: z.string(),
      project: () => {
        throw new Error("input read should fail before decoder launch");
      },
