      expect(
        parseJavaScriptSource(source, "main.mjs")?.errors.length,
      ).toBeGreaterThan(0);
      expect(
        parseJavaScriptSource(source, "main.mts")?.errors.length,
      ).toBeGreaterThan(0);
    },
  );
}
