    await expect(
      execute(process.execPath, [
        "--input-type=module",
        "-e",
        generate,
        collision,
      ]),
    ).rejects.toMatchObject({
      stderr: expect.stringContaining(
        "Retained native view reused an Evidence identity",
      ),
    });
  },
