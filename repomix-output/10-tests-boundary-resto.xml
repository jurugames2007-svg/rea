              startColumn: 0,
              endLine: 0,
              endColumn: 1,
            },
          });
          return {
            timestamp: 12,
            result: [
              {
                scriptId: "late-script",
                url: `${origin}/late.js`,
                functions: [
                  {
                    functionName: "late",
                    isBlockCoverage: true,
                    ranges: [{ startOffset: 0, endOffset: 1, count: 1 }],
                  },
                ],
              },
            ],
          };
        }
        if (
          command.method === "Debugger.getScriptSource" &&
          command.params.scriptId === "late-script"
        )
          return { scriptSource: ";" };
        return undefined;
      },
    });
    emitEvent = browser.emitEvent;
