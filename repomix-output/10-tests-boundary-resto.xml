          expect(result.exitCode).toBe(0);
          expect(result.json).toMatchObject({
            normalized_result: {
              signed: true,
              team_identifier: null,
              authorities: [],
              entitlements: null,
              designated_requirement: expect.stringMatching(/^cdhash H"/u),
            },
