    const cleanup = z
      .object({
        reason: z.string(),
        previous_error: z.object({
          code: z.string(),
          category: z.string(),
          message: z.string(),
          details: z.record(z.string(), z.unknown()).optional(),
        }),
        captured_output: z.object({
          truncated: z.boolean(),
