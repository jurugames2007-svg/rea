it.each(["regular", "indexed"])(
  "collects an HTTP %s source map with omitted names without accepting invalid names",
  async (format) => {
    const leaf = {
      version: 3,
      sources: ["src/main.ts"],
      sourcesContent: ["import './dependency.ts';"],
      mappings: "AAAA",
    };
    const texts = [
      leaf,
      { ...leaf, names: [] },
      { ...leaf, names: null },
      { ...leaf, names: 42 },
      { ...leaf, names: [42] },
      { ...leaf, mappings: "AAAAA" },
    ].map((map) =>
      JSON.stringify(
        format === "indexed"
