      const module = await processes.run(
        process.execPath,
        ["--check", "--input-type=module"],
        { input: source, timeoutMs: 5_000 },
      );
      expect(module.exitCode).not.toBe(0);
      const parsed = parseJavaScriptSource(source, "main.cjs");
