    for (const [directory, answer] of [
      [left, leftAnswer],
      [right, rightAnswer],
    ]) {
      await mkdir(directory);
      await writeFile(join(directory, "summary.json"), JSON.stringify(summary));
      await writeFile(join(directory, "answer.json"), JSON.stringify(answer));
