  const withinApp = (path: string): boolean =>
    roots.some((root) => isWithin(path, root));
  const matching = (predicate: (path: string) => boolean): Component[] =>
    entries.flatMap(({ path, kind, component }) =>
      kind === "file" &&
      component !== undefined &&
      !isSidecar(path) &&
      withinApp(path) &&
      predicate(path)
