    });
    const malformed = projectAnalysisView(
      parent({ ...report, imports: { items: "x" } }),
      { kind: "summary" },
    );
    expect(malformed.ok).toBe(false);
    if (!malformed.ok) expect(malformed.error._tag).toBe("AnalysisInputError");
  });
