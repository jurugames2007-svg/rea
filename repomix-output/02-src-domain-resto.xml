export type DimensionResult = z.infer<typeof dimensionResultSchema>;
export type TrustGateResult = z.infer<typeof trustGateResultSchema>;
const VOLATILE_DIMENSIONS = new Set([
  "timing",
  "timestamp",
  "pid",
  "ppid",
  "duration_ms",
  "created_at",
  "updated_at",
