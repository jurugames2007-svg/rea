    const isolated = new WebNetworkApiSurfaceAccumulator(maximum);
    add(isolated, record(0, path, method, mime));
    const accumulator = new WebNetworkApiSurfaceAccumulator(maximum);
    for (let ordinal = 0; ordinal < 150; ordinal += 1)
