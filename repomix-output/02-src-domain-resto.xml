    }),
  ],
  [
    "duplicate register",
    (v: ReturnType<typeof recordedCrashFixture>) => ({
      ...v,
      threads: v.threads.map((t) => ({
        ...t,
        registers: [...t.registers, ...t.registers],
      })),
    }),
  ],
] as const)("rejects %s before Evidence serialization", (_name, change) =>
  expect(
