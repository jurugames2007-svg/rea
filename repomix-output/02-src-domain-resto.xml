        artifact: input.artifact,
        status: "unknown",
        before_state: beforeState,
        after_state: afterState,
        before_sha256: beforeSha256,
        after_sha256: afterSha256,
        reason:
          joinIncomparableReasons(
            input.familyIncomparableReason,
            input.incomparableReason,
