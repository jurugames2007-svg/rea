    .string()
    .regex(/^[a-f0-9]{64}$/u)
    .nullable(),
  provider: z.strictObject({
    id: z.string().min(1),
    name: z.string().min(1),
    version: z.string().nullable(),
  }),
  analysis_profile_digest: z.string().min(1).nullable(),
  result: objcSwiftMetadataSchema,
