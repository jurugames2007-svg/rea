  nodes: reached.size,
  edges: [...reached.keys()].reduce(
    (count, node) => count + (graph.hasNode(node) ? graph.outDegree(node) : 0),
    0,
  ),
  depth_reached: [...reached.values()].reduce(
    (maximum, depth) => Math.max(maximum, depth),
    0,
  ),
