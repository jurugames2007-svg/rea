  capture.records.forEach((record, index) => {
    record.reported = { request: { method: "GET", url: urls[index]! } };
  });
  const result = project(capture, 0, 1, { sensitive_value_count: 0 }, true);
  if (!result.ok || result.value.kind !== "api-surface")
