        .success,
    ).toBe(false);
    expect(
      artifactInventoryResultSchema.safeParse({
        ...currentWithoutIntegrityFacts,
        integrity_contradictions: [],
      }).success,
    ).toBe(true);
    expect(
      artifactInventoryResultSchema.safeParse({
