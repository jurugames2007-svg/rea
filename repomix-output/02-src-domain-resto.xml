    const bytes = Buffer.alloc(256);
    dosMz().copy(bytes, 0, 0, 28);
    bytes.writeUInt16LE(256, 2);
    bytes.writeUInt16LE(4, 8);
    bytes.writeUInt16LE(64, 24);
    bytes.writeUInt32LE(192, 60);
    expect(parseDosMzHeader(bytes).ok).toBe(false);
