    matches,
    context.signatureResolutionExamined,
  );
  for (const item of matches.leftOnly)
    items.push(
      fieldOnlyItem(
        { left: item.item },
        item.identity,
        item.identityUnavailable,
        context,
        undecoded,
      ),
    );
  for (const item of matches.rightOnly)
    items.push(
      fieldOnlyItem(
        { right: item.item },
        item.identity,
        item.identityUnavailable,
        context,
        undecoded,
      ),
    );
  return items;
};
