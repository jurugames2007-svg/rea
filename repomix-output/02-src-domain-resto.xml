        target: referenceEndpoint(
          edge.target_procedure,
          edge.target_address,
          sameArtifact,
        ),
        type: edge.kind.type,
        flow: edge.kind.flow,
        call: edge.kind.call,
        jump: edge.kind.jump,
        data: edge.kind.data,
        read: edge.kind.read,
        write: edge.kind.write,
