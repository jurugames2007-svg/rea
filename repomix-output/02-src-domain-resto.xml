          "method-structural",
          signatureIdentity(item.signature),
          item.body.status,
          item.body.header_format,
          item.body.il_size,
          item.body.max_stack,
          item.body.init_locals,
          item.body.opcode_counts,
          item.body.anchors.map(({ opcode, operand_kind, operand }) => [
            opcode,
            operand_kind,
            operand_kind === "constant" ? operand : null,
