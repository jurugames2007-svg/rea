<file path="src/domain/analysisView/machoView.ts">
import { analysisViewInputError } from "./analysisViewErrors.js";
import { z } from "zod";
import type { AnalysisError } from "../analysisErrorBase.js";
import { uniqueSorted } from "../canonicalOrdering.js";
import { isMachOFormat } from "../binaryTargetTypes.js";
import { inspectMachoSchema } from "../native/nativeInspection.js";
import { err, ok, type Result } from "../result.js";
import { parseAnalysisViewResult } from "./analysisViewParent.js";
import type {
  AnalysisViewParent,
  AnalysisViewRequest,
  UnsignedAnalysisView,
} from "./analysisView.js";
import {
  completeWithinViewCoverage,
  pageViewCoverage,
} from "./analysisViewCoverage.js";
const MACHO_COLLECTIONS = [
  "entrypoints",
  "architectures",
  "build_metadata",
  "load_commands",
  "dependencies",
  "imports",
  "exports",
  "segments",
] as const;
type MachoCollection = (typeof MACHO_COLLECTIONS)[number];
export const machoViewRequestSchema = z.strictObject({
  kind: z.literal("macho"),
  facet: z.enum([...MACHO_COLLECTIONS, "provenance"]),
  offset: z.number().int().nonnegative().default(0),
  limit: z.number().int().positive().default(64),
});
const { shape } = inspectMachoSchema;
const exactRows = <Shape extends z.ZodRawShape>(
  rows: z.ZodArray<z.ZodObject<Shape>>,
) => z.array(z.strictObject(rows.element.shape));
export const machoViewItemSchema = z.union([
  exactRows(shape.entrypoints.shape.items),
  exactRows(shape.architectures.shape.items),
  exactRows(shape.build_metadata.shape.items),
  exactRows(shape.load_commands.shape.items),
  exactRows(shape.dependencies.shape.items),
  exactRows(shape.imports.shape.items),
  exactRows(shape.segments.shape.items),
  exactRows(shape.provenance),
]);
export const machoViewContextSchema = z.strictObject({
  source_total: z.number().int().nonnegative().nullable(),
  source_exhaustive: z.boolean(),
});
const collectionCountSchema = z.strictObject({
  returned: z.number().int().nonnegative(),
  total: z.number().int().nonnegative().nullable(),
  exhaustive: z.boolean(),
});
export const machoSummarySchema = z.strictObject({
  format: shape.format,
  selected_architecture: shape.selected_architecture,
  endian: shape.endian,
  word_size: shape.word_size,
  file_type: shape.file_type,
  flags: shape.flags,
  uuid: shape.uuid,
  collections: z.strictObject(
    Object.fromEntries(
      MACHO_COLLECTIONS.map((name) => [name, collectionCountSchema]),
    ) as Record<MachoCollection, typeof collectionCountSchema>,
  ),
  provenance_count: z.number().int().nonnegative(),
  limitation_count: z.number().int().nonnegative(),
});
type MachoReport = z.output<typeof inspectMachoSchema>;
const parseMachoReport = (
  parent: AnalysisViewParent,
): Result<MachoReport, AnalysisError> => {
  const parsed = parseAnalysisViewResult(inspectMachoSchema, parent);
  if (!parsed.ok) return parsed;
  if (parent.subject != null && !isMachOFormat(parent.subject.format))
    return err(
      analysisViewInputError([
        {
          path: ["source", "subject"],
          reason: "invalid_value",
          message:
            "Mach-O parent Evidence subject must identify a thin or universal Mach-O.",
        },
      ]),
    );
  return ok(parsed.value);
};
const summarizeMacho = (
  report: MachoReport,
  parentLimitations: readonly string[],
) => {
  const limitations = uniqueSorted([
    ...parentLimitations,
    ...report.limitations,
    ...MACHO_COLLECTIONS.flatMap((name) => report[name].limitations),
  ]);
  const collections = Object.fromEntries(
    MACHO_COLLECTIONS.map((name) => [
      name,
      {
        returned: report[name].items.length,
        total: report[name].total,
        exhaustive: report[name].exhaustive,
      },
    ]),
  ) as Record<MachoCollection, z.output<typeof collectionCountSchema>>;
  return {
    limitations,
    returned: MACHO_COLLECTIONS.reduce(
      (sum, name) => sum + report[name].items.length,
      0,
    ),
    summary: {
      format: report.format,
      selected_architecture: report.selected_architecture,
      endian: report.endian,
      word_size: report.word_size,
      file_type: report.file_type,
      flags: report.flags,
      uuid: report.uuid,
      collections,
      provenance_count: report.provenance.length,
      limitation_count: limitations.length,
    },
  };
};
export const projectMachoView = (
  parent: AnalysisViewParent,
  view: AnalysisViewRequest,
): Result<UnsignedAnalysisView, AnalysisError> => {
  if (view.kind !== "summary" && view.kind !== "macho")
    return err(
      analysisViewInputError([
        {
          path: ["view"],
          reason: "invalid_value",
          message: "Mach-O inspection supports summary and macho views.",
        },
      ]),
    );
  const parsed = parseMachoReport(parent);
  if (!parsed.ok) return parsed;
  const report = parsed.value;
  const incomplete = MACHO_COLLECTIONS.filter(
    (name) => !report[name].exhaustive,
  );
  const shared = {
    parent_evidence_id: parent.evidenceId,
    parent_operation: "inspect_macho" as const,
    parent_digest: parent.evidenceId.slice(3),
    artifact:
      parent.subject == null
        ? { path: "", sha256: null }
        : {
            path: parent.subject.local_path,
            sha256: parent.subject.digest.sha256,
          },
    unknowns: [
      ...(incomplete.length === 0
        ? []
        : [
            `Native tools did not report exhaustive ${incomplete.join(", ")}; page exhaustion does not establish absence of unreturned rows.`,
          ]),
      ...(parent.subject == null
        ? [
            "The parent has no recorded subject, so the inspected artifact path and SHA-256 are unknown.",
          ]
        : []),
    ],
  };
  if (view.kind === "summary") {
    const { summary, limitations, returned } = summarizeMacho(
      report,
      parent.limitations,
    );
    return ok({
      kind: "summary",
      view,
      ...shared,
      limitations,
      summary,
      coverage: completeWithinViewCoverage(returned, returned),
    });
  }
  const source =
    view.facet === "provenance"
      ? {
          items: report.provenance,
          total: report.provenance.length,
          exhaustive: true,
          limitations: [],
        }
      : report[view.facet];
  const item = source.items.slice(view.offset, view.offset + view.limit);
  return ok({
    kind: "macho",
    view,
    item,
    ...shared,
    limitations: uniqueSorted([
      ...parent.limitations,
      ...report.limitations,
      ...source.limitations,
    ]),
    source_total: source.total,
    source_exhaustive: source.exhaustive,
    coverage: pageViewCoverage(view.offset, item.length, source.items.length),
  });
};
</file>

<file path="src/domain/analysisView/managedArtifactView.ts">
import { analysisViewInputError } from "./analysisViewErrors.js";
import { z } from "zod";
import type { AnalysisError } from "../analysisErrorBase.js";
import { uniqueSorted } from "../canonicalOrdering.js";
import {
  managedArtifactInspectionSchema,
  managedMemberInspectionSchema,
} from "../managed/managedArtifact.js";
import { err, ok, type Result } from "../result.js";
import { parseAnalysisViewResult } from "./analysisViewParent.js";
import type {
  AnalysisViewParent,
  AnalysisViewRequest,
  UnsignedAnalysisView,
} from "./analysisView.js";
import {
  completeWithinViewCoverage,
  pageViewCoverage,
} from "./analysisViewCoverage.js";
export const managedViewRequestSchema = z.strictObject({
  kind: z.literal("managed"),
  collection: z.enum(["references", "resources", "attributes"]),
  offset: z.number().int().nonnegative().default(0),
  limit: z.number().int().positive().default(64),
});
export const managedViewItemSchema = z.union([
  managedArtifactInspectionSchema.shape.references,
  managedArtifactInspectionSchema.shape.resources,
  managedArtifactInspectionSchema.shape.attributes,
]);
export const managedSummarySchema = managedArtifactInspectionSchema
  .omit({ references: true, resources: true, attributes: true })
  .extend({
    reported_counts: z.strictObject({
      references: z.number().int().nonnegative(),
      resources: z.number().int().nonnegative(),
      attributes: z.number().int().nonnegative(),
    }),
    identity_scope: managedMemberInspectionSchema.shape.identity_scope,
  });
export const managedViewContextSchema = z.strictObject({
  identity_scope: managedMemberInspectionSchema.shape.identity_scope,
  source_metadata_status:
    managedArtifactInspectionSchema.shape.metadata.shape.status,
  source_coverage: managedArtifactInspectionSchema.shape.coverage,
});
export const managedViewIdentityUnknowns = (
  parent: AnalysisViewParent,
  mvid: string | null,
): string[] => [
  "Metadata tokens are build-local coordinates bound to the recorded artifact SHA-256 and module MVID; this view does not load or execute the assembly.",
  ...(parent.subject == null
    ? [
        "The parent has no recorded subject; its normalized artifact identity cannot be cross-checked against a subject digest.",
      ]
    : []),
  ...(mvid === null
    ? [
        "The module MVID is unknown; tokens cannot establish a cross-observation module match.",
      ]
    : []),
];
export const projectManagedArtifactView = (
  parent: AnalysisViewParent,
  view: AnalysisViewRequest,
): Result<UnsignedAnalysisView, AnalysisError> => {
  if (view.kind !== "summary" && view.kind !== "managed")
    return err(
      analysisViewInputError([
        {
          path: ["view"],
          reason: "invalid_value",
          message:
            "Managed artifact inspection supports summary and managed views.",
        },
      ]),
    );
  const parsed = parseAnalysisViewResult(
    managedArtifactInspectionSchema,
    parent,
  );
  if (!parsed.ok) return parsed;
  const report = parsed.value;
  const identity_scope = {
    token_identity: "build-local" as const,
    requires_artifact_sha256: report.artifact.sha256,
    requires_mvid: report.module?.mvid ?? null,
  };
  const shared = {
    parent_evidence_id: parent.evidenceId,
    parent_operation: "inspect_managed_artifact" as const,
    parent_digest: parent.evidenceId.slice(3),
    artifact: { path: report.artifact.path, sha256: report.artifact.sha256 },
    limitations: uniqueSorted([...parent.limitations, ...report.limitations]),
    unknowns: [
      "Collection counts and pages cover producer-returned rows; metadata completeness remains the original metadata status and coverage, not an absence claim about unreturned rows.",
      ...managedViewIdentityUnknowns(parent, identity_scope.requires_mvid),
    ],
  };
  if (view.kind === "summary") {
    const { references, resources, attributes, ...summary } = report;
    const reported_counts = {
      references: references.length,
      resources: resources.length,
      attributes: attributes.length,
    };
    const total = references.length + resources.length + attributes.length;
    return ok({
      kind: "summary",
      view,
      ...shared,
      summary: { ...summary, reported_counts, identity_scope },
      coverage: completeWithinViewCoverage(total, total),
    });
  }
  const collection = report[view.collection];
  const item = collection.slice(view.offset, view.offset + view.limit);
  return ok({
    kind: "managed",
    view,
    item,
    ...shared,
    identity_scope,
    source_metadata_status: report.metadata.status,
    source_coverage: report.coverage,
    coverage: pageViewCoverage(view.offset, item.length, collection.length),
  });
};
</file>

<file path="src/domain/analysisView/managedMemberView.ts">
import { analysisViewInputError } from "./analysisViewErrors.js";
import { z } from "zod";
import type { AnalysisError } from "../analysisErrorBase.js";
import { uniqueSorted } from "../canonicalOrdering.js";
import {
  managedMemberInspectionSchema,
  type ManagedMemberInspection,
} from "../managed/managedArtifact.js";
import { err, ok, type Result } from "../result.js";
import type {
  AnalysisViewParent,
  AnalysisViewRequest,
  UnsignedAnalysisView,
} from "./analysisView.js";
import {
  completeWithinViewCoverage,
  pageViewCoverage,
} from "./analysisViewCoverage.js";
import { managedViewIdentityUnknowns } from "./managedArtifactView.js";
import { parseAnalysisViewResult } from "./analysisViewParent.js";
const member = managedMemberInspectionSchema.shape;
export const managedMembersViewRequestSchema = z.strictObject({
  kind: z.literal("managed-members"),
  collection: z.enum([
    "types",
    "exported_types",
    "fields",
    "methods",
    "member_refs",
    "call_edges",
    "field_accesses",
    "user_strings",
  ]),
  offset: z.number().int().nonnegative().default(0),
  limit: z.number().int().positive().default(64),
});
const rowsOf = <C extends string, S extends z.ZodArray>(
  collection: C,
  rows: S,
) => z.strictObject({ collection: z.literal(collection), rows });
export const managedMembersViewPageSchema = z.discriminatedUnion("collection", [
  rowsOf("types", member.types),
  rowsOf("exported_types", member.exported_types.unwrap().unwrap()),
  rowsOf("fields", member.fields),
  rowsOf("methods", member.methods),
  rowsOf("member_refs", member.member_refs),
  rowsOf("call_edges", member.call_edges),
  rowsOf("field_accesses", member.field_accesses),
  rowsOf("user_strings", member.user_strings.unwrap().unwrap().shape.literals),
]);
type ManagedMembersViewPage = z.infer<typeof managedMembersViewPageSchema>;
const nullableCount = z.number().int().nonnegative().nullable();
export const managedMemberSummarySchema = z.strictObject({
  signature_resolution: member.signature_resolution,
  nesting_read: member.nesting_read,
  artifact: member.artifact,
  module: member.module,
  metadata: member.metadata,
  identity_scope: member.identity_scope,
  selection: member.selection.unwrap(),
  coverage: member.coverage,
  user_strings: z
    .strictObject({
      state: member.user_strings.unwrap().unwrap().shape.state,
      issues: member.user_strings.unwrap().unwrap().shape.issues,
    })
    .nullable(),
  limitations: member.limitations,
  reported_counts: z.strictObject({
    types: z.number().int().nonnegative(),
    exported_types: nullableCount,
    fields: z.number().int().nonnegative(),
    methods: z.number().int().nonnegative(),
    member_refs: z.number().int().nonnegative(),
    call_edges: z.number().int().nonnegative(),
    field_accesses: z.number().int().nonnegative(),
    user_strings: nullableCount,
  }),
});
export const managedMembersViewContextSchema = z.strictObject({
  signature_resolution: member.signature_resolution,
  nesting_read: member.nesting_read,
  identity_scope: member.identity_scope,
  selection: member.selection.unwrap(),
  source_metadata_status: member.metadata.shape.status,
  source_coverage: member.coverage,
});
type ManagedMembersViewRequest = z.infer<
  typeof managedMembersViewRequestSchema
>;
type MemberCollection = ManagedMembersViewRequest["collection"];
const slice = <C extends MemberCollection, T>(
  collection: C,
  rows: readonly T[] | null | undefined,
  { offset, limit }: { readonly offset: number; readonly limit: number },
) =>
  rows == null
    ? null
    : {
        page: { collection, rows: rows.slice(offset, offset + limit) },
        total: rows.length,
      };
const collectionPage = (
  report: ManagedMemberInspection,
  view: ManagedMembersViewRequest,
): { readonly page: ManagedMembersViewPage; readonly total: number } | null => {
  const { collection } = view;
  switch (collection) {
    case "types":
      return slice(collection, report.types, view);
    case "exported_types":
      return slice(collection, report.exported_types, view);
    case "fields":
      return slice(collection, report.fields, view);
    case "methods":
      return slice(collection, report.methods, view);
    case "member_refs":
      return slice(collection, report.member_refs, view);
    case "call_edges":
      return slice(collection, report.call_edges, view);
    case "field_accesses":
      return slice(collection, report.field_accesses, view);
    case "user_strings":
      return slice(collection, report.user_strings?.literals, view);
  }
};
const validatedReports = new WeakMap<
  object,
  WeakRef<ManagedMemberInspection>
>();
const parseMemberReport = (
  parent: AnalysisViewParent,
): Result<ManagedMemberInspection, AnalysisError> => {
  const { normalizedResult } = parent;
  const sealed =
    parent.sealedResult === true &&
    typeof normalizedResult === "object" &&
    normalizedResult !== null;
  const cached = sealed
    ? validatedReports.get(normalizedResult)?.deref()
    : undefined;
  if (cached !== undefined) return ok(cached);
  const parsed = parseAnalysisViewResult(managedMemberInspectionSchema, parent);
  if (parsed.ok && sealed)
    validatedReports.set(normalizedResult, new WeakRef(parsed.value));
  return parsed;
};
const summarizeMembers = (
  report: ManagedMemberInspection,
): z.infer<typeof managedMemberSummarySchema> => {
  const {
    types,
    exported_types,
    fields,
    methods,
    member_refs,
    call_edges,
    field_accesses,
    user_strings,
    ...identity
  } = report;
  return {
    ...identity,
    user_strings:
      user_strings === null
        ? null
        : { state: user_strings.state, issues: user_strings.issues },
    reported_counts: {
      types: types.length,
      exported_types: exported_types?.length ?? null,
      fields: fields.length,
      methods: methods.length,
      member_refs: member_refs.length,
      call_edges: call_edges.length,
      field_accesses: field_accesses.length,
      user_strings: user_strings?.literals.length ?? null,
    },
  };
};
export const projectManagedMemberView = (
  parent: AnalysisViewParent,
  view: AnalysisViewRequest,
): Result<UnsignedAnalysisView, AnalysisError> => {
  if (view.kind !== "summary" && view.kind !== "managed-members")
    return err(
      analysisViewInputError([
        {
          path: ["view"],
          reason: "invalid_value",
          message:
            "Managed member inspection supports summary and managed-members views.",
        },
      ]),
    );
  const parsed = parseMemberReport(parent);
  if (!parsed.ok) return parsed;
  const report = parsed.value;
  const shared = {
    parent_evidence_id: parent.evidenceId,
    parent_operation: "inspect_managed_members" as const,
    parent_digest: parent.evidenceId.slice(3),
    artifact: { path: report.artifact.path, sha256: report.artifact.sha256 },
    limitations: uniqueSorted([...parent.limitations, ...report.limitations]),
    unknowns: [
      "Collection counts and pages cover producer-returned rows; member completeness remains the original coverage, not an absence claim about unreturned rows.",
      ...(report.selection === null
        ? []
        : [
            "Exported types and member references cover the whole assembly; the other collections cover only the selected declaring types.",
          ]),
      ...managedViewIdentityUnknowns(
        parent,
        report.identity_scope.requires_mvid,
      ),
    ],
  };
  if (view.kind === "summary") {
    const summary = summarizeMembers(report);
    const total = Object.values(summary.reported_counts).reduce<number>(
      (sum, count) => sum + (count ?? 0),
      0,
    );
    return ok({
      kind: "summary",
      view,
      ...shared,
      summary,
      coverage: completeWithinViewCoverage(total, total),
    });
  }
  const selected = collectionPage(report, view);
  if (selected === null)
    return err(
      analysisViewInputError([
        {
          path: ["view", "collection"],
          reason: "invalid_value",
          message: `The parent Evidence did not examine ${view.collection}; repeat inspect_managed_members with the current runtime to record it.`,
        },
      ]),
    );
  const { page, total } = selected;
  return ok({
    kind: "managed-members",
    view,
    page,
    ...shared,
    signature_resolution: report.signature_resolution,
    nesting_read: report.nesting_read,
    identity_scope: report.identity_scope,
    selection: report.selection,
    source_metadata_status: report.metadata.status,
    source_coverage:
      view.collection === "user_strings" && report.user_strings !== null
        ? {
            state: report.user_strings.state,
            issues: report.user_strings.issues,
          }
        : report.coverage,
    coverage: pageViewCoverage(view.offset, page.rows.length, total),
  });
};
