  const line = text[cursor + 1] === "/";
  const end = text.indexOf(line ? "\n" : "*/", cursor + 2);
  return end === -1 ? text.length : end + (line ? 1 : 2);
};
const skipOpenStepScalar = (text: string, start: number): number => {
  let cursor = start;
