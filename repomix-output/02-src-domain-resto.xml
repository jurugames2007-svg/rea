      item: z.output<typeof range>,
      start = 0n,
      end = BigInt(value.artifact.bytes),
    ) => {
      const offset = BigInt(item.offset);
      const bytes = BigInt(item.bytes);
      return offset >= start && offset <= end && bytes <= end - offset;
    };
