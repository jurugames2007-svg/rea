<file path="src/domain/webCaptureFrameComparison.ts">
import type { WebPageInspection } from "./browserObservationSchemas.js";
import { digestCanonicalValue } from "./canonicalDigest.js";
export const fingerprintWebCaptureFrames = (
  frames: WebPageInspection["frames"],
): string | null => {
  const byId = new Map(frames.map((frame) => [frame.frame_id, frame]));
  if (byId.size !== frames.length) return null;
  const remaining = new Map(frames.map((frame) => [frame.frame_id, 0]));
  for (const frame of frames) {
    if (frame.parent_frame_id === null) continue;
    const count = remaining.get(frame.parent_frame_id);
    if (count === undefined) return null;
    remaining.set(frame.parent_frame_id, count + 1);
  }
  const ready = frames.filter((frame) => remaining.get(frame.frame_id) === 0);
  const children = new Map<string, string[]>();
  const roots: string[] = [];
  let examined = 0;
  for (let index = 0; index < ready.length; index += 1) {
    const frame = ready[index];
    if (frame === undefined) throw new Error("Missing ready frame");
    const fingerprint = digestCanonicalValue({
      url: frame.url,
      origin: frame.origin,
      children: (children.get(frame.frame_id) ?? []).sort(),
    });
    examined += 1;
    const parentId = frame.parent_frame_id;
    if (parentId === null) {
      roots.push(fingerprint);
      continue;
    }
    const siblings = children.get(parentId) ?? [];
    siblings.push(fingerprint);
    children.set(parentId, siblings);
    const count = (remaining.get(parentId) ?? 0) - 1;
    remaining.set(parentId, count);
    if (count === 0) {
      const parent = byId.get(parentId);
      if (parent === undefined)
        throw new Error("Missing admitted parent frame");
      ready.push(parent);
    }
  }
  return examined === frames.length ? digestCanonicalValue(roots.sort()) : null;
};
</file>

<file path="src/domain/webContentArtifact.ts">
import { createHash } from "node:crypto";
import { z } from "zod";
export const webTextArtifactSchema = z
  .object({
    sha256: z.string().regex(/^[a-f0-9]{64}$/u),
    bytes: z.number().int().min(0),
    media_type: z.string().min(1),
    charset: z.literal("utf-8"),
    text: z.string(),
  })
  .superRefine((artifact, context) => {
    const bytes = Buffer.byteLength(artifact.text);
    const digest = createHash("sha256").update(artifact.text).digest("hex");
    if (artifact.bytes !== bytes)
      context.addIssue({
        code: "custom",
        path: ["bytes"],
        message: "Byte count mismatch",
      });
    if (artifact.sha256 !== digest)
      context.addIssue({
        code: "custom",
        path: ["sha256"],
        message: "Digest mismatch",
      });
  });
export type WebTextArtifact = z.infer<typeof webTextArtifactSchema>;
export const createWebTextArtifact = (
  text: string,
  mediaType: string,
): WebTextArtifact => {
  const sha256 = createHash("sha256").update(text).digest("hex");
  return {
    sha256,
    bytes: Buffer.byteLength(text),
    media_type: mediaType,
    charset: "utf-8",
    text,
  };
};
</file>

