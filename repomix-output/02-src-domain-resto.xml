const implicationKey = (fact: ElectronFuseImplication): string =>
  JSON.stringify([
    fact.slice_index,
    fact.sentinel_offset,
    fact.subject,
    fact.fuse_index,
    fact.outcome,
  ]);
const validateSentinel = (
  slice: ElectronFuseSlice,
  sentinel: ElectronFuseSentinel,
  sliceIndex: number,
  sentinelIndex: number,
  context: z.RefinementCtx,
