  capture.records = [capture.records[3]!, capture.records[1]!];
  const urls = [
    "https://api.test/a/%2e%2e/products?b=1&a+b=2&a%2Bb=3&=4&%E9%9B%AA=5&b=6&&%FF=7&__proto__=8#ignored=9",
    "https://api.test/a/%2e%2e/products?b=10",
