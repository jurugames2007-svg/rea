  application_node_id: z
    .string()
    .regex(/^jag_node_[a-f0-9]{64}$/u)
    .nullable(),
  semantic_node_id: z
    .string()
    .regex(/^jsrg_node_[a-f0-9]{64}$/u)
    .nullable(),
  location: textSchema,
});
const authorityReferenceSchema = z.strictObject({
  evidence_id: evidenceIdSchema,
  authority: z.enum([
    "shipped-artifact",
    "controlled-replay",
    "historical-reference",
    "external-service",
    "analyst-inference",
  ]),
