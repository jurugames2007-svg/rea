<file path="src/domain/analysisView/qlogCaptureView.ts">
import { z } from "zod";
import {
  qlogCaptureFactsSchema,
  type QlogCaptureFacts,
} from "../qlogCapture.js";
import { err, ok, type Result } from "../result.js";
import type { AnalysisError } from "../analysisErrorBase.js";
import { analysisViewInputError } from "./analysisViewErrors.js";
import { pageViewCoverage } from "./analysisViewCoverage.js";
const traceSchema = qlogCaptureFactsSchema.shape.traces.element;
const streamSchema = traceSchema.shape.streams.element;
export const qlogViewContextSchema = qlogCaptureFactsSchema.omit({
  traces: true,
});
export const qlogSummarySchema = qlogViewContextSchema.extend({
  trace_count: z.number().int().nonnegative(),
  retained_stream_count: z.number().int().nonnegative(),
  loss_declaration_count: z.number().int().nonnegative(),
  incomplete_fact_record_count: z.number().int().nonnegative(),
});
const pageRequestShape = {
  kind: z.literal("qlog"),
  offset: z.number().int().nonnegative().default(0),
  limit: z.number().int().positive().default(64),
};
const traceSelectorShape = { trace_index: z.number().int().nonnegative() };
const streamSelectorShape = {
  ...traceSelectorShape,
  stream_id: streamSchema.shape.stream_id,
  direction: streamSchema.shape.direction,
};
export const qlogViewRequestSchema = z.discriminatedUnion("facet", [
  z.strictObject({ ...pageRequestShape, facet: z.literal("traces") }),
  z.strictObject({
    ...pageRequestShape,
    ...traceSelectorShape,
    facet: z.literal("streams"),
  }),
  z.strictObject({
    ...pageRequestShape,
    ...traceSelectorShape,
    facet: z.literal("loss-declarations"),
  }),
  z.strictObject({
    ...pageRequestShape,
    ...traceSelectorShape,
    facet: z.literal("incomplete-records"),
  }),
  z.strictObject({
    ...pageRequestShape,
    ...streamSelectorShape,
    facet: z.literal("contributions"),
  }),
  z.strictObject({
    ...pageRequestShape,
    ...streamSelectorShape,
    facet: z.literal("ranges"),
  }),
  z.strictObject({
    ...pageRequestShape,
    ...streamSelectorShape,
    facet: z.literal("final-sizes"),
  }),
]);
export type QlogViewRequest = z.output<typeof qlogViewRequestSchema>;
const traceSummarySchema = traceSchema
  .omit({
    streams: true,
    loss_declarations: true,
    incomplete_fact_records: true,
  })
  .extend({
    stream_count: z.number().int().nonnegative(),
    loss_declaration_count: z.number().int().nonnegative(),
    incomplete_fact_record_count: z.number().int().nonnegative(),
  });
const streamSummarySchema = streamSchema
  .omit({
    contributions: true,
    covered_ranges: true,
    reported_final_sizes: true,
  })
  .extend({
    contribution_count: z.number().int().nonnegative(),
    covered_range_count: z.number().int().nonnegative(),
    reported_final_size_count: z.number().int().nonnegative(),
  });
export const qlogViewPageSchema = z.discriminatedUnion("facet", [
  z.strictObject({
    facet: z.literal("traces"),
    items: z.array(traceSummarySchema),
  }),
  z.strictObject({
    facet: z.literal("streams"),
    items: z.array(streamSummarySchema),
  }),
  z.strictObject({
    facet: z.literal("loss-declarations"),
    items: traceSchema.shape.loss_declarations,
  }),
  z.strictObject({
    facet: z.literal("incomplete-records"),
    items: traceSchema.shape.incomplete_fact_records,
  }),
  z.strictObject({
    facet: z.literal("contributions"),
    items: streamSchema.shape.contributions,
  }),
  z.strictObject({
    facet: z.literal("ranges"),
    items: streamSchema.shape.covered_ranges,
  }),
  z.strictObject({
    facet: z.literal("final-sizes"),
    items: streamSchema.shape.reported_final_sizes,
  }),
]);
type QlogViewPage = z.output<typeof qlogViewPageSchema>;
export const summarizeQlogCapture = (qlog: QlogCaptureFacts) => {
  const { traces, ...context } = qlog;
  return {
    ...context,
    trace_count: traces.length,
    retained_stream_count: traces.reduce(
      (sum, trace) => sum + trace.streams.length,
      0,
    ),
    loss_declaration_count: traces.reduce(
      (sum, trace) => sum + trace.loss_declarations.length,
      0,
    ),
    incomplete_fact_record_count: traces.reduce(
      (sum, trace) => sum + trace.incomplete_fact_records.length,
      0,
    ),
  };
};
const summarizeTrace = ({
  streams,
  loss_declarations,
  incomplete_fact_records,
  ...trace
}: QlogCaptureFacts["traces"][number]) => ({
  ...trace,
  stream_count: streams.length,
  loss_declaration_count: loss_declarations.length,
  incomplete_fact_record_count: incomplete_fact_records.length,
});
const summarizeStream = ({
  contributions,
  covered_ranges,
  reported_final_sizes,
  ...stream
}: QlogCaptureFacts["traces"][number]["streams"][number]) => ({
  ...stream,
  contribution_count: contributions.length,
  covered_range_count: covered_ranges.length,
  reported_final_size_count: reported_final_sizes.length,
});
export const projectQlogCapturePage = (
  qlog: QlogCaptureFacts,
  view: QlogViewRequest,
): Result<
  {
    context: z.output<typeof qlogViewContextSchema>;
    page: QlogViewPage;
    coverage: ReturnType<typeof pageViewCoverage>;
  },
  AnalysisError
> => {
  const invalid = (field: string, message: string) =>
    err(
      analysisViewInputError([
        { path: ["view", field], reason: "invalid_value", message },
      ]),
    );
  const slice = <T>(items: readonly T[]) =>
    items.slice(view.offset, view.offset + view.limit);
  let page: QlogViewPage;
  let total: number;
  if (view.facet === "traces") {
    total = qlog.traces.length;
    page = {
      facet: "traces",
      items: slice(qlog.traces).map(summarizeTrace),
    };
  } else {
    const matches = qlog.traces.filter(
      (trace) => trace.trace_index === view.trace_index,
    );
    if (matches.length !== 1)
      return invalid(
        "trace_index",
        "Select one unambiguous retained trace index.",
      );
    const trace = matches[0]!;
    if (view.facet === "streams") {
      total = trace.streams.length;
      page = {
        facet: "streams",
        items: slice(trace.streams).map(summarizeStream),
      };
    } else if (view.facet === "loss-declarations") {
      total = trace.loss_declarations.length;
      page = { facet: view.facet, items: slice(trace.loss_declarations) };
    } else if (view.facet === "incomplete-records") {
      total = trace.incomplete_fact_records.length;
      page = { facet: view.facet, items: slice(trace.incomplete_fact_records) };
    } else {
      const matches = trace.streams.filter(
        (stream) =>
          stream.stream_id === view.stream_id &&
          stream.direction === view.direction,
      );
      if (matches.length !== 1)
        return invalid(
          "stream_id",
          "Select one unambiguous retained stream ID and direction within the trace.",
        );
      const stream = matches[0]!;
      if (view.facet === "contributions") {
        total = stream.contributions.length;
        page = { facet: view.facet, items: slice(stream.contributions) };
      } else if (view.facet === "ranges") {
        total = stream.covered_ranges.length;
        page = { facet: view.facet, items: slice(stream.covered_ranges) };
      } else {
        total = stream.reported_final_sizes.length;
        page = { facet: view.facet, items: slice(stream.reported_final_sizes) };
      }
    }
  }
  const { traces: _traces, ...context } = qlog;
  return ok({
    context,
    page,
    coverage: pageViewCoverage(view.offset, page.items.length, total),
  });
};
</file>

<file path="src/domain/analysisView/wasmArtifactView.ts">
import { analysisViewInputError } from "./analysisViewErrors.js";
import { z } from "zod";
import type { AnalysisError } from "../analysisErrorBase.js";
import { uniqueSorted } from "../canonicalOrdering.js";
import { err, ok, type Result } from "../result.js";
import { parseAnalysisViewResult } from "./analysisViewParent.js";
import {
  wasmArtifactSchema,
  wasmArtifactMatchesSubject,
} from "../wasm/wasmArtifact.js";
import type {
  AnalysisViewParent,
  AnalysisViewRequest,
  UnsignedAnalysisView,
} from "./analysisView.js";
import {
  completeWithinViewCoverage,
  pageViewCoverage,
} from "./analysisViewCoverage.js";
import { analysisTextPage } from "./analysisViewText.js";
export const wasmViewRequestSchema = z.strictObject({
  kind: z.literal("wasm"),
  facet: z.enum([
    "sections",
    "imports",
    "exports",
    "candidates",
    "glue",
    "wat",
    "headers",
    "details",
    "tool_profile",
  ]),
  offset: z.number().int().nonnegative().default(0),
  limit: z.number().int().positive().default(64),
});
export const wasmViewItemSchema = z.union([
  wasmArtifactSchema.shape.sections,
  wasmArtifactSchema.shape.imports,
  wasmArtifactSchema.shape.candidates,
  wasmArtifactSchema.shape.glue,
  wasmArtifactSchema.shape.tool_profile,
  z.strictObject({ text: z.string(), unit: z.literal("utf16-code-units") }),
]);
export const wasmSummarySchema = z.strictObject({
  bytes: wasmArtifactSchema.shape.artifact.shape.bytes,
  validation: wasmArtifactSchema.shape.validation,
  available_counts: z.strictObject({
    sections: z.number().int().nonnegative(),
    imports: z.number().int().nonnegative(),
    exports: z.number().int().nonnegative(),
    candidates: z.number().int().nonnegative(),
    glue: z.number().int().nonnegative(),
  }),
  wat: wasmArtifactSchema.shape.wat
    .omit({ text: true })
    .extend({ code_units: z.number().int().nonnegative() }),
  tool_profile: wasmArtifactSchema.shape.tool_profile,
  runtime_execution: wasmArtifactSchema.shape.runtime_execution,
  network_fetch: wasmArtifactSchema.shape.network_fetch,
  limitation_count: z.number().int().nonnegative(),
});
export const projectWasmArtifactView = (
  parent: AnalysisViewParent,
  view: AnalysisViewRequest,
): Result<UnsignedAnalysisView, AnalysisError> => {
  if (view.kind !== "summary" && view.kind !== "wasm")
    return err(
      analysisViewInputError([
        {
          path: ["view"],
          reason: "invalid_value",
          message: "WASM Evidence supports summary and wasm views.",
        },
      ]),
    );
  const parsed = parseAnalysisViewResult(wasmArtifactSchema, parent);
  if (!parsed.ok) return parsed;
  const report = parsed.value;
  if (
    !wasmArtifactMatchesSubject(
      report.artifact,
      parent.subject == null
        ? null
        : {
            path: parent.subject.local_path,
            sha256: parent.subject.digest.sha256,
            format: parent.subject.format,
          },
    )
  )
    return err(
      analysisViewInputError([
        {
          path: ["source", "subject"],
          reason: "invalid_value",
          message:
            "WASM parent Evidence subject must identify the report's exact path and SHA-256.",
        },
      ]),
    );
  const limitations = uniqueSorted([
    ...parent.limitations,
    ...report.limitations,
  ]);
  const shared = {
    parent_evidence_id: parent.evidenceId,
    parent_operation: "inspect_wasm_artifact" as const,
    parent_digest: parent.evidenceId.slice(3),
    artifact: { path: report.artifact.path, sha256: report.artifact.sha256 },
    limitations,
    unknowns: [
      "Decoded WAT is not original source. Runtime behavior and network acquisition were not performed.",
      ...(report.glue.some((glue) => glue.parse_status !== "complete")
        ? [
            "Selected glue parsing is incomplete; unmatched references do not establish absence.",
          ]
        : []),
    ],
  };
  if (view.kind === "summary")
    return ok({
      kind: "summary",
      view,
      ...shared,
      summary: {
        bytes: report.artifact.bytes,
        validation: report.validation,
        available_counts: {
          sections: report.sections.length,
          imports: report.imports.length,
          exports: report.exports.length,
          candidates: report.candidates.length,
          glue: report.glue.length,
        },
        wat: {
          sha256: report.wat.sha256,
          representation: report.wat.representation,
          code_units: report.wat.text.length,
        },
        tool_profile: report.tool_profile,
        runtime_execution: report.runtime_execution,
        network_fetch: report.network_fetch,
        limitation_count: limitations.length,
      },
      coverage: completeWithinViewCoverage(
        report.sections.length + report.imports.length + report.exports.length,
        report.sections.length + report.imports.length + report.exports.length,
      ),
    });
  if (view.facet === "tool_profile") {
    if (view.offset !== 0)
      return err(
        analysisViewInputError([
          {
            path: ["view", "offset"],
            reason: "invalid_value",
            message: "Singleton tool_profile requires offset 0.",
          },
        ]),
      );
    return ok({
      kind: "wasm",
      view,
      item: report.tool_profile,
      coverage: completeWithinViewCoverage(1, 1),
      ...shared,
    });
  }
  if (
    view.facet === "wat" ||
    view.facet === "headers" ||
    view.facet === "details"
  ) {
    const text = view.facet === "wat" ? report.wat.text : report[view.facet];
    const page = analysisTextPage(text, view.offset, view.limit, view.facet);
    return page.ok
      ? ok({ kind: "wasm", view, ...page.value, ...shared })
      : page;
  }
  const rows = report[view.facet];
  const item = rows.slice(view.offset, view.offset + view.limit);
  return ok({
    kind: "wasm",
    view,
    item,
    coverage: pageViewCoverage(view.offset, item.length, rows.length),
    ...shared,
  });
};
</file>

<file path="src/domain/analysisView/WebNetworkApiSurfaceAccumulator.test.ts">
import { expect, it, vi } from "vitest";
import { analysisViewCaptureFixture } from "../../../tests/fixtures/analysisView.js";
import type { WebNetworkCaptureRecord } from "../webNetworkCapture.js";
import { WebNetworkApiSurfaceAccumulator } from "./WebNetworkApiSurfaceAccumulator.js";
const record = (
  ordinal: number,
  path: string,
  method = "GET",
  mimeType = "application/json",
): WebNetworkCaptureRecord => ({
  ...analysisViewCaptureFixture().records[0]!,
  ordinal,
  limitations: [],
  reported: {
    request: { method, url: `https://api.test${path}` },
    response: { status: 200, content: { mimeType } },
  },
});
const add = (
  accumulator: WebNetworkApiSurfaceAccumulator,
  sample: WebNetworkCaptureRecord,
) => {
  const result = accumulator.add(sample);
  if (!result.ok) throw result.error;
};
it("bounds query parser expansion before publishing or merging observed names", () => {
  const accumulator = new WebNetworkApiSurfaceAccumulator(64 * 1024, true);
  add(accumulator, record(0, "/products?kept=1"));
  const before = accumulator.page(0, 1);
  expect(
    accumulator.add(record(1, `/products?${"x=1&".repeat(200)}`)),
  ).toMatchObject({
    ok: false,
    error: { _tag: "AnalysisResourceConstraintError" },
  });
  expect(accumulator.page(0, 1)).toEqual(before);
  add(accumulator, record(2, "/products?after=2"));
  expect(accumulator.page(0, 1).groups[0]?.query_parameter_names).toEqual([
    { name: "after", record_ordinals: [2] },
    { name: "kept", record_ordinals: [0] },
  ]);
});
it("charges each retained name once and each name's ordinal once per request", () => {
  const accumulator = new WebNetworkApiSurfaceAccumulator(1024 * 1024, true);
  for (let ordinal = 0; ordinal < 1000; ordinal += 1)
    add(accumulator, record(ordinal, "/products?category=one&category=two"));
  expect(accumulator.page(0, 1).groups[0]?.query_parameter_names).toEqual([
    {
      name: "category",
      record_ordinals: Array.from({ length: 1000 }, (_, index) => index),
    },
  ]);
});
it("admits the capture schema clone and grouping against the same budget", () => {
  const sample = record(0, `/${"a".repeat(1200)}`);
  const isolated = new WebNetworkApiSurfaceAccumulator(64 * 1024);
  add(isolated, sample);
  const accumulator = new WebNetworkApiSurfaceAccumulator(64 * 1024);
  expect(
    accumulator.admitCaptureClone({
      headers: Array.from({ length: 40 }, () => ({ name: "x", value: "y" })),
    }).ok,
  ).toBe(true);
  expect(accumulator.add(sample)).toMatchObject({
    ok: false,
    error: { _tag: "AnalysisResourceConstraintError" },
  });
  expect(accumulator.page(0, 1).groups).toEqual([]);
});
it.each(["admitCaptureClone", "admitInlineEvidence"] as const)(
  "%s refuses dense array expansion without enumerating its keys",
  (method) => {
    const array = Array.from({ length: 100_000 }, () => null);
    let enumerated = false;
    let inspected = 0;
    const ownNames = Object.getOwnPropertyNames;
    const ownDescriptor = Object.getOwnPropertyDescriptor;
    const keys = vi
      .spyOn(Object, "getOwnPropertyNames")
      .mockImplementation((value) => {
        if (value === array) enumerated = true;
        return ownNames(value);
      });
    const descriptors = vi
      .spyOn(Object, "getOwnPropertyDescriptor")
      .mockImplementation((value, key) => {
        if (value === array) inspected += 1;
        return ownDescriptor(value, key);
      });
    try {
      expect(
        new WebNetworkApiSurfaceAccumulator(4096)[method](array),
      ).toMatchObject({
        ok: false,
        error: { _tag: "AnalysisResourceConstraintError", resource: "memory" },
      });
      expect(enumerated).toBe(false);
      expect(inspected).toBeGreaterThan(0);
      expect(inspected).toBeLessThan(16);
    } finally {
      keys.mockRestore();
      descriptors.mockRestore();
    }
  },
);
it("charges non-enumerable fields that the capture schema would clone", () => {
  const value = Object.defineProperty({}, "records", {
    value: Array.from({ length: 100 }, () => ({ reported: {} })),
  });
  expect(
    new WebNetworkApiSurfaceAccumulator(64 * 1024).admitCaptureClone(value),
  ).toMatchObject({
    ok: false,
    error: { _tag: "AnalysisResourceConstraintError" },
  });
});
it("bounds many short literal groups, including groups with unavailable MIME types", () => {
  const accumulator = new WebNetworkApiSurfaceAccumulator(64 * 1024);
  let accepted = 0;
  for (; accepted < 1000; accepted += 1) {
    const before = accumulator.page(0, 1000);
    const result = accumulator.add(
      record(accepted, `/route${accepted}`, "GET", ""),
    );
    if (result.ok) continue;
    expect(result.error).toMatchObject({
      _tag: "AnalysisResourceConstraintError",
    });
    expect(accumulator.page(0, 1000)).toEqual(before);
