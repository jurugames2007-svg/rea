    expect(compareBundles(initialBundle, advancedBundle)).toMatchObject({
      status: "unknown",
      summary: { unknowns_advanced: 1, unresolved: 1 },
      changes: [
        expect.objectContaining({
          entity: "evidence",
          classification: "unknown",
        }),
