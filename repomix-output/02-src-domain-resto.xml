        (summary.frozen_strings_omitted ?? 0) +
        (summary.coverage.scan_bytes_omitted ?? 0) +
        (summary.coverage.frozen_scan_bytes_omitted ?? 0),
    ).toBeGreaterThan(0);
    expect(Buffer.byteLength(JSON.stringify(summary))).toBeLessThanOrEqual(
      budget,
    );
  });
});
