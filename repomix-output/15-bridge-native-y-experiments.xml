      page.parent_evidence_id !== parentEvidenceId ||
      page.parent_operation !== "inspect_pcap_capture" ||
      page.kind !== "pcap" ||
      page.page.facet !== "http-uris" ||
      page.source_coverage !== capture.coverage ||
      !isDeepStrictEqual(page.coverage, expectedCoverage)
