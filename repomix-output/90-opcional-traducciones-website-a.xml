"{ph0}02 · Caller{ph1}{ph2}A screen coordinate{ph3}{ph4}The brick-hit caller "
"passes {ph5}.{ph6}"
msgstr ""
"{ph0}02 * Llamador{ph1}{ph2}Una coordenada de pantalla{ph3}{ph4}El llamador "
"golpeado por un ladrillo pasa {ph5}.{ph6}"

#. {ph0}: <span class="flow-label">
