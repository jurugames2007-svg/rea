#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}Keep six digits.{ph1} The remainder after division by 1,000,000 is "
"padded with zeroes when needed, so a code can begin with 0."
msgstr ""
"{ph0}Mantén seis dígitos.{ph1} El resto después de la división por 1.000.000"
" se rellena con ceros cuando es necesario, por lo que un código puede "
"comenzar con 0."

