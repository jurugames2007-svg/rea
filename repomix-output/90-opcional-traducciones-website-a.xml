#. provider.md" >
#. {ph1}: </a >
#: website/public/get-started/index.html:1338
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid "{ph0}IDA profiles, registration examples and verified platforms{ph1}"
msgstr "{ph0}أنماط IDA وأمثلة التسجيل والمنصات المتحقق منها{ph1}"

#: website/public/get-started/index.html:1346
msgctxt "page:get-started/index.html"
msgid ""
"Once connected, give your agent the original executable's full path and name"
" your provider:"
msgstr ""
"بعد الربط، أعط مساعدك المسار الكامل للملف التنفيذي الأصلي واذكر أداة "
"التحليل:"

