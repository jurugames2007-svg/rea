msgctxt "page:faq/index.html"
msgid "Copy scoped setup command"
msgstr "Αντιγραφή εντολής ρύθμισης για συγκεκριμένη εφαρμογή"

#: website/public/faq/index.html:577
msgctxt "page:faq/index.html"
msgid "Back to top"
msgstr "Επιστροφή στην κορυφή"

