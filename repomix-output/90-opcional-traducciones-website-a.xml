#: website/public/showcase/aegis/index.html:506
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid "{ph0}03{ph1} Six digits"
msgstr "{ph0}03{ph1} Έξι ψηφία"

#: website/public/showcase/aegis/index.html:518
msgctxt "page:showcase/aegis/index.html"
msgid "REA · selected decompiled Java"
msgstr "REA · επιλεγμένος απομεταγλωττισμένος κώδικας Java"

#: website/public/showcase/aegis/index.html:548
msgctxt "page:showcase/aegis/index.html"
msgid "Readable summary · agent's interpretation"
msgstr "Ευανάγνωστη σύνοψη · ερμηνεία του βοηθού"

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:565
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}Time chooses the block.{ph1} Seconds 30 through 59 all give block 1. At"
" 60 seconds, the block becomes 2."
msgstr ""
"{ph0}Ο χρόνος επιλέγει το διάστημα.{ph1} Τα δευτερόλεπτα 30 έως 59 δίνουν "
"όλα το διάστημα 1. Στα 60 δευτερόλεπτα, το διάστημα γίνεται 2."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:571
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}The key matters too.{ph1} The generator combines the account key with "
"the block. An account with a different key can show a different code at the "
"same time."
msgstr ""
"{ph0}Μετράει και το κλειδί.{ph1} Η γεννήτρια συνδυάζει το κλειδί του "
"λογαριασμού με το διάστημα. Ένας λογαριασμός με διαφορετικό κλειδί μπορεί να"
" εμφανίζει διαφορετικό κωδικό την ίδια στιγμή."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:578
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}Keep six digits.{ph1} The remainder after division by 1,000,000 is "
"padded with zeroes when needed, so a code can begin with 0."
msgstr ""
"{ph0}Κρατήστε έξι ψηφία.{ph1} Το υπόλοιπο της διαίρεσης με το 1,000,000 "
"συμπληρώνεται με μηδενικά όπου χρειάζεται, οπότε ένας κωδικός μπορεί να "
"αρχίζει με 0."

#. {ph0}: <a
#. href="https://github.com/beemdevelopment/Aegis/blob/d6f4e5925a97e4e91593f1542085eae03432a759/LICENSE"
#. >
