  instructionBoundaryIssue(
    region.try_offset,
    region.try_length,
    boundaries,
    "try",
  ) ??
  methodExtentIssue(
    region.handler_offset,
    region.handler_length,
    ilSize,
    "handler",
  ) ??
  instructionBoundaryIssue(
    region.handler_offset,
    region.handler_length,
    boundaries,
    "handler",
