          ...current,
          libapp: {
            present: true,
            bytes,
            sha256: digest,
            elfHeaderValid:
              readElfHeader(headerPrefix.subarray(0, headerBytes), bytes)
                .header !== undefined,
            sources: scan.sources,
            candidates: scan.candidates,
