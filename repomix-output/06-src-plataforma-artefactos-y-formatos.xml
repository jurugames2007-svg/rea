    expect(
      parseDecodedStrings(
        '<resources><string name="a">one</string></resources><!-- </string> -->',
      ),
    ).toEqual({
      entries: [{ name: "a", value: "one" }],
      unparsedCount: 0,
    });
  });
  it("preserves source whitespace and entity spelling", () => {
    expect(
      parseDecodedStrings(
        '<resources><string name="raw">  a &amp; b  </string></resources>',
