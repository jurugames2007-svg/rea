  const roots: string[] = [];
  const unclassified: string[] = [];
  await consumeWithOrderedReads(
    new DirectoryArtifactReader(root).entries(signal),
    MAGIC_READ_CONCURRENCY,
    (entry) =>
      entry.kind === "file" ? files.startsWithMachoMagic(entry) : undefined,
