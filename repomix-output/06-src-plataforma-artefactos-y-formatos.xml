export type DispatchFacet =
  | "objc_class_method_ivar_metadata"
  | "binary_relative_pointers"
  | "objc_properties_categories"
  | "pointer_fixups"
  | "swift_conformances_static_witness_slots"
  | "swift_class_vtable_descriptors";
