import { estimateBinaryPlistExpansion } from "./InterfaceBuilderDecodeBudget.js";
const MAX_BYTES = 64 * 1024 * 1024;
const MAX_DECODE_BYTES = 8 * MAX_BYTES;
export const decodeKeyedArchiveBytes = (
  bytes: Buffer,
