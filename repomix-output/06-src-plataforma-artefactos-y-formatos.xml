});
describe("Windows Job Object memory limits", () => {
  it("emits close only after descendants leave the Job Object", async () => {
    const { native, calls } = authority({
      polls: [
        {
          ...settledPoll,
          stdoutEnded: false,
          stderrEnded: false,
          activeProcesses: 1,
        },
        settledPoll,
      ],
    });
    const child = launch(native);
    const events: string[] = [];
