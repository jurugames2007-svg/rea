    ).toEqual({ entries: [], unparsedCount: 1 });
    expect(
      parseDecodedStrings(
        '<resources><string name="styled">Hello <b>world</b></string></resources>',
      ),
    ).toEqual({ entries: [], unparsedCount: 1 });
  });
