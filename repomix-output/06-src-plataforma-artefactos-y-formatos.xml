    const decoded = parseXmlPropertyList(output);
    omittedPrototypeKeys = decoded.omittedPrototypeKeys;
    projected = projectPlistValue(decoded.value);
  } catch (cause: unknown) {
    return err(
      new AnalysisOutputError(
        "inspect_plist",
