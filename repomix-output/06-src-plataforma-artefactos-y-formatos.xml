  occurrence_id: occurrenceIdForLocation({
    rootArtifactId: node.artifact_id,
    logicalPath: ".",
    entryKind: metadata.format === "directory" ? "directory" : "file",
  }),
  artifact_id: node.artifact_id,
  parent_occurrence_id: null,
  logical_path: ".",
