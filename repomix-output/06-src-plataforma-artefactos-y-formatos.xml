      const middle = Math.floor((low + high) / 2);
      if (spans[middle]!.start <= address) low = middle + 1;
      else high = middle;
    }
    return low - 1;
  };
  signal?.throwIfAborted();
  return (address, size) => {
    const missing = () =>
      err({ reason: "has no contiguous file-backed PT_LOAD range" });
