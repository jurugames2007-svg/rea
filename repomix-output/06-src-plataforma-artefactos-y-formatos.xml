    cursor.readUInt16(),
    cursor.readUInt16(),
    cursor.readUInt16(),
    cursor.readUInt16(),
  ].join(".");
  const flags = cursor.readUInt32();
  const keyOrToken = readMetadataBlob(
    bytes,
    layout,
    cursor.readIndex(layout.blobIndexSize),
    heapExtent,
  );
  const name = readMetadataString(
    bytes,
    layout,
    cursor.readIndex(layout.stringIndexSize),
    heapExtent,
  );
  const culture = readMetadataString(
    bytes,
    layout,
    cursor.readIndex(layout.stringIndexSize),
