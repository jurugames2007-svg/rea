    for (const [filePath, file] of [...publishedFiles].sort(
      ([left], [right]) => (left < right ? -1 : left > right ? 1 : 0),
    )) {
      const size = file.size;
      if (size <= 0 || size > FIRMWARE_LIMITS.inputBytes) continue;
