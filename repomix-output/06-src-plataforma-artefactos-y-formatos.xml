    bytes,
    layout,
    cursor.readIndex(layout.guidIndexSize),
  );
  const encId = readMetadataGuid(
    bytes,
    layout,
    cursor.readIndex(layout.guidIndexSize),
  );
  const encBaseId = readMetadataGuid(
    bytes,
    layout,
    cursor.readIndex(layout.guidIndexSize),
  );
