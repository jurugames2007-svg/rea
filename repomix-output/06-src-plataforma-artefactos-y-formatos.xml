    return {
      status: "available",
      code: null,
      reason: null,
      diagnostics: {
        configured: true,
        java_executable: configuration.java,
        jdk_compiler: true,
        jar_path: configuration.jar,
        operation_timeout_ms: operationTimeoutMs,
      },
    };
  } catch (cause) {
    if (signal?.aborted === true) throw cause;
    if (cause instanceof JadxConfigurationFailure)
      return {
