  path: string,
  resources: ArtifactResourceScope,
  signal: AbortSignal | undefined,
  operation: (file: FileHandle) => Promise<Value>,
  symlinks: "follow" | "reject" = "reject",
): Promise<Value> => {
  let cleanupLease: AnalysisCleanupLease | undefined;
  assertArtifactReadActive(signal);
  try {
    const value = await withOwnedRegularFile(
      path,
      {
        symlinks,
        retainFailedClose: (owner) => {
          cleanupLease = new AnalysisCleanupLease(() => owner.close());
          resources.retain({
            kind: "lease",
            resource: path,
            lease: cleanupLease,
          });
        },
      },
      async (file) => {
        assertArtifactReadActive(signal);
        return await operation(file);
      },
    );
    if (signal?.aborted)
      throw new ArtifactFileCancelled({
        reason: signal.reason,
        outcome: { kind: "completed", value },
      });
    return value;
  } catch (cause: unknown) {
    if (
      cause instanceof RegularFileCleanupFailure &&
      cleanupLease !== undefined
    )
      throw new ArtifactFileCleanupFailure(
        cause,
        cleanupLease,
        signal?.aborted ? { reason: signal.reason } : undefined,
      );
    throw cause;
  }
};
export const withArtifactFileHandle = async <Value>(
  path: string,
  file: FileHandle,
  resources: ArtifactResourceScope | undefined,
  signal: AbortSignal | undefined,
  operation: (file: FileHandle) => Promise<Value>,
): Promise<Value> => {
  const owner = new OwnedFileHandle(file);
  const cleanupLease = new AnalysisCleanupLease(() => owner.close());
  try {
    return await withOwnedFileHandle(
      path,
      owner,
      {
        ...(signal === undefined ? {} : { signal }),
        retainFailedClose: () =>
          resources?.retain({
            kind: "lease",
            resource: path,
            lease: cleanupLease,
          }),
      },
      operation,
    );
  } catch (cause: unknown) {
    if (cause instanceof RegularFileCleanupFailure)
      throw new ArtifactFileCleanupFailure(
        cause,
        cleanupLease,
        signal?.aborted ? { reason: signal.reason } : undefined,
      );
    if (cause instanceof RegularFileCancelled)
      throw new ArtifactFileCancelled(cause);
    throw cause;
  }
};
