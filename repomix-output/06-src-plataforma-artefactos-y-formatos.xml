<file path="src/dotnet/ManagedTypeNesting.ts">
import { managedDecodeBudget } from "./ManagedDecodeBudget.js";
import { metadataRowCursor, metadataToken } from "./ManagedMetadataHeaps.js";
import type { ManagedMetadataLayout } from "./ManagedMetadataLayout.js";
import { managedFailure, readManagedValue } from "./ManagedReaderFailure.js";
import type { ManagedParseIssue } from "../domain/managed/managedArtifact.js";
export interface ManagedTypeNesting {
  readonly enclosing: ReadonlyMap<number, number>;
  readonly complete: boolean;
}
export const readManagedTypeNesting = (
  bytes: Buffer,
  layout: ManagedMetadataLayout,
  issues: ManagedParseIssue[],
): ManagedTypeNesting => {
  const initialIssues = issues.length;
  const typeCount = layout.table(2)?.rowCount ?? 0;
  const enclosing = new Map<number, number>();
  for (let row = 1; row <= (layout.table(41)?.rowCount ?? 0); row += 1) {
    readManagedValue(() => {
      const cursor = metadataRowCursor(bytes, layout, 41, row);
      const nested = cursor.readIndex(layout.tableIndexSize(2));
      const outer = cursor.readIndex(layout.tableIndexSize(2));
      if (
        nested < 1 ||
        outer < 1 ||
        nested > typeCount ||
        outer > typeCount ||
        nested === outer ||
        enclosing.has(nested)
      )
        throw managedFailure(
          "invalid-row",
          `metadata.NestedClass:${metadataToken(41, row)}`,
          `NestedClass requires a unique nested type and distinct existing enclosing type; observed ${nested} -> ${outer}`,
          cursor.start,
        );
      managedDecodeBudget(layout).reserve(128, cursor.start);
      enclosing.set(nested, outer);
    }, issues);
  }
  return { enclosing, complete: issues.length === initialIssues };
};
</file>

<file path="src/dotnet/ManagedTypeReferences.ts">
import { managedDecodeBudget } from "./ManagedDecodeBudget.js";
import type { ManagedMetadataLayout } from "./ManagedMetadataLayout.js";
import {
  metadataCodedTokenInvalidReason,
  metadataRowCursor,
  metadataToken,
  readMetadataString,
} from "./ManagedMetadataHeaps.js";
import { readManagedValue } from "./ManagedReaderFailure.js";
import { metadataRowOffset } from "./ManagedMetadataLayout.js";
import type { ManagedParseIssue } from "../domain/managed/managedArtifact.js";
export interface ManagedTypeReference {
  readonly namespace: string;
  readonly name: string;
  readonly enclosingRow: number | null;
  readonly scopeValid: boolean;
}
export type ManagedTypeReferenceLookup = (
  row: number,
) => ManagedTypeReference | null;
interface TypeReferenceRow {
  readonly nameIndex: number;
  readonly namespaceIndex: number;
  readonly enclosingRow: number | null;
  readonly scopeValid: boolean;
}
export const managedTypeReferences = (
  bytes: Buffer,
  layout: ManagedMetadataLayout,
  issues: ManagedParseIssue[],
): ManagedTypeReferenceLookup => {
  const rows = new Map<number, TypeReferenceRow | null>();
  const names = new Map<number, ManagedTypeReference | null>();
  const checked = new Map<number, boolean>();
  const read = (row: number): TypeReferenceRow | null => {
    const cached = rows.get(row);
    if (cached !== undefined) return cached;
    managedDecodeBudget(layout).reserve(384, null);
    const value =
      readManagedValue(() => {
        const cursor = metadataRowCursor(bytes, layout, 1, row);
        const raw = cursor.readIndex(layout.codedIndexSize("ResolutionScope"));
        const reason = metadataCodedTokenInvalidReason(
          raw,
          2,
          [0, 26, 35, 1],
          layout.rowCounts,
        );
        if (reason !== null)
          issues.push({
            code: "invalid-row",
            scope: `metadata.TypeRef:${metadataToken(1, row)}`,
            offset: cursor.start,
            detail: `TypeRef ResolutionScope coded index 0x${raw.toString(16)} is invalid: ${reason}`,
          });
        return {
          nameIndex: cursor.readIndex(layout.stringIndexSize),
          namespaceIndex: cursor.readIndex(layout.stringIndexSize),
          enclosingRow:
            raw !== 0 && (raw & 3) === 3 ? Math.floor(raw / 4) : null,
          scopeValid: reason === null,
        };
      }, issues) ?? null;
    rows.set(row, value);
    return value;
  };
  const validate = (row: number): boolean => {
    const prior = checked.get(row);
    if (prior !== undefined) return prior;
    const path: number[] = [];
    const seen = new Set<number>();
    let current: number | null = row;
    let valid = true;
    while (current !== null) {
      const known = checked.get(current);
      if (known !== undefined) {
        valid = known;
        break;
      }
      if (seen.has(current)) {
        issues.push({
          code: "invalid-row",
          scope: `metadata.TypeRef:${metadataToken(1, current)}`,
          offset: metadataRowOffset(layout, 1, current),
          detail: "TypeRef ResolutionScope chain contains a cycle",
        });
        valid = false;
        break;
      }
      seen.add(current);
      path.push(current);
      const value = read(current);
      if (value === null || !value.scopeValid) {
        valid = false;
        break;
      }
      current = value.enclosingRow;
    }
    for (const visited of path) checked.set(visited, valid);
    return valid;
  };
  return (row) => {
    const cached = names.get(row);
    if (cached !== undefined) return cached;
    const value = read(row);
    if (value === null) return null;
    const scopeValid = validate(row);
    managedDecodeBudget(layout).reserve(128, null);
    const named =
      readManagedValue(
        () => ({
          namespace: readMetadataString(
            bytes,
            layout,
            value.namespaceIndex,
            layout.strings.size,
          ),
          name: readMetadataString(
            bytes,
            layout,
            value.nameIndex,
            layout.strings.size,
          ),
          enclosingRow: value.enclosingRow,
          scopeValid,
        }),
        issues,
      ) ?? null;
    names.set(row, named);
    return named;
  };
};
</file>

<file path="src/dotnet/ManagedUserStrings.ts">
import {
  admitManagedProjection,
  managedDecodeBudget,
} from "./ManagedDecodeBudget.js";
import type {
  ManagedMemberInspection,
  ManagedParseIssue,
} from "../domain/managed/managedArtifact.js";
import type {
  ManagedMethod,
  ManagedUserString,
} from "./ManagedMemberInspectorCore.js";
import type { ManagedMetadataLayout } from "./ManagedMetadataLayout.js";
import { readMetadataUserString } from "./ManagedMetadataHeaps.js";
import { readManagedValue } from "./ManagedReaderFailure.js";
type UserStringInventory = NonNullable<ManagedMemberInspection["user_strings"]>;
const inventory = (
  literals: ManagedUserString[],
  issues: ManagedParseIssue[],
  scanned: boolean,
): UserStringInventory => ({
  state: issues.length === 0 && scanned ? "complete" : "partial",
  literals,
  issues,
});
const USER_STRING_TOKEN_BYTES = 128;
export const parseUserStrings = (
  bytes: Buffer,
  layout: ManagedMetadataLayout,
  parsed: {
    readonly methods: readonly ManagedMethod[];
    readonly unscannedMethods: number;
    readonly unreadableSelectedTypes?: number;
  },
): UserStringInventory => {
  const { methods } = parsed;
  const budget = managedDecodeBudget(layout);
  const scanned =
    parsed.unscannedMethods === 0 &&
    (parsed.unreadableSelectedTypes ?? 0) === 0;
  const userStrings: ManagedUserString[] = [];
  const issues: ManagedParseIssue[] = [];
  const tokens = new Set<string>();
  try {
    for (const method of methods)
      for (const { opcode, operand } of method.body.anchors)
        if (opcode === "ldstr" && operand !== null && !tokens.has(operand)) {
          budget.admitTransient(USER_STRING_TOKEN_BYTES, null);
          tokens.add(operand);
        }
    const references: string[] = [];
    for (const token of [...tokens].sort()) {
      if (token.startsWith("0x70")) references.push(token);
      else
        issues.push(
          admitManagedProjection(
            {
              code: "invalid-heap-index",
              scope: `metadata.#US:${token}`,
              offset: null,
              detail: "ldstr operand does not name an item inside #US",
            },
            budget,
          ),
        );
    }
    if (references.length > 0 && layout.userStrings === null) {
      issues.push(
        admitManagedProjection(
          {
            code: "missing-stream",
            scope: "metadata.#US",
            offset: null,
            detail: `${String(references.length)} distinct ldstr operand(s) reference #US, but the metadata has no #US stream`,
          },
          budget,
        ),
      );
      return inventory(userStrings, issues, scanned);
    }
    for (const token of references) {
      const failures: ManagedParseIssue[] = [];
      readManagedValue(() => {
        const {
          offset,
          value,
          issues: observed,
        } = readMetadataUserString(bytes, layout, token);
        for (const issue of observed) failures.push(issue);
        userStrings.push(
          admitManagedProjection({ token, offset, value }, budget),
        );
      }, failures);
      for (const failure of failures)
        issues.push(admitManagedProjection(failure, budget));
    }
    return inventory(userStrings, issues, scanned);
  } finally {
    budget.releaseTransient();
  }
};
</file>

