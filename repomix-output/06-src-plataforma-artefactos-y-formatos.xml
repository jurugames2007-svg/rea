      { at: segment.vaddr, delta: segment.offset - segment.vaddr, change: 1 },
      {
        at: segment.vaddr + segment.filesz,
        delta: segment.offset - segment.vaddr,
        change: -1,
      },
    ])
    .sort((left, right) => left.at - right.at);
