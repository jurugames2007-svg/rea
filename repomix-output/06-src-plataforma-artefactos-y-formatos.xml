    if (!/^[1-9]\d*$/u.test(value) || !Number.isSafeInteger(Number(value)))
      throw configurationFailure(
        "open_options_invalid",
        `${name} must be a positive safe integer; received ${value}.`,
        { setting: name, value },
        "jvm_options",
