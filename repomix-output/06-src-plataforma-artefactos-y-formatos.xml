        !Number.isSafeInteger(offset) ||
        !Number.isSafeInteger(sliceSize) ||
        offset < 0 ||
        sliceSize <= 0 ||
        !Number.isSafeInteger(offset + sliceSize) ||
        offset + sliceSize > fileSize
