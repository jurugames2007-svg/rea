  expect(projected.remediation).toMatchObject({
    action: expect.stringContaining("REA_ADB_PATH") as unknown,
  });
  expect(projected.details).toMatchObject({
    provider_id: "adb",
    reason: expect.stringContaining("not found") as unknown,
  });
});
