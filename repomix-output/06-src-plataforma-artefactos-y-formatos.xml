    SQLITE_PROVIDER_IDENTITY.id,
    resources,
    {
      ...details,
      reason,
      previous_error: result.ok ? null : projectAnalysisError(result.error),
      ...(output === undefined ? {} : { captured_output: { ...output } }),
    },
    {
      operation,
