  for (let index = 0; index < sectionCount; index++) {
    const at = table + index * 40;
    const section = {
      rva: bytes.readUInt32LE(at + 12),
      virtualSize: bytes.readUInt32LE(at + 8),
      offset: bytes.readUInt32LE(at + 20),
      size: bytes.readUInt32LE(at + 16),
