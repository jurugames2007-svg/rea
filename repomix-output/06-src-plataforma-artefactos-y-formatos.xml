    }
    if (char === "(") {
      if (closed) throw new Error("Unexpected second WABT WAT module.");
      depth++;
      if (depth === 2) start = index;
    } else if (char === ")") {
      if (depth === 2) {
        const form = text.slice(start, index + 1);
        if (
          /^\((?:type|rec|import|export|func|table|memory|global|tag)\s/u.test(
            form,
          )
