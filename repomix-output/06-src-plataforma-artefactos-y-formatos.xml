  createArtifactNode({
    sha256:
      input.digest?.sha256 ??
      digestCanonicalValue(
        {
          kind: "directory-root",
          children: input.occurrences
            .map(({ logical_path, artifact_id }) => ({
              logical_path,
              artifact_id,
