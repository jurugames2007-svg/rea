};
const lowerBound = <T>(
  rows: readonly T[],
  key: string,
  identity: (row: T) => string,
): number => {
  let low = 0;
  let high = rows.length;
  while (low < high) {
    const middle = low + Math.floor((high - low) / 2);
    const row = rows[middle];
    if (row !== undefined && compareUnicodeCodePoints(identity(row), key) < 0)
      low = middle + 1;
