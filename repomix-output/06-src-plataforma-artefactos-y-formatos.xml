    return this.#error.deref() !== undefined;
  }
  ownerReleased(owner: AnalysisCleanupLease): void {
    if (!this.#pending.delete(owner) || this.#pending.size > 0) return;
    this.#error.deref()?.resolveCleanup();
    this.#pending.clear();
