    for (const reference of this.#errors) reference.deref()?.resolveCleanup();
    this.#errors = [];
  }
}
export class AnalysisCleanupLeaseGroup {
  readonly #error: WeakRef<AnalysisError>;
  readonly #pending: Set<AnalysisCleanupLease>;
