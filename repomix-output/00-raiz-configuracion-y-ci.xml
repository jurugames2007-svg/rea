        if: ${{ !cancelled() }}
        env:
          CODE_REQUIRED: ${{ needs.changes.outputs.code }}
          SHARD_RESULT: ${{ needs.test-shard.result }}
          SOURCE_REQUIRED: ${{ needs.changes.outputs.tier == 'fast' }}
          SOURCE_RESULT: ${{ needs.test-source.result }}
        run: |
          if [ "${CODE_REQUIRED}" = "true" ]; then
