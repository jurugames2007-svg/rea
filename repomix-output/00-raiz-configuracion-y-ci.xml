      description: What are you trying to understand or do, and what is difficult today? A short example is enough.
    validations:
      required: true
  - type: textarea
    id: use-cases
    attributes:
      label: Use cases
      description: Optional examples of affected workflows, targets, or callers and their practical impact. Include observed frequency or measurements when available; do not invent them. Leave blank if covered above.
  - type: textarea
    id: desired-outcome
    attributes:
      label: Desired outcome and success criteria
      description: What would a useful result look like? Describe the output or behavior you want; implementation details are optional.
      placeholder: For a selected APK, show whether it is packed and include the detection evidence.
    validations:
      required: true
  - type: dropdown
    id: target-interaction
    attributes:
      label: Expected interaction with targets
      description: >-
        Select all known effects, including upstream tool behavior. Add "Not sure
        yet" if anything is unclear. Use "No target interaction" only on its own.
        These selections help discussion and do not establish scope approval.
      multiple: true
      options:
        - Read existing files or captured data
        - Launch or attach to a process
        - Inject instrumentation or run scripts/code
        - Change process memory or registers
        - Write or change files/configuration
        - Contact network services
        - Recover protected code or work around protections
        - No target interaction (documentation or usability only)
        - Not sure yet
    validations:
      required: true
  - type: textarea
    id: boundaries
    attributes:
      label: Target and scope details (optional)
      description: >-
        If known, name the target/platform, clarify selected effects, or list a
        non-goal or scope question. You can leave this blank; maintainers can help.
        Do not include private samples or proof-of-authorization documents.
  - type: dropdown
    id: verification-readiness
    attributes:
      label: Verification available so far
      description: Pick the closest match. An idea without samples or test results is welcome.
      options:
        - Idea only; I need help defining checks
        - I can suggest a sample or manual check
        - I have a prototype or observed results
        - Not sure yet
    validations:
      required: true
  - type: textarea
    id: verification
    attributes:
      label: Verification details (optional)
      description: >-
        Share an expected output, a possible check, or existing results if you have
        them. Self-owned or appropriately licensed samples can help, but are not
        required to open a request. Do not attach private or sensitive data.
  - type: textarea
    id: alternatives
    attributes:
      label: Alternatives considered
      description: Describe existing REA operations, upstream tools, or workarounds considered and why they do not meet the need.
  - type: textarea
    id: possible-direction
    attributes:
      label: Possible direction
      description: Optional implementation or integration idea. Treat it as a proposal, not a requirement.
  - type: textarea
    id: references
    attributes:
      label: References
      description: Optional supporting examples, provider documentation, source, measurements, artifacts, issues, or prior art. Distinguish observed results from expected benefits; an idea without evidence is welcome.
</file>

<file path=".github/workflows/ci-full-pr.yml">
name: Full PR qualification
on:
  pull_request:
    branches: [main, "release/*"]
    types: [labeled]
permissions:
  contents: read
  actions: read
jobs:
  qualification:
    name: Qualify labeled PR revision
    if: github.event.label.name == 'ci:full'
    uses: ./.github/workflows/ci.yml
    with:
      source_sha: ${{ github.sha }}
</file>

<file path=".github/workflows/ci-timings.yml">
name: CI timings
on:
  schedule:
    - cron: "17 * * * *"
  workflow_dispatch:
concurrency:
  group: ci-timings-${{ github.repository }}
  cancel-in-progress: false
permissions:
  contents: read
  actions: read
  pull-requests: read
jobs:
  report:
    name: Collect recent completed workflow attempts
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        continue-on-error: true
        uses: ./.github/actions/npm-cache
      - name: Diagnose missing and startup-failed PR CI
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          CI_REPOSITORY: ${{ github.repository }}
          CI_REPOSITORY_ID: ${{ github.repository_id }}
          CI_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: node scripts/ci/pr-ci-health.mjs
      - name: Record queue, execution, and matched step timing
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          CI_REPOSITORY: ${{ github.repository }}
        run: node scripts/ci/job-timings-batch.mjs
      - name: Upload CI timing artifacts
        if: always() && hashFiles('.cache/ci-job-timings/*') != ''
        continue-on-error: true
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: ci-job-timings-batch
          path: .cache/ci-job-timings/
          include-hidden-files: true
          if-no-files-found: error
          overwrite: true
          retention-days: 14
      - name: Install dependencies for static failure attribution
        id: failure-deps
        if: ${{ !cancelled() && hashFiles('.cache/ci-job-timings/batch-manifest.json') != '' }}
        continue-on-error: true
        run: npm ci
      - name: Attribute supported static failures against main
        if: ${{ !cancelled() && steps.failure-deps.outcome == 'success' && hashFiles('.cache/ci-job-timings/batch-manifest.json') != '' }}
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          CI_REPOSITORY: ${{ github.repository }}
          CI_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: node scripts/ci/failure-report.mjs
      - name: Upload CI health and failure diagnostics
        if: ${{ !cancelled() }}
        continue-on-error: true
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: ci-health-diagnostics
          path: |
            .cache/ci-pr-health/
            .cache/ci-failures/
          include-hidden-files: true
          if-no-files-found: warn
          retention-days: 14
</file>

<file path=".github/workflows/ci.yml">
name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main, "release/*"]
  schedule:
    - cron: "23 0-2,4-23 * * *"
    - cron: "23 3 * * *"
  workflow_dispatch:
  workflow_call:
    inputs:
      source_sha:
        description: Exact qualification source; must match the caller revision.
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: ci-${{ (github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || inputs.source_sha != '' || contains(github.event.pull_request.labels.*.name, 'ci:full')) && 'qualification' || 'feedback' }}-${{ inputs.source_sha || github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' && inputs.source_sha == '' && !contains(github.event.pull_request.labels.*.name, 'ci:full') }}
env:
  HUSKY: "0"
jobs:
  changes:
    name: Classify changes
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: read
      actions: read
    outputs:
      tier: ${{ steps.plan.outputs.tier }}
      qualification_run_id: ${{ steps.qualification.outputs.run_id }}
      code: ${{ steps.plan.outputs.code }}
      reverse_tools: ${{ steps.plan.outputs.reverse_tools }}
      sqlite: ${{ steps.plan.outputs.sqlite }}
      runtime: ${{ steps.plan.outputs.runtime }}
      package: ${{ steps.plan.outputs.package }}
      apple: ${{ steps.plan.outputs.apple }}
      fixtures: ${{ steps.plan.outputs.fixtures }}
      readiness: ${{ steps.plan.outputs.readiness }}
      docs: ${{ steps.plan.outputs.docs }}
      workflows: ${{ steps.plan.outputs.workflows }}
      browser: ${{ steps.plan.outputs.browser }}
      binary_layout: ${{ steps.plan.outputs.binary_layout }}
      evm: ${{ steps.plan.outputs.evm }}
      javascript_recovery: ${{ steps.plan.outputs.javascript_recovery }}
      recorded_crash: ${{ steps.plan.outputs.recorded_crash }}
      web_network: ${{ steps.plan.outputs.web_network }}
      web_runtime: ${{ steps.plan.outputs.web_runtime }}
      web_source_map: ${{ steps.plan.outputs.web_source_map }}
      nativeaot: ${{ steps.plan.outputs.nativeaot }}
      ghidra_bridge: ${{ steps.plan.outputs.ghidra_bridge }}
      website: ${{ steps.plan.outputs.website }}
      matrix: ${{ steps.plan.outputs.matrix }}
      test_selection: ${{ steps.plan.outputs.test_selection }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.source_sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Bind qualification to the caller revision
        if: inputs.source_sha != ''
        env:
          SOURCE_SHA: ${{ inputs.source_sha }}
        run: |
          test "${SOURCE_SHA}" = "${GITHUB_SHA}"
          test "${SOURCE_SHA}" = "$(git rev-parse HEAD)"
      - name: Find a verified ancestor for push selection
        id: baseline
        if: github.event_name == 'push' && inputs.source_sha == ''
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_SHA: ${{ github.sha }}
          CI_REPOSITORY: ${{ github.repository }}
          CI_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: node scripts/ci/baseline.mjs
      - name: Admit scheduled full qualification
        id: qualification
        if: github.event_name == 'schedule' && inputs.source_sha == ''
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD_SHA: ${{ github.sha }}
          CI_REPOSITORY: ${{ github.repository }}
          CI_REPOSITORY_ID: ${{ github.repository_id }}
          CI_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          CI_FORCE_FULL: ${{ github.event.schedule == '23 3 * * *' }}
        run: node scripts/ci/qualification.mjs
      - name: Select verification lanes
        id: plan
        env:
          BASE_SHA: ${{ steps.baseline.outputs.base || github.event.pull_request.base.sha }}
          BASELINE_REASON: ${{ steps.baseline.outputs.reason }}
          HEAD_SHA: ${{ inputs.source_sha || github.event.pull_request.head.sha || github.sha }}
          CI_FULL: ${{ inputs.source_sha != '' || contains(github.event.pull_request.labels.*.name, 'ci:full') }}
          CI_SKIP_FULL: ${{ steps.qualification.outputs.run_full == 'false' }}
        run: node scripts/ci/plan.mjs
  static:
    name: Static checks
    needs: changes
    if: ${{ !cancelled() && needs.changes.outputs.tier != 'reused' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Require successful change classification
        env:
          CHANGES_RESULT: ${{ needs.changes.result }}
        run: test "${CHANGES_RESULT}" = "success"
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - run: npm ci
      - name: Restore static task cache
        if: needs.changes.outputs.code == 'true'
        id: static-cache
        uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: .turbo/cache/
          key: rea-static-v1-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('.nvmrc', '.npmrc', 'package-lock.json') }}-${{ github.sha }}
          restore-keys: rea-static-v1-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('.nvmrc', '.npmrc', 'package-lock.json') }}-
      - name: Validate workflow syntax and expressions
        if: needs.changes.outputs.workflows == 'true'
        run: go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.7 -shellcheck= -pyflakes=
      - name: Check action pins for workflow-only changes
        if: needs.changes.outputs.workflows == 'true' && needs.changes.outputs.code != 'true'
        run: node scripts/run-exact-tests.mjs run tests/boundary/filesystem/workflowActionPinning.test.ts
      - name: Record static task source and execution identity
        continue-on-error: true
        if: needs.changes.outputs.code == 'true'
        env:
          CI_PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: npm run ci:static-context
      - if: needs.changes.outputs.code == 'true'
        run: npm run check:ci
      - if: needs.changes.outputs.code == 'true'
        run: npm run verify:test-discovery
      - name: Check LLDB producer retention and launch contracts
        if: needs.changes.outputs.code == 'true'
        run: npm run test:python
      - if: needs.changes.outputs.code != 'true'
        run: npm run format:check
      - name: Save validated static task cache
        if: >-
          success() && needs.changes.outputs.code == 'true' &&
          steps.npm-cache.outputs.can-save == 'true' &&
          steps.static-cache.outputs.cache-hit != 'true'
        uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
        with:
          path: .turbo/cache/
          key: ${{ steps.static-cache.outputs.cache-primary-key }}
      - name: Upload complete static diagnostics
        if: always() && needs.changes.outputs.code == 'true'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: static-check-reports
          path: .cache/static-checks/
          include-hidden-files: true
          if-no-files-found: ignore
          retention-days: 7
  test-source:
    name: Source tests
    needs: changes
    if: needs.changes.outputs.code == 'true' && needs.changes.outputs.tier == 'fast'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - run: npm ci
      - name: Run source tests without waiting for build
        run: npm run test:fast -- --reporter=default --reporter=blob
        env:
          VITEST_BLOB_LABEL: source
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: ${{ !cancelled() }}
        with:
          name: vitest-report-source
          path: .vitest/blob/*
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
  test-shard:
    name: Test shard (${{ matrix.shard }})
    needs: [changes, build]
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: ${{ github.event_name == 'pull_request' && needs.changes.outputs.tier == 'fast' }}
      matrix:
        shard: ${{ fromJSON(needs.changes.outputs.tier == 'fast' && '["1/5","2/5","3/5","4/5","5/5"]' || '["1/6","2/6","3/6","4/6","5/6","6/6"]') }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - run: npm ci
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: rea-test-runtime
          path: .
      - name: Run complete portable suite with coverage
        if: needs.changes.outputs.tier == 'full'
        run: npm run test:ci:shard:run -- --shard=${{ matrix.shard }}
        env:
          REA_CI_TEST_HISTORY: .cache/ci-test-history/test-results.json
      - name: Run built-dependent tests for fast feedback
        if: needs.changes.outputs.tier == 'fast'
        run: npm run test:built -- --reporter=default --reporter=blob --shard=${{ matrix.shard }}
        env:
          VITEST_BLOB_LABEL: built
          REA_CI_TEST_HISTORY: .cache/ci-test-history/test-results.json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: ${{ !cancelled() }}
        with:
          name: vitest-report-built-${{ strategy.job-index }}
          path: .vitest/blob/*
          include-hidden-files: true
          if-no-files-found: error
          overwrite: true
          retention-days: 7
  reverse-tools-quality:
    name: Reverse tools quality
    needs: [changes, static]
    if: needs.changes.outputs.reverse_tools == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - run: npm ci
      - name: Run reverse tools tests with coverage
        run: npm run test:coverage:reverse-tools
      - name: Preflight both reverse tools mutation configurations
        run: |
          node scripts/prepare-reverse-tools-mutation.mjs
          npx --no-install stryker run stryker.config.mjs --dryRunOnly
          npx --no-install stryker run stryker.semantics.config.mjs --dryRunOnly
      - name: Retain available reverse tools diagnostics
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: reverse-tools-quality-${{ needs.changes.outputs.tier }}-${{ github.run_attempt }}
          path: |
            coverage/reverse-tools/
            reports/mutation/
          if-no-files-found: warn
          retention-days: 7
  build:
    name: Build package
    needs: changes
    if: >-
      needs.changes.outputs.code == 'true' ||
      needs.changes.outputs.browser == 'true' ||
      needs.changes.outputs.binary_layout == 'true' ||
      needs.changes.outputs.evm == 'true' ||
      needs.changes.outputs.javascript_recovery == 'true' ||
      needs.changes.outputs.recorded_crash == 'true' ||
      needs.changes.outputs.web_network == 'true' ||
      needs.changes.outputs.web_runtime == 'true' ||
      needs.changes.outputs.web_source_map == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      actions: read
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - run: npm ci
      - name: Reuse portable build outputs across runs
        uses: ./.github/actions/portable-build-cache
        with:
          save: ${{ github.event_name != 'pull_request' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}
      - run: npm run test:prepare
      - name: Find available trusted full-suite timing history
        id: history
        continue-on-error: true
        env:
          GH_TOKEN: ${{ github.token }}
          CI_REPOSITORY: ${{ github.repository }}
          CI_REPOSITORY_ID: ${{ github.repository_id }}
          CI_DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
        run: node scripts/ci/test-history.mjs
      - name: Download previous timing report
        if: steps.history.outputs.run-id != ''
        continue-on-error: true
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: test-timings
          run-id: ${{ steps.history.outputs.run-id }}
          github-token: ${{ github.token }}
          path: .cache/ci-test-history
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rea-test-runtime
          path: |
            dist/
            skills/
            .cache/mcp-tool-catalog.json
            .cache/ci-test-history/test-results.json
            docs/public/product-catalog.json
            docs/verification/managed-conformance-*.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: rea-build-cache
          path: .turbo/cache/
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7
  sqlite-runtime:
    needs: [changes, static, build]
    if: needs.changes.outputs.sqlite == 'true'
    uses: ./.github/workflows/sqlite-runtime.yml
  test:
    name: Portable tests
    needs: [changes, test-source, test-shard]
    if: ${{ !cancelled() && needs.changes.outputs.tier != 'reused' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Require successful change classification
        env:
          CHANGES_RESULT: ${{ needs.changes.result }}
        run: test "${CHANGES_RESULT}" = "success"
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        if: needs.changes.outputs.code == 'true' && success()
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        if: needs.changes.outputs.code == 'true' && success()
        with:
          node-version-file: .nvmrc
      - name: Cache npm package downloads
        if: needs.changes.outputs.code == 'true' && success()
        id: npm-cache
        uses: ./.github/actions/npm-cache
      - if: needs.changes.outputs.code == 'true' && success()
        run: npm ci
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        if: >-
          !cancelled() && needs.changes.outputs.code == 'true' &&
          (needs.test-shard.result == 'success' || needs.test-shard.result == 'failure' ||
           (needs.changes.outputs.tier == 'fast' &&
            (needs.test-source.result == 'success' || needs.test-source.result == 'failure')))
        with:
          path: .vitest/blob
          pattern: vitest-report-*
          merge-multiple: true
      - name: Merge coverage, JUnit, and timing reports
        id: merge
        if: >-
          !cancelled() && needs.changes.outputs.code == 'true' &&
          needs.changes.outputs.tier == 'full' &&
          (needs.test-shard.result == 'success' || needs.test-shard.result == 'failure')
        run: >-
          npm run test:ci:merge --
          --coverage.reportsDirectory=coverage
          --coverage.reporter=text
          --coverage.reporter=json-summary
          --coverage.reporter=lcov
          --reporter=default
          --reporter=junit
          --reporter=json
          --reporter=./scripts/ci/test-timing-reporter.mjs
          --outputFile.junit=test-results.xml
          --outputFile.json=test-results.json
      - name: Merge fast-suite JUnit and timing reports
        id: merge-fast
        if: >-
          !cancelled() && needs.changes.outputs.code == 'true' &&
          needs.changes.outputs.tier == 'fast' &&
          (needs.test-shard.result == 'success' || needs.test-shard.result == 'failure' ||
           needs.test-source.result == 'success' || needs.test-source.result == 'failure')
        run: >-
          npm exec -- vitest --merge-reports
          --reporter=default
          --reporter=junit
          --reporter=json
          --reporter=./scripts/ci/test-timing-reporter.mjs
          --outputFile.junit=test-results.xml
          --outputFile.json=test-results.json
      - name: Summarize slowest test files
        if: needs.changes.outputs.code == 'true' && !cancelled()
        env:
          SHARD_RESULT: ${{ needs.test-shard.result }}
          SOURCE_REQUIRED: ${{ needs.changes.outputs.tier == 'fast' }}
          SOURCE_RESULT: ${{ needs.test-source.result }}
          MERGE_RESULT: ${{ needs.changes.outputs.tier == 'full' && steps.merge.outcome || steps.merge-fast.outcome }}
          CI_VERIFY_TEST_INVENTORY: "true"
          CI_TEST_SELECTION: ${{ needs.changes.outputs.test_selection }}
          CI_PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: node scripts/ci/test-report.mjs
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: needs.changes.outputs.code == 'true' && !cancelled() && hashFiles('test-results.json') != ''
        with:
          name: test-results
          path: |
            test-results.xml
            test-results.json
            test-timings.json
            coverage/
            .cache/ci-test-selection/report.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 30
      - name: Publish successful timing history
        if: needs.changes.outputs.code == 'true' && needs.changes.outputs.tier == 'full' && success() && needs.test-shard.result == 'success'
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
