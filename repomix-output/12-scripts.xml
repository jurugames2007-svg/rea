    inventory.pullRequests.flatMap((pr) =>
      pr.issues
        .filter(
          (item) =>
            item.repository.nameWithOwner.toLowerCase() ===
            inventory.repository.toLowerCase(),
        )
        .map((item) => item.number),
    ),
  );
