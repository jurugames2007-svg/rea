        compiler,
        variant,
        oracle_fault_controls: oracleFaultControls,
        sha256,
        compiler_oracle: fixtures.map(
          ({
            name,
            address,
            dispatch_address,
            table_address,
            slots,
            default_address,
          }) => ({
            name,
            address,
            dispatch_address,
            table_address,
            slots,
            default_address,
