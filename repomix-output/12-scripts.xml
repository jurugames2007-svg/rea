}
export async function verifyRecoveryPackage({
  directory,
  sourceSha,
  runId,
  runAttempt,
  version,
  integrity,
}) {
  const tarball = await validateVerifiedPackage({
    directory,
    sourceSha,
    runId,
    runAttempt,
    packageVersion: version,
    nodeVersion: process.version,
  });
