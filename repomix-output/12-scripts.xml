    for (const side of ["client_conn", "server_conn"])
      for (const key of ["id", "tls_version", "timestamp_tls_setup", "error"])
        assert.equal(
          record.reported[side][key],
          producer[side][key],
          `${side}.${key} differs from producer observation ${producer.id}`,
