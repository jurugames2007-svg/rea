    throw new Error(
      "packaged MCP exceeded the first-catalog regression budget",
    );
};
const elapsed = (startedAt, completedAt) =>
  Math.round((completedAt - startedAt) * 100) / 100;
const boundedAppend = (current, chunk) =>
  `${current}${chunk}`.slice(-64 * 1_024);
