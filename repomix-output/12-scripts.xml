      repository: { type: "string" },
      pr: { type: "string" },
      base: { type: "string" },
      target: { type: "string" },
      version: { type: "string" },
      manifest: { type: "string" },
      notes: { type: "string", default: "CHANGELOG.md" },
      "pr-body": { type: "string" },
      source: { type: "string" },
      output: { type: "string" },
      summary: { type: "boolean", default: false },
