  normalizedResult,
  tool,
  pattern,
  expectedPrefix,
  expectedCount,
  normalize,
}) {
  const matches = normalizedResult(
    await client.callTool(
      {
        name: tool,
        arguments: { pattern, mode: "literal", case_sensitive: true },
      },
      options,
    ),
