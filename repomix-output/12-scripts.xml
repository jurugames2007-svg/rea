    instruction.status !== "decoded" ||
    !isDefaultMinusOneAssignment(instruction)
  )
    throw new Error(
      `Dense default target lacks the source -1 assignment (x86 register/stack MOV or AArch64 W-register MOVN): ${JSON.stringify(instruction)}`,
    );
