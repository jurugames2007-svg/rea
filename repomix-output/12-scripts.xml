      ? once(child, "exit")
      : Promise.resolve();
  void exited.catch(() => undefined);
  let connection;
  let timer;
  const escalation = setTimeout(() => {
    if (child.exitCode === null && child.signalCode === null)
      child.kill("SIGKILL");
  }, 2_000);
  try {
    if (child.exitCode === null && child.signalCode === null) {
      try {
        const [port, browserPath] = (
          await readFile(join(profile, "DevToolsActivePort"), "utf8")
        )
          .trim()
          .split("\n");
