    rss.stop();
    await Promise.allSettled([client.close(), transport.close()]);
  }
}
export async function profileMcpModuleLoading({
  command,
  args,
  environment,
  policy,
  packageName,
}) {
  const profile = createEsmModuleProfileCollector(packageName);
