    primaryFailure = cause;
    throw cause;
  } finally {
    const closed = await client.close();
    if (!closed.ok)
      throw primaryFailure === undefined
        ? closed.error
        : new AggregateError(
            [primaryFailure, closed.error],
            "Ghidra verification and cleanup failed",
