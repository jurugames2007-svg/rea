  assert.deepEqual(indirect.references, []);
  assert.equal(unresolved.status, "unresolved");
  assert.deepEqual(unresolved.targets, []);
  const returned = await verifyEmptyReferences(
    call,
    address(x86 ? 0x1043 : 0x104c),
