  assert.equal(record.reported[side].headers.length, regular.length);
  for (const [index, pair] of regular.entries()) {
    binaryEqual(record, `/${side}/headers/${index}/0`, pair[0]);
    binaryEqual(record, `/${side}/headers/${index}/1`, pair[1]);
