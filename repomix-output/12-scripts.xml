    label: manifest.label ?? null,
    assertions,
    target: {
      file_name: basename(targetPath),
      sha256: target.sha256,
      mvid: artifact.module?.mvid ?? null,
      assembly_name: artifact.assembly?.name ?? null,
      runtime_family: artifact.classification.runtime_family,
