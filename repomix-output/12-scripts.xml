      z.string().min(1).parse(process.env.GITHUB_OUTPUT),
      Object.entries(selection)
        .map(([key, value]) => `${key}=${value}\n`)
        .join(""),
    );
    process.stdout.write(`${JSON.stringify(selection)}\n`);
    return;
  }
