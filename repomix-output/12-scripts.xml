  execute: async () => {
    throw new Error(
      "The Cutter verification does not call unrelated analysis tools.",
    );
  },
};
const expectedPlatform = {
  Linux: "linux",
  macOS: "darwin",
  Windows: "win32",
}[process.env.EXPECTED_PLATFORM];
if (expectedPlatform !== undefined)
  assert.equal(
    process.platform,
    expectedPlatform,
    "Cutter runner did not match its declared platform.",
