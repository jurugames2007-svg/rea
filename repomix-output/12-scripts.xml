  if (stage === undefined || check === undefined)
    throw new TypeError(`Missing readiness check ${stageId}/${checkId}`);
  stage.evidence_ids = [
    ...new Set([...stage.evidence_ids, evidence.evidence_id]),
  ].sort();
  check.evidence_ids = [evidence.evidence_id];
}
