  assert.equal(source.selected_count, selected.length);
  assert.equal(source.xrefs, false);
  assert.match(source.sha256, /^[0-9a-f]{64}$/u);
  assert.ok(source.bytes > 0);
  assert.equal(cold.structured.provider.id, "kuna");
