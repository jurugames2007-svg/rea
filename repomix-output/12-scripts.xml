      if (
        /^(README(?:_[^/]+)?\.md|AGENTS\.md|CONTRIBUTING\.md|CHANGELOG\.md|SECURITY\.md|native\/windows\/README\.md|\.github\/pull_request_template\.md)$/.test(
          file,
        ) ||
        file.startsWith("docs/") ||
        file.startsWith(".github/ISSUE_TEMPLATE/")
