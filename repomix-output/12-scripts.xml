    client,
    options,
    normalizedResult,
    tool: "search_procedures",
    pattern: symbolPrefix.replace(/^_+/u, ""),
    expectedPrefix: symbolPrefix.replace(/^_+/u, ""),
    expectedCount,
    normalize: (value) => value.replace(/^_+/u, ""),
