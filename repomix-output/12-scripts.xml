        : join(root, name);
    if (name !== "node-target.mjs")
      await writeFile(targetPath, "setInterval(() => {}, 1000);\n");
    const child = spawn(
      process.execPath,
      ["--inspect=127.0.0.1:0", targetPath],
      {
        stdio: ["ignore", "ignore", "pipe"],
