    schemaVersion: 1,
    repository: values.repository,
    version: values.version,
    base: history.base,
    target: history.target,
  });
  const credits = await collectGitHubCredits(
    run,
    values.repository,
    history.commits,
  );
  const inventory = releaseInventorySchema.parse({
    schemaVersion: 1,
    repository: values.repository,
    version: values.version,
    base: history.base,
    target: history.target,
    ...credits,
