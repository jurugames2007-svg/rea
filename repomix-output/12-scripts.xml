  unsigned.parameters = [
    { data_type: "undefined4", size_bytes: 4, confidence: "low" },
  ];
  for (const mapping of unsigned.jump_tables[0].mappings) {
    const previous = mapping.case_value;
    mapping.case_value = Number(BigInt.asUintN(32, BigInt(previous)));
