const MAXIMUM_PROFILE_BUFFER_BYTES = 2 * 1_024 * 1_024;
const MAXIMUM_PROFILE_MODULES = 10_000;
export async function measureMcpStartup({
  command,
  args,
  environment,
  policy,
}) {
