  const signed = guardBoundary(negative);
  assertSwitchBoundary(signed, negative);
  signed.jump_tables[0].mappings = signed.jump_tables[0].mappings.map(
    (mapping) => ({ ...mapping, case_value: Math.abs(mapping.case_value) }),
  );
