export async function openAndVerifyLargeFixture({
  client,
  options,
  normalizedResult,
  path,
  expectedCount,
  symbolPrefix,
  stringPrefix,
}) {
  const opened = await client.callTool(
    { name: "open_binary", arguments: { path } },
    options,
