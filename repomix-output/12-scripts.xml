    url: stringOrNull(job.html_url),
    name: job.name,
    workflowName: stringOrNull(job.workflow_name),
    status: job.status,
    conclusion: stringOrNull(job.conclusion),
    createdAt: stringOrNull(job.created_at),
    startedAt: stringOrNull(job.started_at),
