    call,
    address(0x1000),
    address(0x1010),
  );
  const indirectAddress = address(x86 ? 0x1041 : 0x1049);
  const indirect = await call("inspect_native_instruction", {
    address: indirectAddress,
  });
  const unresolved = await call("resolve_native_call_targets", {
    address: indirectAddress,
