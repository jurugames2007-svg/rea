msgid ""
"{ph0}02 · Caller{ph1}{ph2}A screen coordinate{ph3}{ph4}The brick-hit caller "
"passes {ph5}.{ph6}"
msgstr ""
"{ph0}02 * Người Gọi{ph1}{ph2}Tọa độ màn hình{ph3}{ph4}Người gọi gạch-hit đi "
"{ph5}.{ph6}"

