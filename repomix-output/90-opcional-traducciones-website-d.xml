msgstr "{ph0}02{ph1} Chọn"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/showcase/ctf/index.html:468
#, python-brace-format
msgctxt "page:showcase/ctf/index.html"
msgid "{ph0}03{ph1} Add"
msgstr "{ph0}03{ph1} Thêm"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/showcase/ctf/index.html:476
#, python-brace-format
msgctxt "page:showcase/ctf/index.html"
msgid "{ph0}04{ph1} Advance"
msgstr "{ph0}04{ph1} Tiến lên"

