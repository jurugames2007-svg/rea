msgstr "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Örnek soru · Hesap Makinesi"

#: website/public/index.html:840
msgctxt "page:index.html"
msgid "2. Find both rules"
msgstr "2. İki kuralı bul"

#: website/public/index.html:841
msgctxt "page:index.html"
msgid ""
"REA helps the agent read the code behind the % button. It applies two "
"different rules:"
msgstr ""
"REA, ajanın % düğmesinin kodunu okumasına yardımcı olur. Kod iki farklı "
"kural uygular:"

