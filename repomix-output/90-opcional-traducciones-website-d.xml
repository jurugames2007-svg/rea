msgid ""
"{ph0}01 · Instructions{ph1}{ph2}An integer input{ph3}{ph4}A stack read "
"supplies the value used by the floating-point instructions.{ph5}"
msgstr ""
"{ph0}01 * Hướng dẫn{ph1}{ph2}Một đầu vào số nguyên{ph3}{ph4}Một stack read "
"cung cấp giá trị được sử dụng bởi các hướng dẫn dấu phẩy động.{ph5}"

