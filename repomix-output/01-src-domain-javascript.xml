        observation.evidence.state === "observed" &&
        observation.evidence.extractor.operation === "recover-module-export";
      const existing = candidates.get(key);
      candidates.set(key, {
        node,
        modulePath,
        exportName,
        trusted: trusted || existing?.trusted === true,
      });
