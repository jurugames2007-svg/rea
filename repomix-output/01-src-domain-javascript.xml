    schema: "JavaScriptApplicationGraph",
    root_node_ids: bounded.rootNodeIds,
    nodes: bounded.nodes,
    edges: bounded.edges,
    coverage: graphCoverage(input, facts, bounded.nodes.length),
    limitations: uniqueSorted([
