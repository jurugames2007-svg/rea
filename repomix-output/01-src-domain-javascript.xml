  node.observations
    .map(({ label, properties: values, source_map_reference }) => ({
      label,
      properties: values,
      source_map_reference,
    }))
    .sort((left, right) =>
      compareUnicodeCodePoints(canonicalJson(left), canonicalJson(right)),
