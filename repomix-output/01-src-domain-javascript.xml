            ...property,
            ...(replacedSlots.has(index)
              ? { presence: "unknown-coverage" as const }
              : {}),
            value: invalidateSemanticMutationPaths(property.value, selected),
          };
    },
  );
  for (const name of added)
    properties.push({
      name,
      value: {
