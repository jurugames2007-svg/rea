  mapping_id: prefixedDigestSchema("stbc_item"),
  source_path: textSchema,
  source_sha256: digestSchema.nullable(),
  source_language: textSchema.nullable(),
  status: z.enum([
    "unchanged",
    "modified",
    "removed",
    "split",
    "merged",
    "duplicated",
    "unknown",
  ]),
  confidence: z.enum(["exact", "high", "medium", "unknown"]),
