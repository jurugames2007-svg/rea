    events: ir.eventOperations.map(({ eventName }) => eventName),
  };
};
const calls = (value: string) =>
  [
    `spawn(${value});`,
    `fetch(${value});`,
    `new EventEmitter().on(${value}, () => 1);`,
  ].join("\n");
it("keeps recovered templates without a cooked value dynamic", () => {
  expect(effects(calls, "`\\unicode`")).toEqual({
    commands: [null],
    endpoints: [null],
