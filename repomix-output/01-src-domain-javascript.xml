    options_status:
      resolvedOptions === undefined
        ? "missing"
        : t.isObjectExpression(resolvedOptions)
          ? "object-literal"
          : "dynamic",
    web_preferences_status: collected.status,
    web_preferences: collected.preferences,
    ...(resolutionSources.length > 0
      ? { resolution_sources: resolutionSources }
      : {}),
    ...collected.preload,
