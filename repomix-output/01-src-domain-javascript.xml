      const callable = callableById.get(callableId);
      if (callable === undefined) continue;
      for (const parameter of cachedParameterBindings(
        callable,
        index,
        context,
      )) {
        const definition = parameter.definitions.find(
          ({ kind }) => kind === "parameter",
