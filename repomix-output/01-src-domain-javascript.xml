  input: unknown,
): string =>
  digestCanonicalValue(
    parseJavaScriptApplicationGraph(input),
    "JavaScript Application Graph",
  );
export const serializeJavaScriptApplicationGraph = (input: unknown): string =>
  canonicalJson(
    parseJavaScriptApplicationGraph(input),
    "JavaScript Application Graph",
  );
