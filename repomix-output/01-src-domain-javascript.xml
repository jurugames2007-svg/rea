const senderSubject = (
  node: t.Node,
): ElectronSenderValidationFinding["subject"] | undefined => {
  const name =
    t.isCallExpression(node) || t.isOptionalCallExpression(node)
      ? calleeName(node.callee)
      : calleeName(node);
