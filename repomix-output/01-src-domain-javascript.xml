  .strictObject({
    comparison_id: prefixedDigestSchema("javc"),
    left: z.strictObject({
      evidence_id: evidenceIdSchema,
      graph_id: prefixedDigestSchema("jag"),
      root_artifact_sha256: z.string().regex(/^[a-f0-9]{64}$/u),
