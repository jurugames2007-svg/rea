  value: Extract<
    JavaScriptSemanticValue,
    { readonly status: "object" | "array" }
  >,
): JavaScriptSemanticContainer;
export function semanticContainer(
  value: JavaScriptSemanticValue,
): JavaScriptSemanticContainer | null;
export function semanticContainer(
  value: JavaScriptSemanticValue,
): JavaScriptSemanticContainer | null {
