  artifact: {
    available: false,
    reason: "not-applicable",
    detail: "The relationship is runtime metadata, not standalone bytes.",
  },
  location: {
    available: true,
    value: {
      kind: "runtime",
      capture_sha256: capture.captureSha256,
      target_key: capture.inspection.target.target_id,
      frame_key: entity.frameKey,
