  const requireName = t.isIdentifier(parameter) ? parameter.name : null;
  const requireBindingId = t.isIdentifier(parameter)
    ? (resolveSemanticBindingState(bindings, parameter, parameter.name)
        ?.bindingId ?? null)
    : null;
