          limits: [
            ...(facts.inputStatus === "truncated"
              ? [
                  {
                    name: "runtime-reconciliation-input-coverage",
                    value: input.layers.length + input.captures.length,
                    unit: "items" as const,
                  },
                ]
              : []),
            ...(facts.outputTruncated
              ? [
                  {
                    name: "runtime-reconciliation-output-limits",
                    value: nodeCount,
                    unit: "items" as const,
                  },
                ]
              : []),
