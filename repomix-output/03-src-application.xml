  evidence: Evidence,
  path: readonly (string | number)[],
): ApplicationGraphEvidenceSource => {
  const result = parseCallerValue(
    (input) => javascriptApplicationAnalysisResultSchema.parse(input),
    evidence.normalized_result,
    [...path, "normalized_result"],
