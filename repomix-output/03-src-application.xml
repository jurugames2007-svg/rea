    return err(
      new AnalysisProtocolError(
        "JavaScript runtime reconciliation input parsing failed",
        { cause },
      ),
    );
  }
  try {
    const result = reconcileJavaScriptRuntime(parsed);
    return ok(
      createJavaScriptRuntimeReconciliationEvidence(parsed.input, result),
