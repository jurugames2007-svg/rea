  const reasons: string[] = [];
  const temporary = await temporaryOwner.retry(host.cleanup);
  if (temporary !== undefined) reasons.push(temporary);
  try {
    await host.close?.();
  } catch (cause: unknown) {
    reasons.push(
      `Linux Hopper publisher cleanup failed: ${errorMessage(cause)}`,
    );
  }
