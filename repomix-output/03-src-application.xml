const unknownInput = (question: string) =>
  recordUnknownInputSchema.parse({
    question,
    severity: "medium",
    domain: "investigation",
    required_authority: "analyst-inference",
    required_confidence: "derived",
    required_environment: null,
    recommended_probes: [],
