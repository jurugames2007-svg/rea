  withRegularFile(
    path,
    async (handle, stats) => {
      let previousDigest: string | undefined;
      try {
        const native = await readNativeJson(
          handle,
          stats.size,
          path,
          operation,
          signal,
        );
        if (native !== undefined) {
          if (!native.ok) return native;
          const value = native.value;
          if (
            typeof value !== "object" ||
            value === null ||
            Array.isArray(value)
