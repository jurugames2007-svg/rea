  readonly relations: Map<string, JavaScriptSemanticGraphRelation>;
  readonly unknowns: Map<string, JavaScriptSemanticGraphUnknown>;
  readonly evidenceContexts: JavaScriptSemanticEvidenceContextRegistry;
