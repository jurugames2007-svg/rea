  }
  protected abstract activeAnalysisBinding(): ActiveAnalysisBinding | undefined;
  exportAnalysisSnapshot(): Result<AnalysisSnapshot, AnalysisError> {
    const active = this.activeAnalysisBinding();
    if (this.#snapshotInvalidated)
