import type { ExecutionOptions } from "../AnalysisProvider.js";
import type { AndroidAnalysisService } from "./AndroidAnalysisService.js";
import {
  requireAnalysisViewRetention,
  summarizeRetainedAnalysis,
  type AnalysisViewRetention,
} from "../analysisView/AnalysisViewService.js";
import type { AnalysisError } from "../../domain/analysisErrorBase.js";
import { AnalysisCancelledError } from "../../domain/analysisErrorCore.js";
import { androidPackageInspectionInputSchema } from "../../domain/android/androidAnalysis.js";
import type { Evidence } from "../../domain/evidence.js";
import { analysisInputErrorFromIssues } from "../../domain/inputIssueProjection.js";
import { err, type Result } from "../../domain/result.js";
export const inspectAndroidPackage = async (
  service: AndroidAnalysisService,
  rawInput: unknown,
  retention: AnalysisViewRetention,
  options?: ExecutionOptions,
): Promise<Result<Evidence, AnalysisError>> => {
  const operation = "inspect_android_package";
  if (options?.signal?.aborted === true)
    return err(new AnalysisCancelledError(operation));
  const parsed = androidPackageInspectionInputSchema.safeParse(rawInput);
  if (!parsed.success)
    return err(
      analysisInputErrorFromIssues(operation, parsed.error.issues, rawInput, {
        cause: parsed.error,
      }),
    );
  if (parsed.data.detail === "summary") {
    const ready = requireAnalysisViewRetention(operation, retention);
    if (!ready.ok) return ready;
  }
  const executed = await service.execute(
    operation,
    { path: parsed.data.path },
    options,
  );
  if (!executed.ok || parsed.data.detail !== "summary") return executed;
  return summarizeRetainedAnalysis(executed.value, retention);
};
</file>

<file path="src/application/android/AndroidSearchEvidenceSummary.ts">
import type { EvidenceWriter } from "../investigation/InvestigationRecordPort.js";
import { createEvidence, type Evidence } from "../../domain/evidence.js";
import type { AnalysisError } from "../../domain/analysisErrorBase.js";
import type { JsonValue } from "../../domain/jsonValue.js";
import { ok, type Result } from "../../domain/result.js";
const elideInventoryText = (text: string): string | undefined => {
  let page: JsonValue;
  try {
    page = JSON.parse(text) as JsonValue;
  } catch {
    return undefined;
  }
  if (
    typeof page !== "object" ||
    page === null ||
    Array.isArray(page) ||
    !Array.isArray(page.items)
  )
    return undefined;
  const { items, ...audited } = page;
  return JSON.stringify({ ...audited, items_omitted: items.length });
};
const summarizeInventoryCall = (call: JsonValue): JsonValue => {
  if (
    typeof call !== "object" ||
    call === null ||
    Array.isArray(call) ||
    call.operation !== "list_classes"
  )
    return call;
  const response = call.response;
  if (
    typeof response !== "object" ||
    response === null ||
    Array.isArray(response) ||
    !Array.isArray(response.content)
  )
    return call;
  let elided = false;
  const content = response.content.map((entry: JsonValue) => {
    if (
      typeof entry !== "object" ||
      entry === null ||
      Array.isArray(entry) ||
      typeof entry.text !== "string"
    )
      return entry;
    const summarized = elideInventoryText(entry.text);
    if (summarized === undefined) return entry;
    elided = true;
    return { ...entry, text: summarized };
  });
  return elided
    ? { ...call, inventory_elided: true, response: { ...response, content } }
    : call;
};
export const summarizeRetainedAndroidSearch = (
  evidence: Evidence,
  recordEvidence: EvidenceWriter["recordEvidence"] | undefined,
): Result<Evidence, AnalysisError> => {
  if (recordEvidence === undefined) return ok(evidence);
  const recorded = recordEvidence(evidence);
  if (!recorded.ok) return recorded;
  const subject = evidence.subject;
  const raw = evidence.raw_result;
  const summarized: JsonValue =
    raw === null ||
    typeof raw !== "object" ||
    Array.isArray(raw) ||
    !Array.isArray(raw.calls)
      ? raw
      : {
          ...raw,
          complete_evidence_id: evidence.evidence_id,
          calls: raw.calls.map(summarizeInventoryCall),
        };
  return ok(
    createEvidence(
      subject === null
        ? undefined
        : {
            path: subject.local_path,
            sha256: subject.digest.sha256,
            format: subject.format,
            ...(subject.architecture === null
              ? {}
              : { architecture: subject.architecture }),
          },
      evidence.provider,
      {
        operation: evidence.operation,
        parameters: evidence.parameters,
        result: evidence.normalized_result,
        rawResult: summarized,
        confidence: evidence.confidence,
        limitations: evidence.limitations,
        locations: evidence.locations,
        evidenceLinks: [evidence.evidence_id],
      },
    ),
  );
};
</file>

