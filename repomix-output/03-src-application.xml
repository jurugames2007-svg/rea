  inputBytes <= NATIVE_PARSE_READ_BUDGET &&
  inputBytes * 72 + READ_CHUNK_BYTES <=
    getHeapStatistics().total_available_size;
export interface JsonObjectMemberReader {
  readonly mode: "value" | "array";
