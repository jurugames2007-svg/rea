      response.end(
        JSON.stringify([
          {
            id: "connectable",
            type: "node",
            url: "https://example.test/entry.js",
            webSocketDebuggerUrl: `ws://127.0.0.1:${String(address.port)}/connectable`,
          },
          {
            id: "anonymous",
            type: "node",
            url: "https://example.test/eval.js",
          },
        ]),
      );
      return;
    }
    response.writeHead(404).end();
  });
