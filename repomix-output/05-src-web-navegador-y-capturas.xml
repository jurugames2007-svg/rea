      "Runtime.executionContextCreated",
      "Runtime.executionContextDestroyed",
      "Runtime.executionContextsCleared",
      "Debugger.scriptParsed",
      "Debugger.paused",
      "Target.attachedToTarget",
      "Target.detachedFromTarget",
      "Target.receivedMessageFromTarget",
