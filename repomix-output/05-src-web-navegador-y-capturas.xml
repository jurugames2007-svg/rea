      return protocolFailure(
        `packet ${String(index + 1)} lacks _source.layers`,
      );
    const layers = packet._source.layers;
    for (const [key, value] of Object.entries(layers))
      if (
        !Array.isArray(value) ||
        !value.every((item) => typeof item === "string")
