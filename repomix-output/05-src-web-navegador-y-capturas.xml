      await runWithExecutionLimits(
        assertNodeCliInspectArgumentsSupported(paths.executable, {
          ...(options.signal === undefined ? {} : { signal: options.signal }),
          readFuseImage: this.readFuseImage,
        }),
        options.signal,
        startupDeadline,
      );
