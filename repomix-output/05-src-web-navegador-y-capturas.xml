  #remainingTotalResultBudget(): number {
    return Math.max(
      0,
      Math.min(
        this.#resultBudgetBytes - this.#estimatedRetainedBytes,
        getHeapStatistics().heap_size_limit -
          process.memoryUsage().heapUsed -
          24 * JAVASCRIPT_ANALYSIS_TRANSFER_RECORD_BYTES,
