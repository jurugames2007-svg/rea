      svgNodeKinds.set(`${String(id)}:${element.name}`, element.svg);
    nodeType.push(1);
    nodeName.push(intern(element.name));
    nodeValue.push(intern(""));
    parentIndex.push(element.parent);
    const encoded: number[] = [];
    for (const [name, value] of element.attributes ?? [])
