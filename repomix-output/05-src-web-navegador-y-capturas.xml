    this.#setup.abort();
    const restoration = (this.#restoration ??= this.restore(stopLoading));
    void restoration.then(
      () => {
        if (this.#restoration === restoration) this.#restoration = undefined;
      },
      () => {
        if (this.#restoration === restoration) this.#restoration = undefined;
      },
    );
