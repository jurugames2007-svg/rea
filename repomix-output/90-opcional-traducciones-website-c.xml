"{ph0}02 · Caller{ph1}{ph2}A screen coordinate{ph3}{ph4}The brick-hit caller "
"passes {ph5}.{ph6}"
msgstr ""
"{ph0}02 * dzwoniący{ph1}{ph2}Współrzędna ekranu{ph3}{ph4}The brick-hit "
"caller passes {ph5}.{ph6}"

#. {ph0}: <span class="flow-label">
