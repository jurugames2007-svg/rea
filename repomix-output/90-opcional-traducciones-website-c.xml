msgstr "{ph0}01{ph1} Blok czasu"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/showcase/aegis/index.html:498
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid "{ph0}02{ph1} Key + block"
msgstr "{ph0}02{ph1} Klucz + blok"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/showcase/aegis/index.html:506
