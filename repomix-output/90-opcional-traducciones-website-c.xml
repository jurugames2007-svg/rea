msgctxt "page:faq/index.html"
msgid "Copy agent setup refresh command"
msgstr "Команда обновления настройки агента копирования"

#: website/public/faq/index.html:372
msgctxt "page:faq/index.html"
msgid "Copy REA CLI analysis command"
msgstr "Скопировать команду анализа REA CLI"

#: website/public/faq/index.html:419
msgctxt "page:faq/index.html"
msgid "Copy example analysis prompt"
msgstr "Запрос на копирование примера анализа"

#: website/public/faq/index.html:459
