.navigation {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 0.9rem;
  flex-wrap: wrap;
  gap: 0.65rem 1.4rem;
}
.navigation a {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
}
.navigation a:hover,
.navigation a[aria-current="page"],
.navigation a[aria-current="true"] {
  color: var(--ink);
}
.navigation a[aria-current="page"],
.navigation a[aria-current="true"] {
  text-decoration: underline;
}
.navigation .nav-start {
  color: var(--ink);
}
.header-social {
  display: flex;
  align-items: center;
  gap: 8px;
}
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 5px;
  background: var(--page);
  color: var(--muted);
}
.theme-toggle:hover {
  background: var(--soft);
  color: var(--ink);
}
.theme-toggle[hidden],
.theme-toggle .theme-sun,
:root[data-theme="dark"] .theme-toggle .theme-moon {
  display: none;
}
:root[data-theme="dark"] .theme-toggle .theme-sun {
  display: block;
}
.nav-github,
.nav-discord,
.nav-x {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 44px;
  padding-inline: 10px;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--muted);
  text-decoration: none;
}
.nav-github:hover,
.nav-discord:hover,
.nav-x:hover {
  background: var(--soft);
  color: var(--ink);
}
.nav-github svg,
.nav-discord svg,
.nav-x svg {
  display: block;
  flex-shrink: 0;
}
.nav-github-count {
  font-size: 0.875rem;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.faq-list {
  border-top: 1px solid var(--line);
}
.faq-item {
  padding-block: 1rem;
  border-bottom: 1px solid var(--line);
  scroll-margin-top: 2rem;
}
.faq-item summary {
  cursor: pointer;
  color: var(--ink);
  font-weight: 600;
  line-height: 1.55;
}
.faq-item[open] summary {
  margin-bottom: 0.9rem;
}
.faq-item > :last-child {
  margin-bottom: 0;
}
.eyebrow {
  margin-bottom: 1.2rem;
  font-size: 0.9rem;
  color: var(--muted);
}
.hero {
  padding-block: 5.8rem 4.6rem;
}
.hero h1 {
  max-width: 900px;
}
.hero .lede {
  max-width: 710px;
}
.lede {
  font-size: 1.2rem;
  color: var(--muted);
  line-height: 1.7;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.6rem;
  margin-top: 2rem;
}
.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  padding: 0.7rem 1.25rem;
  border: 1px solid var(--ink);
  border-radius: 5px;
  background: var(--ink);
  color: white;
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
}
.button:hover {
  background: #38424e;
  text-decoration: none;
}
.button.secondary {
  border-color: var(--line);
  background: var(--page);
  color: var(--ink);
}
.button.secondary:hover {
  background: var(--soft);
}
.text-link {
  font-size: 0.95rem;
  font-weight: 500;
}
.hero-command {
  max-width: 680px;
  margin-top: 2.25rem;
}
.home-hero {
  padding-block: 4rem 3.5rem;
}
.home-calculation {
  margin: 0;
}
.home-code-comparison pre {
  font-size: 0.85rem;
  line-height: 1.9;
}
.code-key {
  color: var(--accent);
  background: #e4ecf5;
  border-radius: 2px;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}
.pan-examples {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2.5rem;
  margin-top: 1.8rem;
  padding: 1.4rem 1.6rem;
  border: 1px solid var(--line);
  border-radius: 5px;
}
.pan-example {
  min-width: 0;
  text-align: center;
}
.pan-label,
.pan-value,
.pan-meaning {
  display: block;
}
.pan-label {
  color: var(--ink);
  font-size: 0.9rem;
  font-weight: 600;
}
.pan-position {
  position: relative;
  height: 2rem;
  margin-block: 0.6rem;
}
.pan-position::before {
  content: "";
  position: absolute;
  top: calc(50% - 1px);
  left: 0;
  right: 0;
  height: 2px;
  background: var(--line);
}
.pan-position i {
  position: absolute;
  top: calc(50% - 5px);
  left: calc(5px + (100% - 10px) * var(--position));
  width: 10px;
  height: 10px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--accent);
}
.pan-value {
  font-size: 0.9rem;
}
.pan-meaning {
  margin-top: 0.25rem;
  color: var(--muted);
  font-size: 0.8rem;
}
.home-calculation figcaption {
  margin-top: 0.8rem;
  color: var(--muted);
  font-size: 0.8rem;
}
.home-analysis-work {
  max-width: 760px;
  margin: 1.5rem 0 0;
  color: var(--muted);
}
.home-agent-grid,
.home-try-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr);
  gap: 3.5rem;
  align-items: start;
}
.home-reassurance h2 {
  font-size: clamp(1.75rem, 3vw, 2.2rem);
}
.home-no {
  margin: 1.2rem 0;
  font-size: clamp(4.5rem, 8vw, 6.5rem);
  font-weight: 650;
  letter-spacing: -0.06em;
  line-height: 1;
}
.home-reassurance > :last-child,
.home-try-grid p {
  color: var(--muted);
}
.agent-terminal.home-analysis-terminal {
  margin-block: 1rem;
}
.terminal-target {
  margin: 1rem 1.4rem 0;
  color: #bdc8d4;
  font-size: 0.75rem;
}
.agent-reply {
  padding: 1.4rem;
  background: var(--page);
  color: var(--ink);
}
.agent-reply .reply-label {
  color: var(--accent);
  font-size: 0.75rem;
  font-weight: 600;
}
.agent-reply > :last-child {
  margin-bottom: 0;
}
.home-evidence {
  margin-block: 2rem 1.2rem;
}
.home-check {
  max-width: 800px;
  margin: 0;
  color: var(--muted);
  font-size: 0.875rem;
}
.home-try-grid {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
}
.home-setup .agent-terminal {
  margin-block: 1rem;
}
.home-setup .code-inline {
  margin-block: 1rem;
}
.home-setup > .caption {
  margin-bottom: 0;
}
.code-block {
  margin-block: 1.3rem;
  border: 1px solid var(--line);
  border-radius: 5px;
  overflow: hidden;
  background: var(--soft);
}
.code-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  overflow-wrap: anywhere;
  padding: 0.6rem 1rem;
  border-bottom: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.9rem;
}
.copy-button {
  padding: 0.15rem 0.45rem;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-radius: 3px;
  font-size: 0.9rem;
}
.copy-button:hover {
  background: #e5e9ee;
  color: var(--ink);
}
pre {
  margin: 0;
  padding: 1.15rem;
  overflow-x: auto;
  font-size: 0.875rem;
  line-height: 1.75;
}
pre code {
  font-size: inherit;
  overflow-wrap: normal;
}
.code-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.95rem 1.1rem;
}
.code-inline code {
  min-width: 0;
  font-size: 0.875rem;
}
.code-inline .copy-button {
  flex-shrink: 0;
  white-space: nowrap;
}
.section {
  padding-block: 3.8rem;
  border-top: 1px solid var(--line);
}
.section-heading {
  max-width: 650px;
  margin-bottom: 2rem;
}
.section-heading p {
  color: var(--muted);
}
.feature-case {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 4.5rem;
  align-items: start;
}
.feature-case p {
  max-width: 630px;
  color: var(--muted);
}
.case-note {
  font-size: 0.875rem;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}
.stats dt {
  font-size: 2rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.04em;
}
.stats dd {
  margin: 0.5rem 0 0;
  color: var(--muted);
  font-size: 0.875rem;
  line-height: 1.5;
}
.case-stats {
  grid-template-columns: 1fr;
  margin: 0;
  padding-left: 2rem;
  border-left: 1px solid var(--line);
}
.case-stats > div + div {
  border-top: 1px solid var(--line);
  padding-top: 1.1rem;
}
.case-stats dt {
  font-size: 1.7rem;
}
.workflows {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2.8rem;
}
.workflows p {
  margin-bottom: 0.8rem;
  color: var(--muted);
}
.workflows a {
  font-size: 0.9rem;
}
.start-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
}
.start-row h2 {
  margin-bottom: 0.65rem;
}
.start-row p {
  margin: 0;
  color: var(--muted);
}
.site-footer {
  margin-top: 1.5rem;
  padding-block: 2rem;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 0.875rem;
}
.footer-inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 1rem 2rem;
}
.footer-inner p {
  margin: 0;
}
.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}
.footer-links a {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  color: var(--muted);
}
.page-heading {
  padding-block: 4.3rem 2.7rem;
}
.page-heading h1 {
  max-width: 850px;
  font-size: clamp(2.6rem, 5.5vw, 4.25rem);
}
.page-heading .lede {
  max-width: 730px;
}
.page-heading .evidence-details {
  max-width: 730px;
}
.breadcrumb {
  margin-bottom: 2rem;
  color: var(--muted);
  font-size: 0.875rem;
}
.breadcrumb a {
  color: var(--muted);
}
.page-meta {
  color: var(--muted);
  font-size: 0.875rem;
}
.contributors-section {
  padding-block: 0 4rem;
}
.contributors-toolbar {
  display: flex;
  align-items: end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem 2rem;
  margin-bottom: 1rem;
}
.contributors-toolbar h2 {
  margin: 0;
}
.contributors-search {
  display: grid;
  gap: 0.35rem;
  width: min(100%, 19rem);
  font-size: 0.85rem;
  color: var(--muted);
}
.contributors-search input {
  min-width: 0;
  width: 100%;
  min-height: 44px;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: 5px;
  background: var(--page);
  color: var(--ink);
}
.contributors-search input::placeholder {
  color: var(--muted);
}
.contributors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(8.5rem, 100%), 1fr));
  gap: 0.75rem;
  padding: 0;
  margin: 0;
  list-style: none;
}
.contributors-grid li {
  margin: 0;
  min-width: 0;
}
.contributor-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: start;
  gap: 0.7rem;
  height: 100%;
  padding: 1.25rem 0.65rem;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--ink);
  text-decoration: none;
  text-align: center;
  font-size: 0.8rem;
  line-height: 1.4;
}
.contributor-card:hover {
  background: var(--soft);
  border-color: var(--accent);
}
.contributor-card img {
  border-radius: 50%;
  background: var(--soft);
  object-fit: cover;
}
.contributor-card span {
  max-width: 100%;
  overflow-wrap: anywhere;
}
.contributors-source {
  margin-block: 1.5rem 0;
}
.article-layout {
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr);
  gap: 4rem;
  padding-bottom: 3.5rem;
}
.contents {
  align-self: start;
  position: sticky;
  top: 2rem;
  padding-top: 2.4rem;
  font-size: 0.875rem;
}
.contents p {
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 0.8rem;
}
.contents ul {
  margin: 0;
  padding: 0;
  list-style: none;
}
.contents li + li {
  margin-top: 0.75rem;
}
.contents a {
  color: var(--muted);
  text-decoration: none;
}
.contents a:hover {
  color: var(--ink);
  text-decoration: underline;
}
.article {
  max-width: 760px;
  min-width: 0;
}
.article-section {
  padding-block: 2.4rem;
  border-top: 1px solid var(--line);
}
.article-section h2 {
  font-size: 1.8rem;
}
.article p,
.article li {
  color: #414b55;
}
.article .stats {
  margin: 0 0 1.6rem;
}
.article .stats dt {
  color: var(--ink);
}
.article .stats dd {
  color: var(--muted);
}
.blog-takeaway {
  max-width: 730px;
  margin-top: 1.8rem;
  padding-left: 1.25rem;
  border-left: 2px solid var(--accent);
}
.blog-takeaway .eyebrow {
  color: var(--accent);
}
.blog-takeaway p:last-child {
  margin-bottom: 0;
}
.blog-takeaway ul {
  margin: 0;
  padding-left: 1.15rem;
}
.blog-takeaway li + li {
  margin-top: 0.75rem;
}
.reconstruction-flywheel {
  max-width: 880px;
  margin: 0 auto 4rem;
  padding-block: 1.5rem 1.75rem;
  border-block: 1px solid var(--line);
}
.flywheel-heading {
  text-align: center;
}
.flywheel-heading .eyebrow {
  margin-bottom: 0.6rem;
  color: var(--accent);
}
.flywheel-heading > p:last-child {
  color: var(--muted);
  font-size: 0.875rem;
}
.flywheel-diagram {
  position: relative;
  max-width: 760px;
  height: 440px;
  margin-inline: auto;
}
.flywheel-arrows {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.flywheel-path-mobile {
  display: none;
}
.flywheel-node {
  position: absolute;
  width: 30%;
  text-align: center;
  transform: translate(-50%, -50%);
}
.flywheel-node p {
  margin: 0.6rem 0 0;
  color: var(--muted);
  font-size: 0.875rem;
  line-height: 1.5;
}
.flywheel-node .flywheel-kicker {
  margin: 0 0 0.4rem;
  color: var(--accent);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}
.flywheel-node h3 {
  margin: 0;
  font-size: 1.5rem;
  line-height: 1.2;
}
.flywheel-agent {
  top: 15%;
  left: 50%;
  width: 38%;
}
.flywheel-oracle {
  top: 58%;
  left: 79%;
}
.flywheel-memory {
  top: 58%;
  left: 21%;
}
.flywheel-retry,
.flywheel-center,
.flywheel-reuse,
.flywheel-pass {
  position: absolute;
  margin: 0;
  padding: 0.25rem;
  background: var(--page);
  color: var(--muted);
  font-size: 0.75rem;
  line-height: 1.5;
  text-align: center;
  transform: translate(-50%, -50%);
}
.flywheel-retry {
  top: 36%;
  left: 68%;
  width: 23%;
}
.flywheel-center {
  top: 57%;
  left: 50%;
  width: 20%;
  color: var(--accent);
  font-size: 0.9375rem;
}
.flywheel-reuse {
  top: 33%;
  left: 23%;
  color: var(--accent);
}
.flywheel-pass {
  top: 94%;
  left: 50%;
  width: 75%;
  color: var(--accent);
  font-size: 0.8125rem;
}
.flywheel-projects {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1.4rem;
  margin-top: 0.3rem;
}
.flywheel-projects a {
  font-size: 0.9375rem;
  font-weight: 600;
}
.flywheel-projects span {
  color: var(--muted);
}
.reconstruction-flywheel figcaption {
  margin: 1rem auto 0;
  max-width: 600px;
  color: var(--muted);
  font-size: 0.875rem;
  text-align: center;
}
@media (max-width: 640px) {
  .reconstruction-flywheel {
    margin-bottom: 2.75rem;
  }
  .flywheel-diagram {
    height: 405px;
  }
  .flywheel-agent {
    width: 52%;
  }
  .flywheel-path-desktop {
    display: none;
  }
  .flywheel-path-mobile {
    display: initial;
  }
  .flywheel-node h3 {
    font-size: 1.125rem;
  }
  .flywheel-node p {
    font-size: 0.75rem;
  }
  .flywheel-node .flywheel-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  .flywheel-center {
    font-size: 0.75rem;
  }
  .flywheel-retry {
    font-size: 0.75rem;
  }
  .flywheel-projects {
    gap: 1rem;
  }
}
.blog-article blockquote {
  margin: 1.6rem 0;
  padding-left: 1.25rem;
  border-left: 2px solid var(--line);
  font-size: 1.05rem;
}
.blog-article blockquote p {
  color: var(--ink);
}
.caption {
  font-size: 0.875rem;
  color: var(--muted);
}
.explanatory-figure {
  margin: 0;
}
.figure-viewport {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 5px;
}
.explanatory-figure img {
  display: block;
  width: 100%;
  min-width: 880px;
  height: auto;
}
.explanatory-figure figcaption {
  max-width: 800px;
  margin-top: 1rem;
  color: var(--muted);
  font-size: 0.875rem;
}
.explanatory-figure figcaption a {
  white-space: nowrap;
}
.case-figure {
  margin-bottom: 3.2rem;
}
.aegis-step-selector {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.aegis-step-selector button {
  min-height: 44px;
}
.aegis-calculation .flow-node {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  min-height: 3.5rem;
  font-variant-numeric: tabular-nums;
}
.aegis-calculation .aegis-code {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 1.5rem;
  letter-spacing: 0.06em;
}
.aegis-clock-controls {
  margin-top: 1.7rem;
}
.aegis-clock-controls label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
}
.aegis-clock-controls input {
  display: block;
  width: 100%;
  min-height: 44px;
  margin: 0;
  accent-color: var(--accent);
}
.aegis-clock-scale {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 0.75rem;
  font-variant-numeric: tabular-nums;
}
.aegis-clock-controls .actions {
  gap: 0.7rem;
  margin-top: 1.2rem;
}
.aegis-clock-controls .caption {
  margin-bottom: 0;
}
.aegis-demo .button:disabled,
[data-aegis-check]:disabled {
  opacity: 0.6;
  cursor: default;
}
.step-selector {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0.5rem;
  margin-block: 1.5rem 0.9rem;
}
.step-selector button {
  padding: 0.55rem 0.3rem;
  border: 1px solid var(--line);
  border-radius: 4px;
  background: var(--page);
  color: var(--muted);
  font-size: 0.85rem;
}
.step-selector button span {
  font-size: 0.75rem;
  margin-right: 0.3rem;
  font-variant-numeric: tabular-nums;
}
.step-selector button[aria-pressed="true"] {
  border-color: var(--accent);
  background: #edf2f8;
  color: var(--accent);
}
.code-comparison {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.9rem;
}
.code-comparison .code-block {
  margin: 0;
  min-width: 0;
}
.code-comparison .code-header {
