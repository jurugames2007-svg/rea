#, python-brace-format
msgctxt "page:get-started/index.html"
msgid "{ph0}Linux:{ph1} press {ph2} {ph3} {ph4} on most desktops."
msgstr ""
"{ph0}Linux:{ph1} در بیشتر محیط‌های دسکتاپ کلیدهای {ph2} {ph3} {ph4} را "
"بزنید."

#. {ph0}: <kbd>Ctrl</kbd>
