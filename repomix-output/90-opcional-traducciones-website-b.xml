#: website/public/get-started/index.html:229
msgctxt "page:get-started/index.html"
msgid "How do I open a terminal?"
msgstr "چگونه ترمینال را باز کنم ؟"

#. {ph0}: <strong>
#. {ph1}: </strong>
#. {ph2}: <em>
#. {ph3}: </em>
#: website/public/get-started/index.html:231
#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"{ph0}Windows:{ph1} open the Start menu, type {ph2}PowerShell{ph3} and press "
"Enter."
msgstr ""
"{ph0} Windows :{ph1} منوی Start را باز کنید ، تایپ کنید {ph2}PowerShell{ph3}"
" و Enter را فشار دهید."

#. {ph0}: <strong>
