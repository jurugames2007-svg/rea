msgctxt "page:get-started/index.html"
msgid "Websites, Android, .NET, firmware and other targets"
msgstr "Siti web, Android, .NET, firmware e altri obiettivi"

#: website/public/get-started/index.html:1366
msgctxt "page:get-started/index.html"
msgid ""
