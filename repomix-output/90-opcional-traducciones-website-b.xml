#, python-brace-format
msgctxt "page:get-started/index.html"
msgid ""
"{ph0}macOS:{ph1} press {ph2} {ph3}, type {ph4}Terminal{ph5} and press Enter."
msgstr ""
"{ph0}macOS:{ph1} کلیدهای {ph2} {ph3} را بزنید، {ph4}Terminal{ph5} را تایپ "
"کنید و Enter بزنید."

