msgctxt "page:index.html"
msgid ""
"“{ph0}0x5b? 0x5c?{ph1} Two jumps to the same place. Which operators are "
"these?”"
msgstr "“{ph0}0x5b? 0x5c?{ph1} 同じ場所に2つのジャンプ。 これらはどの演算子ですか？”"

#: website/public/index.html:440
msgctxt "page:index.html"
msgid "Look up the command IDs, then label the branch."
msgstr "コマンドIdを検索し、ブランチにラベルを付けます。"

#: website/public/index.html:446
msgctxt "page:index.html"
msgid "Divide ÷"
msgstr "ディバイド÷"

#: website/public/index.html:450
