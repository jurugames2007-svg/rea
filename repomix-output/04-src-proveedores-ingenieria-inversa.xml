  if (timeout !== undefined && !timeout.success)
    return failure(
      "open_options_invalid",
      `REA_KUNA_PROJECT_TIMEOUT_MS must be a decimal millisecond count from 1 to 2147483647; received ${String(rawTimeout)}.`,
      "REA_KUNA_PROJECT_TIMEOUT_MS",
