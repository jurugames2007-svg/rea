        waitForCall: (count = 1) =>
          waitForRequestCount(() => callCount, count, "tools/call"),
        waitForCatalog: (count = 1) =>
          waitForRequestCount(() => catalogCount, count, "tools/list"),
        close: async () => {
          for (const timer of pendingTimers) clearTimeout(timer);
