    ({ stdout } = await execFileOutput(executable, ["--version"], {
      env: kunaChildEnvironment(configuration.value),
      timeout: deadline,
      maxBuffer: VERSION_PROBE_MAX_OUTPUT_BYTES,
      stopSignal: "SIGTERM",
      ...(options.signal === undefined ? {} : { signal: options.signal }),
