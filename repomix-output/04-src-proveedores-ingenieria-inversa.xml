            queuedRequests: activity?.queuedRequests ?? 0,
          },
        ];
      },
      operationHealthSnapshot: () => client.operationHealth(),
      close: async (options) => {
        await regexSearch.close();
        return client.close(options);
      },
    };
  }
}
