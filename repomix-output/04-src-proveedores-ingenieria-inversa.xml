      kind: "failed",
      error: new AnalysisResourceConstraintError(
        operation,
        "memory",
        `kuna ${subcommand} wrote more than ${String(request.outputBytes)} bytes of output.`,
        { output_limit_bytes: request.outputBytes },
        {
