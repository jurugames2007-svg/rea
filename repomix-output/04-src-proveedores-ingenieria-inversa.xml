        diagnostics,
      };
    if (target.format === "raw-binary")
      return {
        status: "unsupported",
        code: "target_format_unsupported",
        reason:
          "Headerless raw-binary analysis requires the Ghidra adapter with a caller-supplied architecture and entry point.",
        diagnostics,
