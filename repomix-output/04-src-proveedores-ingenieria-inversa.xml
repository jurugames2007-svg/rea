  #close(): void {
    const frame = this.#frames.pop();
    switch (frame?.kind) {
      case "root":
        this.#closed = true;
        return;
      case "rows":
        this.#rowsSeen.add(frame.name);
        return;
      case "row":
        this.#rows += 1;
        this.#charge(ROW_OVERHEAD_BYTES, 0);
        this.acceptRow(frame.member, frame.values);
        return;
      case "empty": {
        const row = this.#frames.at(-1);
