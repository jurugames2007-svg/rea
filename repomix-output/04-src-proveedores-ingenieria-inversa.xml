    case "list_procedures":
    case "procedure_address":
    case "address_name":
      return [KUNA_PROVENANCE, KUNA_ENTRY_LIMITATION];
    case "search_procedures":
      return [
        KUNA_PROVENANCE,
        KUNA_ENTRY_LIMITATION,
        REGEX_MATCHING_LIMITATION,
