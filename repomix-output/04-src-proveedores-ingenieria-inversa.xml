<file path="src/kuna/KunaStringInventory.ts">
import { z } from "zod";
import type { AnalysisError } from "../domain/analysisErrorBase.js";
import type { analysisStringSchema } from "../domain/hopperValues.js";
import { err, ok, type Result } from "../domain/result.js";
import { compareKunaAddresses } from "./KunaAddress.js";
import { KunaJsonDocumentReader, parseKunaRow } from "./KunaJsonStream.js";
import { KUNA_STRING_MIN_LENGTH } from "./KunaLimits.js";
const count = z.number().int().min(0).max(Number.MAX_SAFE_INTEGER);
const address = z.string().regex(/^0x(?:0|[1-9a-f][0-9a-f]{0,15})$/u);
const header = z.object({
  binary: z.string(),
  encoding: z.literal("all"),
  min_length: z.literal(KUNA_STRING_MIN_LENGTH),
  filter: z.null(),
  section: z.null(),
  termination: z.literal("any"),
  scanned: z.enum(["sections", "segments"]),
  xrefs: z.literal(false),
  count,
});
const row = z.object({
  address,
  address_hex: address,
  text: z.string(),
  length: count,
  byte_length: count,
  nul_terminated: z.boolean(),
  encoding: z.enum(["ascii", "utf8", "utf16"]),
  section: z.string().nullable(),
  xrefs_count: z.literal(0),
  functions: z.tuple([]),
});
const ROWS = "strings";
const DOCUMENT = {
  header: new Set(Object.keys(header.shape)),
  sections: new Map(),
  rows: new Map([
    [
      ROWS,
      {
        fields: new Set(
          Object.keys(row.shape).filter(
            (key) => key !== "address" && key !== "functions",
          ),
        ),
        addresses: new Set(["address"]),
        empty: new Set(["functions"]),
        nulls: new Set<string>(),
      },
    ],
  ]),
} as const;
const validateStringFacts = (entry: z.infer<typeof row>): void => {
  let characters = 0;
  for (const character of entry.text) {
    const point = character.codePointAt(0)!;
    if (
      point === 0 ||
      (point >= 0xd800 && point <= 0xdfff) ||
      (entry.encoding === "ascii" && point > 0x7f) ||
      (entry.encoding === "utf16" && point > 0xff)
    )
      throw new Error("string text contradicts its reported encoding");
    characters += 1;
  }
  const textBytes =
    entry.encoding === "utf16"
      ? entry.text.length * 2
      : entry.encoding === "ascii"
        ? entry.text.length
        : Buffer.byteLength(entry.text);
  const terminatorBytes = entry.nul_terminated
    ? entry.encoding === "utf16"
      ? 2
      : 1
    : 0;
  if (
    characters < KUNA_STRING_MIN_LENGTH ||
    entry.length !== characters ||
    entry.byte_length !== textBytes + terminatorBytes
  )
    throw new Error(
      "string length or termination contradicts its encoded text",
    );
};
export type KunaStringItem = z.infer<typeof analysisStringSchema>;
export interface KunaStringInventory {
  readonly items: readonly KunaStringItem[];
  readonly sha256: string;
  readonly bytes: number;
  readonly scanned: "sections" | "segments";
}
export class KunaStringInventoryReader extends KunaJsonDocumentReader<KunaStringInventory> {
  readonly #items: KunaStringItem[] = [];
  readonly #identities = new Set<string>();
  constructor() {
    super("kuna:strings", "Kuna's string inventory", DOCUMENT);
  }
  override finish(input: string): Result<KunaStringInventory, AnalysisError> {
    const completed = this.complete();
    if (!completed.ok) return completed;
    const fields = header.safeParse(completed.value.header);
    if (!fields.success)
      return err(
        this.unusable("the string inventory header is not Kuna's scan"),
      );
    if (fields.data.binary !== input)
      return err(this.unusable("string inventory names a different input"));
    if (fields.data.count !== this.#items.length)
      return err(
        this.unusable("string inventory count disagrees with examined rows"),
      );
    this.#items.sort(
      (left, right) =>
        compareKunaAddresses(left.address, right.address) ||
        (left.string?.encoding ?? "").localeCompare(
          right.string?.encoding ?? "",
          "en",
        ),
    );
    return ok({
      items: this.#items,
      sha256: completed.value.sha256,
      bytes: completed.value.bytes,
      scanned: fields.data.scanned,
    });
  }
  protected override acceptRow(
    _member: string,
    fields: Readonly<Record<string, unknown>>,
  ): void {
    const entry = parseKunaRow(row, "string", fields);
    validateStringFacts(entry);
    if (entry.address !== entry.address_hex)
      throw new Error("string address disagrees with its hex field");
    const identity = `${entry.address}:${entry.encoding}`;
    if (this.#identities.has(identity))
      throw new Error("string inventory repeats an identity");
    this.#identities.add(identity);
    this.#items.push({
      address: entry.address,
      value: entry.text,
      string: {
        encoding: entry.encoding,
        encoding_status: "observed",
        termination: entry.nul_terminated
          ? "present_or_not_required"
          : "missing",
        byte_length: entry.byte_length,
      },
    });
  }
  protected override discardRows(): void {
    this.#items.length = 0;
    this.#identities.clear();
  }
}
</file>

<file path="src/kuna/KunaStringQueries.ts">
import type { AnalysisError } from "../domain/analysisErrorBase.js";
import {
  AnalysisCancelledError,
  AnalysisInputError,
} from "../domain/analysisErrorCore.js";
import {
  analysisSearchPredicate,
  analysisSearchQuerySchema,
} from "../domain/analysisSearch.js";
import { analysisInputErrorFromIssues } from "../domain/inputIssueProjection.js";
import type { JsonValue } from "../domain/jsonValue.js";
import { err, ok, type Result } from "../domain/result.js";
import { normalizeKunaAddress } from "./KunaAddress.js";
import type { KunaInstallation } from "./KunaInstallation.js";
import type { KunaPendingQuery, KunaQueryWork } from "./KunaQueryWork.js";
import { kunaQueryFailureForCaller } from "./KunaQueryErrors.js";
import { KUNA_STRING_MIN_LENGTH } from "./KunaLimits.js";
import {
  KunaStringInventoryReader,
  type KunaStringInventory,
  type KunaStringItem,
} from "./KunaStringInventory.js";
export class KunaStringQueries {
  #inventory: KunaStringInventory | undefined;
  #failure: AnalysisError | undefined;
  #pending: KunaPendingQuery<KunaStringInventory> | undefined;
  constructor(private readonly work: KunaQueryWork) {}
  async execute(
    operation: "list_strings" | "search_strings",
    parameters: Readonly<Record<string, JsonValue>>,
    installation: KunaInstallation,
    signal: AbortSignal | undefined,
  ): Promise<
    Result<
      { readonly result: JsonValue; readonly source: JsonValue },
      AnalysisError
    >
  > {
    if (signal?.aborted === true)
      return err(new AnalysisCancelledError(operation));
    const query =
      operation === "search_strings"
        ? analysisSearchQuerySchema.safeParse(parameters)
        : undefined;
    if (query !== undefined && !query.success)
      return err(
        analysisInputErrorFromIssues(operation, query.error.issues, parameters),
      );
    const address =
      operation === "list_strings" && parameters.address !== undefined
        ? normalizeKunaAddress(parameters.address)
        : undefined;
    if (
      operation === "list_strings" &&
      parameters.address !== undefined &&
      address === undefined
    )
      return err(
        new AnalysisInputError(operation, {
          userMessage: "Use an explicit hexadecimal u64 string address.",
        }),
      );
    const inventory = await this.#load(installation, operation, signal);
    if (!inventory.ok)
      return err(kunaQueryFailureForCaller(inventory.error, operation));
    if (this.#cancelled(signal))
      return err(new AnalysisCancelledError(operation));
    const available = inventory.value.items;
    let items: KunaStringItem[] | undefined;
    if (address !== undefined)
      items = available.filter((item) => item.address === address);
    if (query?.success === true) {
      if (query.data.mode === "regex") {
        const matched = await this.work.match({
          operation,
          pattern: query.data.pattern,
          caseSensitive: query.data.case_sensitive,
          values: () => available.map((item) => item.value),
          signal,
        });
        if (!matched.ok) return matched;
        items = matched.value.map((index) => available[index]!);
      } else {
        const predicate = analysisSearchPredicate(query.data);
        items = available.filter((item) => predicate(item.value));
      }
    }
    const selected = items ?? [...available];
    return ok({
      result: selected,
      source: {
        kind: "kuna-string-inventory",
        sha256: inventory.value.sha256,
        bytes: inventory.value.bytes,
        scanned: inventory.value.scanned,
        encoding: "all",
        min_length: KUNA_STRING_MIN_LENGTH,
        termination: "any",
        xrefs: false,
        inventory_count: inventory.value.items.length,
        selected_count: selected.length,
      },
    });
  }
  async #load(
    installation: KunaInstallation,
    operation: string,
    signal: AbortSignal | undefined,
  ): Promise<Result<KunaStringInventory, AnalysisError>> {
    if (this.#inventory !== undefined) return ok(this.#inventory);
    if (this.#failure !== undefined) return err(this.#failure);
    if (this.#pending?.controller.signal.aborted === true) {
      const stopped = await this.work.wait(this.#pending, signal, operation);
      if (!stopped.ok && !(stopped.error instanceof AnalysisCancelledError))
        return stopped;
      if (signal?.aborted === true)
        return err(new AnalysisCancelledError(operation));
      return this.#load(installation, operation, signal);
    }
    if (this.#pending === undefined) {
      const pending = this.work.start<KunaStringInventory>(
        (producerSignal) =>
          this.work.scan(
            {
              installation,
              operation: "kuna:strings",
              arguments: (input) => [
                "strings",
                input,
                "--json",
                "--encoding",
                "all",
                "--min-length",
                String(KUNA_STRING_MIN_LENGTH),
                "--termination",
                "any",
                "--no-xrefs",
              ],
              timeoutMs: installation.configuration.projectTimeoutMs,
            },
            new KunaStringInventoryReader(),
            producerSignal,
            (failure) => {
              this.#failure = failure;
            },
          ),
        (value) => {
          this.#inventory = value;
        },
      );
      this.#pending = pending;
      const release = () => {
        if (this.#pending === pending) this.#pending = undefined;
      };
      void pending.promise.then(release, release);
    }
    return this.work.wait(this.#pending, signal, operation);
  }
  #cancelled(signal: AbortSignal | undefined): boolean {
    return signal?.aborted === true;
  }
  clear(): void {
    this.#inventory = undefined;
    this.#failure = undefined;
    this.#pending = undefined;
  }
}
</file>

<file path="src/kuna/KunaTargetCommands.ts">
import { basename, join } from "node:path";
import { realpath } from "node:fs/promises";
import type { Writable } from "node:stream";
import type { AnalysisError } from "../domain/analysisErrorBase.js";
import {
  AnalysisArtifactChangedError,
  AnalysisCancelledError,
} from "../domain/analysisErrorCore.js";
import type { BinaryTarget } from "../domain/binaryTargetTypes.js";
import { ProviderAdapterError } from "../domain/providerAdapterError.js";
import { ProviderCleanupError } from "../domain/providerCleanupError.js";
import { err, ok, type Result } from "../domain/result.js";
import { PrivateRuntimeRoot } from "../process/PrivateRuntimeRoot.js";
import { prepareProcessOwnershipInspection } from "../process/ProcessOwnershipObservation.js";
import type {
  ProviderProcessSnapshot,
  ProviderProcessSupervisor,
} from "../process/ProviderProcess.js";
import {
  copyAndHash,
  runKunaCommand,
  type KunaProcessLauncher,
} from "./KunaCommand.js";
import type { KunaInstallation } from "./KunaInstallation.js";
import { KUNA_PROVIDER_ID } from "./KunaRelease.js";
import type { KunaRunRelease } from "./KunaRunSlots.js";
import { ArtifactResourceScope } from "../artifacts/ArtifactResourceScope.js";
import { AnalysisCleanupLease } from "../artifacts/AnalysisCleanupLease.js";
import { ArtifactReaderFailure } from "../artifacts/ArtifactReader.js";
import type { OwnedFileHandle } from "../filesystem/OwnedFileHandle.js";
interface Workspace {
  readonly root: PrivateRuntimeRoot;
  readonly input: string;
}
export interface KunaTargetCommandSnapshot extends ProviderProcessSnapshot {
  readonly input: string;
}
export interface KunaTargetCommandRequest {
  readonly installation: KunaInstallation;
  readonly operation: string;
  readonly arguments: (input: string) => readonly string[];
  readonly outputBytes: number;
  readonly stdout?: Writable;
  readonly timeoutMs: number;
  readonly signal: AbortSignal;
  readonly releaseRun?: KunaRunRelease;
}
export class KunaTargetCommands {
  readonly #resources = new ArtifactResourceScope();
  readonly #retained: {
    readonly error: ProviderCleanupError;
    readonly owner: ProviderProcessSupervisor | undefined;
    readonly releaseRun: KunaRunRelease | undefined;
  }[] = [];
  readonly #roots: PrivateRuntimeRoot[] = [];
  #workspace: Promise<Result<Workspace, AnalysisError>> | undefined;
  #closing = false;
  constructor(
    private readonly target: BinaryTarget,
    private readonly lifetime: {
      readonly signal: AbortSignal;
      readonly launcher?: KunaProcessLauncher;
    },
  ) {}
  run(
    request: KunaTargetCommandRequest,
  ): Promise<Result<KunaTargetCommandSnapshot, AnalysisError>> {
    if (this.#closing || request.signal.aborted) {
      request.releaseRun?.();
      return Promise.resolve(
        err(new AnalysisCancelledError(request.operation)),
      );
    }
    return this.#run(request);
  }
  prepare(): Promise<Result<null, AnalysisError>> {
    if (this.#closing || this.lifetime.signal.aborted)
      return Promise.resolve(err(new AnalysisCancelledError("kuna:workspace")));
    return this.#admit("kuna:workspace", () =>
      this.#ensureWorkspace().then((workspace) =>
        workspace.ok ? ok(null) : workspace,
      ),
    );
  }
  async #run(
    request: KunaTargetCommandRequest,
  ): Promise<Result<KunaTargetCommandSnapshot, AnalysisError>> {
    const { releaseRun, ...options } = request;
    let retained = false;
    try {
      return await this.#admit(request.operation, async () => {
        const workspace = await this.#ensureWorkspace();
        if (!workspace.ok) return workspace;
        let failedHashClose:
          | {
              readonly owner: OwnedFileHandle;
              readonly lease: AnalysisCleanupLease;
            }
          | undefined;
        const outcome = await runKunaCommand({
          ...options,
          arguments: request.arguments(workspace.value.input),
          workspace: workspace.value.root.path,
          reportedTimeoutMs: request.timeoutMs,
          launcher: this.lifetime.launcher,
          retainFailedFileClose: (owner, resource) => {
            const lease = new AnalysisCleanupLease(() => owner.close());
            this.#resources.retain({ kind: "lease", resource, lease });
            failedHashClose = { owner, lease };
          },
        });
        if (outcome.kind === "retained") {
          this.#retained.push({
            error: outcome.error,
            owner: outcome.owner,
            releaseRun,
          });
          retained = true;
          return err(outcome.error);
        }
        const fileFailure =
          outcome.kind === "failed" ? outcome.fileCleanupFailure : undefined;
        if (outcome.kind === "ok")
          return ok({ ...outcome.snapshot, input: workspace.value.input });
        if (
          fileFailure !== undefined &&
          fileFailure.owner === failedHashClose?.owner
        )
          failedHashClose.lease.bindCleanupError(outcome.error);
        return err(outcome.error);
      });
    } finally {
      if (!retained) releaseRun?.();
    }
  }
  async close(): Promise<Result<null, ProviderCleanupError>> {
    this.#closing = true;
    const failures: ProviderCleanupError[] = [];
    try {
      await this.#resources.close();
    } catch (cause: unknown) {
      const observation = ArtifactReaderFailure.cleanupObservation(
        cause,
        "Kuna command file descriptor",
      );
      failures.push(
        new ProviderCleanupError(
          KUNA_PROVIDER_ID,
          observation.resources,
          { reason: observation.reason },
          { cause },
        ),
      );
    }
    for (const retained of [...this.#retained]) {
      const stopped = await retained.owner?.stop();
      if (stopped !== undefined && stopped.status !== "incomplete") {
        retained.releaseRun?.();
        this.#retained.splice(this.#retained.indexOf(retained), 1);
      }
    }
    failures.push(...this.#retained.map(({ error }) => error));
    const workspace = await this.#workspace;
    if (this.#retained.length === 0) {
      if (workspace?.ok === true) {
        this.#roots.push(workspace.value.root);
        this.#workspace = undefined;
      }
      for (const root of [...this.#roots])
        try {
          await root.close();
          this.#roots.splice(this.#roots.indexOf(root), 1);
        } catch (cause: unknown) {
          failures.push(
            new ProviderCleanupError(
              KUNA_PROVIDER_ID,
              [root.path],
              {
                reason: cause instanceof Error ? cause.message : String(cause),
              },
              { cause },
            ),
          );
        }
    }
    return failures.length === 0
      ? ok(null)
      : err(
          new ProviderCleanupError(
            KUNA_PROVIDER_ID,
            failures.flatMap((failure) => failure.cleanupResources),
            {
              reason: failures
                .map((failure) =>
                  String(failure.diagnostics?.["reason"] ?? failure.message),
                )
                .join("; "),
            },
            {
              cause: new AggregateError(
                failures,
                "Kuna command cleanup remains incomplete",
              ),
            },
          ),
        );
  }
  async #admit<T>(
    operation: string,
    work: () => Promise<Result<T, AnalysisError>>,
  ): Promise<Result<T, AnalysisError>> {
    try {
      return await this.#resources.run(work);
    } catch (cause: unknown) {
      if (cause instanceof ArtifactReaderFailure && cause.cleanup !== undefined)
        return err(
          new ProviderCleanupError(
            KUNA_PROVIDER_ID,
            cause.cleanup.resources,
            { reason: cause.cleanup.reason },
            { cause, operation },
          ),
        );
      if (this.#closing && cause instanceof ArtifactReaderFailure)
        return err(new AnalysisCancelledError(operation, { cause }));
      throw cause;
    }
  }
  async #ensureWorkspace(): Promise<Result<Workspace, AnalysisError>> {
    this.#workspace ??= (async () => {
      const root = await PrivateRuntimeRoot.create({ prefix: "rea-kuna-" });
      try {
        const input = join(root.path, basename(this.target.path));
        const digest = await copyAndHash(
          this.target.path,
          input,
          this.lifetime.signal,
        );
        if (digest !== this.target.sha256) {
          await this.#release(root);
          return err(
            new AnalysisArtifactChangedError(
              "kuna:workspace",
              this.target.path,
              "the target no longer matches the digest selected for analysis",
            ),
          );
        }
        await prepareProcessOwnershipInspection(this.lifetime.signal);
        return ok({ root, input: await realpath(input) });
      } catch (cause: unknown) {
        await this.#release(root);
        throw cause;
      }
    })().catch((cause: unknown) =>
      err(
        new ProviderAdapterError(KUNA_PROVIDER_ID, "kuna:workspace", {
          cause,
          userMessage: `Kuna workspace failed: ${cause instanceof Error ? cause.message : String(cause)}`,
        }),
      ),
    );
    const result = await this.#workspace;
    if (!result.ok) this.#workspace = undefined;
    return result;
  }
  async #release(root: PrivateRuntimeRoot): Promise<void> {
    try {
      await root.close();
    } catch {
      this.#roots.push(root);
    }
  }
}
</file>

