  try {
    const processes = await execFileOutput(
      "/bin/ps",
      ["-ax", "-o", "command="],
      { env: environment },
    );
    return processes.stdout
      .split("\n")
      .some((command) => command.trim() === executablePath);
  } catch (cause: unknown) {
    void cause;
    return false;
  }
};
