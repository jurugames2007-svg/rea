    const key = `${value.toString(16)}:${kind}`;
    if (seen.has(key))
      return err(seedLineError(number, `duplicate ${kind} seed at ${address}`));
    seen.add(key);
    entries.push({
      address: value,
      kind,
      ...(name === undefined ? {} : { name }),
    });
    if (entries.length > MAX_GHIDRA_SEED_ENTRIES)
