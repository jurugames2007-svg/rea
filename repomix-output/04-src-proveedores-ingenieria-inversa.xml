  if (!parsed.ok || parsed.value.analysis_timed_out) {
    const failure = parsed.ok
      ? options.failure(
          "analysis_timeout",
          "Ghidra auto-analysis reached its per-file deadline",
        )
      : parsed.error;
    return err(failure);
  }
