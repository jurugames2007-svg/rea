    return err(
      new ProviderAdapterError("ghidra", "resolve_analysis_profile", {
        cause,
        diagnostics: {
          setting: "REA_GHIDRA_SEED_FILE",
          path: configured,
          reason: cause instanceof Error ? cause.message : String(cause),
