    [
      { cpuType: CPU_TYPES.x86_64, cpuSubtype: 3 },
      { cpuType: CPU_TYPES.arm64, cpuSubtype: ARM64E },
      { cpuType: CPU_TYPES.arm64, cpuSubtype: ARM64E_X1 },
    ],
    { littleEndianTable: true },
