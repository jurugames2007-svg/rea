  const result = requireResolved(
    await resolveHopperMachOImage(fat32Target(path, fixture, "arm64")),
  );
  expect(result).toMatchObject({
    method: "fat32_thin_slice",
    cpu_subtype: ARM64E,
    source_offset: fixture.sliceOffsets[1],
  });
});
