    target.mips.elfClass === 32 &&
    target.mips.type === MIPS_ET_EXEC &&
    (arch === 0x50000000 || arch === 0x70000000) &&
    (flags & 0x0000f000) === 0 &&
    (flags & 0x20) === 0 &&
    (flags & 0x40) === 0 &&
    (flags & 0x100) === 0 &&
