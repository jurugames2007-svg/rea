      {
        pattern: "a.b",
        mode: "literal",
        case_sensitive: false,
        expected: ["A.B"],
      },
      { pattern: "a.b", mode: "literal", case_sensitive: true, expected: [] },
      {
        pattern: "kelvin",
        mode: "literal",
        case_sensitive: false,
        expected: ["Kelvin"],
      },
      {
        pattern: "İ",
        mode: "literal",
        case_sensitive: false,
        expected: ["İstanbul"],
      },
      { pattern: "σ", mode: "literal", case_sensitive: false, expected: ["σ"] },
      {
        pattern: "σ",
        mode: "regex",
        case_sensitive: false,
        expected: ["σ", "ς"],
      },
      {
        pattern: "[",
        mode: "literal",
        case_sensitive: false,
        expected: ["literal[bracket"],
      },
      {
        pattern: "\\",
        mode: "literal",
        case_sensitive: true,
        expected: ["a\\b"],
      },
      {
        pattern: "\ud800",
        mode: "literal",
        case_sensitive: false,
        expected: [],
      },
      {
        pattern: "🧪",
        mode: "literal",
        case_sensitive: true,
        expected: ["🧪"],
