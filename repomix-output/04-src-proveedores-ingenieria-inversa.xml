          return stopped;
      }
      return result === ABORTED
        ? err(new AnalysisCancelledError(operation))
        : result;
    } finally {
      pending.waiters -= 1;
      if (pending.waiters === 0 && !pending.settled) pending.controller.abort();
    }
  }
}
