            await this.connection.call("idb_list", {}),
          );
          const remaining = inventory.sessions.filter(
            (entry) =>
              entry.session_id === this.#database ||
              sameIdaHostPath(
                entry.input_path,
                this.#workspace?.inputPath ?? "",
              ),
          );
