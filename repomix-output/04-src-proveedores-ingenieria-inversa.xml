                    status: "complete",
                    relocation_count: target.mips.sharedLoad.relocationCount,
                    relocation_types: [
                      ...target.mips.sharedLoad.relocationTypes,
                    ],
                    symbol_relative_count:
                      target.mips.sharedLoad.symbolRelativeCount,
