      windows.flatMap((window) =>
        window.observations.map(({ properties }) => properties.web_preferences),
      ),
    ).toEqual(
      expect.arrayContaining([
        expect.arrayContaining([
          expect.objectContaining({
            name: "preload",
            value: {
              status: "dynamic",
              value: null,
              expression: "runtimePath",
            },
          }),
        ]),
      ]),
    );
  },
