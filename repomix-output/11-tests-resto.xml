<file path="tests/conformance/ghidra/relative-switch-signed.S">
// Hand-written signed halfword relative dispatch, modelled on the AOSP
// RenderScript blend kernel shape reported in issue #487:
//   adrp/add table; cmp; b.cs default; ldrsh; cbz null; adr base; add; br.
// Entries are signed byte offsets from Lsigned_base (no scaling), so cases
// before the base encode negative offsets. A zero entry means "no case body"
// and is routed through the CBZ before the branch. The source labels and the
// immediates below are the oracle; no REA or Ghidra result defines them.
//   case 0 -> 200, 1 -> 201, 2 -> 202, 3 -> null path (250), 4 -> 204,
//   selector >= 5 -> default (-1).
#ifndef REA_SELECTOR_BIAS
#define REA_SELECTOR_BIAS 0
#endif
// Nonzero variants switch on the original selector (bias .. bias+4),
// while the guarded table index is selector - bias.
#if defined(__APPLE__)
.section __TEXT,__text,regular,pure_instructions
.globl _rea_relative_switch_signed
.p2align 2
_rea_relative_switch_signed:
#else
.text
.globl rea_relative_switch_signed
.type rea_relative_switch_signed,%function
.p2align 2
rea_relative_switch_signed:
#endif
#if defined(__APPLE__)
  adrp x5, Lsigned_table@PAGE
  add x5, x5, Lsigned_table@PAGEOFF
#else
  adrp x5, Lsigned_table
  add x5, x5, :lo12:Lsigned_table
#endif
#if REA_SELECTOR_BIAS != 0
  sub w8, w0, #REA_SELECTOR_BIAS
  cmp w8, #5
  b.cs Lsigned_default
  ldrsh x6, [x5, w8, uxtw #1]
#else
  cmp w0, #5
  b.cs Lsigned_default
  ldrsh x6, [x5, w0, uxtw #1]
#endif
  cbz x6, Lsigned_null
  adr x5, Lsigned_base
  add x6, x5, x6
  br x6
Lsigned_case0:
  mov w0, #200
  ret
Lsigned_case1:
  mov w0, #201
  // The base sits inside case 1 so that no real case has a zero offset.
Lsigned_base:
  ret
Lsigned_case2:
  mov w0, #202
  ret
Lsigned_case4:
  mov w0, #204
  ret
Lsigned_null:
  mov w0, #250
  ret
Lsigned_default:
  mov w0, #-1
  ret
#if !defined(__APPLE__)
.size rea_relative_switch_signed, .-rea_relative_switch_signed
#endif

#if defined(__APPLE__)
.section __TEXT,__const
#else
.section .rodata
#endif
.p2align 1
Lsigned_table:
  .short Lsigned_case0-Lsigned_base
  .short Lsigned_case1-Lsigned_base
  .short Lsigned_case2-Lsigned_base
  .short 0
  .short Lsigned_case4-Lsigned_base
</file>

<file path="tests/conformance/ghidra/relative-switch.S">
#if defined(__APPLE__)
.section __TEXT,__text,regular,pure_instructions
.globl _rea_relative_switch
_rea_relative_switch:
#else
.text
.globl rea_relative_switch
.type rea_relative_switch,%function
rea_relative_switch:
#endif
  cmp w0, #3
  b.hi Ldefault
  mov w8, w0
#if defined(__APPLE__)
  adrp x9, Ltable@PAGE
  add x9, x9, Ltable@PAGEOFF
#else
  adrp x9, Ltable
  add x9, x9, :lo12:Ltable
#endif
  adr x10, Lcase0
#if REA_ENTRY_BYTES == 2
  ldrh w11, [x9, x8, lsl #1]
#else
  ldrb w11, [x9, x8]
#endif
  add x10, x10, x11, lsl #2
  br x10
Lcase0:
  mov w0, #100
  ret
#if REA_ENTRY_BYTES == 2
  .space 1100
#endif
Lcase1:
  mov w0, #101
  ret
Lcase2:
  mov w0, #102
  ret
Lcase3:
  mov w0, #103
  ret
Ldefault:
  mov w0, #-1
  ret
#if defined(__APPLE__)
.section __TEXT,__const
#else
.section .rodata
#endif
.p2align 1
Ltable:
#if REA_ENTRY_BYTES == 2
  .short (Lcase0-Lcase0)/4, (Lcase1-Lcase0)/4, (Lcase2-Lcase0)/4, (Lcase3-Lcase0)/4
#else
  .byte (Lcase0-Lcase0)/4, (Lcase1-Lcase0)/4, (Lcase2-Lcase0)/4, (Lcase3-Lcase0)/4
#endif
</file>

<file path="tests/conformance/ghidra/riscv-fixture.mjs">
import assert from "node:assert/strict";
import { execFile } from "node:child_process";
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
const execute = promisify(execFile);
export async function buildRiscvFixture(directory, bits) {
  assert.ok(bits === 32 || bits === 64);
  const compiler = process.env.REA_RISCV_CLANG ?? "clang";
  const linker = process.env.REA_RISCV_LLD ?? "ld.lld";
  const reader = process.env.REA_RISCV_READELF ?? "llvm-readelf";
  const source = fileURLToPath(new URL("../c/riscv.c", import.meta.url));
  const probe = fileURLToPath(new URL("./riscv-probe.S", import.meta.url));
  const path = join(directory, `rv${bits}.elf`);
  const args = [
    `--target=riscv${bits}-unknown-elf`,
    `-march=rv${bits}imafdc`,
    `-mabi=${bits === 32 ? "ilp32d" : "lp64d"}`,
    `--ld-path=${linker}`,
    "-nostdlib",
    "-static",
    "-fno-pic",
    "-O0",
    "-g",
    "-Wl,-e,rea_riscv_entry",
    "-Wl,--build-id=none",
    source,
    probe,
    "-o",
    path,
  ];
  const options = { timeout: 10000, maxBuffer: 1024 * 1024 };
  const compilerVersion = await execute(compiler, ["--version"], options);
  const linkerVersion = await execute(linker, ["--version"], options);
  const readerVersion = await execute(reader, ["--version"], options);
  await execute(compiler, args, { ...options, timeout: 60000 });
  const { stdout, stderr } = await execute(reader, ["-h", "-s", "-W", path], {
    ...options,
    env: { ...process.env, LC_ALL: "C" },
  });
  assert.equal(stderr.trim(), "", "Unexpected ELF reader diagnostics");
  const field = (expression, label) => {
    const matches = [...stdout.matchAll(expression)];
    assert.equal(matches.length, 1, `Missing or ambiguous readelf ${label}`);
    return matches[0][1].trim();
  };
  assert.equal(field(/^\s*Class:\s*(.+)$/gmu, "class"), `ELF${bits}`);
  assert.match(field(/^\s*Data:\s*(.+)$/gmu, "byte order"), /little endian/u);
  assert.match(field(/^\s*Type:\s*(.+)$/gmu, "type"), /^EXEC\b/u);
  assert.match(field(/^\s*Machine:\s*(.+)$/gmu, "machine"), /^RISC-V\b/u);
  const flags = Number(field(/^\s*Flags:\s*(0x[\da-f]+).*$/gmu, "flags"));
  assert.equal(flags, 5, "Compiler did not declare RVC and double-float ABI");
  const symbols = {};
  for (const name of [
    "rea_riscv_entry",
    "rea_riscv_leaf",
    "rea_riscv_float",
    "rea_riscv_probe",
    "rea_riscv_global",
  ]) {
    const value = field(
      new RegExp(
        `^\\s*\\d+:\\s+([\\da-f]+)\\s+\\d+\\s+(?:FUNC|OBJECT)\\s+GLOBAL\\s+\\S+\\s+\\d+\\s+${name}\\s*$`,
        "gmu",
      ),
      name,
    );
    symbols[name] = `0x${BigInt(`0x${value}`).toString(16)}`;
  }
  return {
    path,
    sha256: createHash("sha256")
      .update(await readFile(path))
      .digest("hex"),
    riscv: { elfClass: bits, byteOrder: "little", type: 2, flags },
    symbols,
    toolchain: {
      compiler: { command: compiler, version: compilerVersion.stdout.trim() },
      linker: { command: linker, version: linkerVersion.stdout.trim() },
      reader: { command: reader, version: readerVersion.stdout.trim() },
      arguments: args,
    },
    sources: await Promise.all(
      [source, probe].map(async (sourcePath) => ({
        path: sourcePath,
        sha256: createHash("sha256")
          .update(await readFile(sourcePath))
          .digest("hex"),
      })),
    ),
  };
}
