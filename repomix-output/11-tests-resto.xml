          preload_resolution_context:
            scenario.preloadPath === null ? null : "module-specifier",
          web_preferences: expect.arrayContaining([
            {
              name: "preload",
              value: {
                status: "literal",
                value: "./first.js",
                expression: null,
              },
            },
          ]),
        },
        evidence: {
