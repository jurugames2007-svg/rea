    { address: "0x10008", type: 4, status: "APPLIED" },
    { address: "0x1000c", type: 6, status: "APPLIED" },
    { address: "0x10010", type: 2, status: "APPLIED" },
    { address: "0x10014", type: 2, status: "APPLIED" },
