        expect(parseMcpToolError(await call("close_binary")).error.code).toBe(
          "cleanup_incomplete",
        );
      } finally {
        let serverExited: Promise<void> | undefined;
        if (transport.pid !== null) {
          const onclose = transport.onclose;
          serverExited = new Promise<void>((resolveExit) => {
            transport.onclose = () => {
              onclose?.();
              resolveExit();
