}
export function markerBytes(marker) {
  const bytes = Buffer.alloc(5);
  bytes[0] = 0xb8;
  bytes.writeUInt32LE(marker, 1);
  return bytes;
}
export function assertSwitchMarkerBytes(bytes, fixtures) {
