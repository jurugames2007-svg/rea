      },
      location: {
        available: true,
        value: {
          kind: "source-range",
          source: fixture.path,
          start: {
            line: target.loc.start.line,
            column: target.loc.start.column,
          },
          end: { line: target.loc.end.line, column: target.loc.end.column },
        },
      },
    },
  });
};
