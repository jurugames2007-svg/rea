  if (!closed.ok) {
    if (!outcome.ok)
      throw new AggregateError(
        [outcome.error, closed.error],
        "Artifact operation and client cleanup failed",
      );
    throw closed.error;
  }
  if (!outcome.ok) throw outcome.error;
  return outcome.value;
};
