  little(62, rustc === null && omitSection ? 0 : 1, 16);
  little(128, 1, 32);
  little(132, 6, 32);
  little(144, 0x400000, 64);
  little(160, bytes.length, 64);
  little(168, bytes.length, 64);
  if (rustc === null && omitSection) return;
