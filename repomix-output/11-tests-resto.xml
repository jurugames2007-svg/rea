      insert.run(
        9007199254740993n,
        Buffer.from("deadbeef", "hex"),
        Infinity,
        -0,
      ).lastInsertRowid,
    ).toBe(9007199254740993n);
    insert.run(9007199254740994n, Buffer.from("deadbeef", "hex"), Infinity, -0);
  } finally {
