    const cases = [
      {
        source: "query.html",
        script: "./app.js?redirect=%2Ffoo",
        resolved: "app.js",
      },
      {
        source: "fragment.html",
        script: "./app.js#route=%2Ffoo",
        resolved: "app.js",
      },
      {
