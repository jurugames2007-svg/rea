              imported_name: name,
              imported_path: [name],
              resolved_path: "module.mjs",
              resolution_status: "resolved",
            }),
          }),
        );
      }
    }
    expect(imports).toContainEqual(
      expect.objectContaining({
        properties: expect.objectContaining({
          exported_name: "direct",
          imported_name: "",
          imported_path: [""],
          resolution_status: "resolved",
        }),
      }),
    );
  },
);
