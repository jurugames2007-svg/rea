    mixed.occurrences.map(
      ({ logical_path, artifact_kind, artifact_format }) => [
        logical_path,
        { artifact_kind, artifact_format },
      ],
    ),
  );
  for (const [name] of javaEntries)
    expect(formatsByPath.get(name)).toEqual({
