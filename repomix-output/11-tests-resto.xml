  const little = (offset: number, value: number, width: 16 | 32 | 64) => {
    if (width === 16) view.setUint16(offset, value, true);
    else if (width === 32) view.setUint32(offset, value, true);
    else view.setBigUint64(offset, BigInt(value), true);
