  graph: JavaScriptApplicationGraph,
  fixture: (typeof typeScriptDialectCases)[number],
): void => {
  const parsed = parse(fixture.source, {
    sourceType: "unambiguous",
    plugins: fixture.path.endsWith(".ts")
      ? ["typescript"]
