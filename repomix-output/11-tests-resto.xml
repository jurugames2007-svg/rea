    expect(failure.stderr).toContain("NU1301");
    expect(failure.stderr).toContain("feed.invalid/v3/index.json");
    expect(failure.stderr).toContain(
      "https://feed.invalid/path/user@name?label=token-name",
    );
    if (operation === "restore") {
