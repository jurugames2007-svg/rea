      assertPowerPcProbe(
        move,
        { ...branch, flow: { ...branch.flow, conditional: false } },
        "0x10010224",
      ),
    ).toThrow();
  });
  it("checks the big-endian global word", () => {
    assertPowerPcGlobal("00000007");
