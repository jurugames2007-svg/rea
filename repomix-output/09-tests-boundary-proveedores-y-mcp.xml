it("reads an oversized completed WASM result through its reported retained reference", async () => {
  const text = "(module)\n" + ";;😀\n" + " ".repeat(6 * 1024 * 1024);
  const value = {
    ...wasmArtifactFixture(),
    imports: ['(import "env" "memory.with punctuation" (memory 1))'],
