    const boundary = input.indexOf("\\n");
    if (boundary < 0) break;
    const line = input.slice(0, boundary);
    input = input.slice(boundary + 1);
    if (line === "dr") process.stdout.write("rax=0x1234\\0");
    else if (line === "slow") {
