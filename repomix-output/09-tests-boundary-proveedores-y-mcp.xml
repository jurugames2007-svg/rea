      reader.open({ ...secondEntry, path: firstEntry.path }),
    ).rejects.toMatchObject({ reason: "integrity" });
    await expect(
      reader.open({ ...secondEntry, byteOffset: firstEntry.byteOffset }),
    ).rejects.toMatchObject({ reason: "integrity" });
    await expect(
      reader.open({ ...secondEntry, declaredSize: arm.length + 1 }),
    ).rejects.toMatchObject({ reason: "integrity" });
