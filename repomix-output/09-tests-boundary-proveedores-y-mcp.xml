        if (clientError !== undefined) return [clientError];
        if (kind === "inputSchema") {
          const literalError = booleanLiteralSchemaError(
            schema,
            `${tool.name}.${kind}`,
          );
          if (literalError !== undefined) return [literalError];
        }
        return [];
      } catch (cause: unknown) {
        return [
          `${tool.name}.${kind}: ${cause instanceof Error ? cause.message : String(cause)}`,
