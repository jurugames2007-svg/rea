});
const summarySchema = z.object({
  kind: z.literal("summary"),
  parent_evidence_id: z.string(),
  summary: z.object({
    uuid: z.string().nullable(),
    collections: z.record(z.string(), countSchema),
    provenance_count: z.number(),
  }),
