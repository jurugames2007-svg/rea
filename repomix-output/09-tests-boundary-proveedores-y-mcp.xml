      "inspect_jeb_client",
      "list_jeb_units",
      "decompile_jeb_item",
    ],
  };
  const recovered = await read();
  expect(
    recovered
      .filter((tool) => tool.available)
      .map((tool) => tool.name)
      .sort(),
  ).toEqual(["decompile_jeb_item", "inspect_jeb_client", "list_jeb_units"]);
  expect(
    recovered.find((tool) => tool.name === "open_jeb_project"),
  ).toMatchObject({
