    expect(analysisSession.activeTarget()?.path).toBe(target);
    expect(
      (await analysisSession.execute("address_name", { address: "0x1" })).ok,
    ).toBe(true);
  } finally {
    await Promise.allSettled([client.close(), server.close()]);
