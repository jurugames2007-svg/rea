    expect(full.catalogIdentity.digests).toEqual(fullIdentity);
    expect(compact.catalogIdentity.digests).toEqual(compactIdentity);
    expect(compactIdentity.tools_sha256).not.toBe(fullIdentity.tools_sha256);
    expect(
