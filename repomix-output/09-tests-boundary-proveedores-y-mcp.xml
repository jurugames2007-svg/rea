it("indexes code listings and data labels in Kuna's .asm", async () => {
  const asm = [
    "; kuna decompile-project — a.out",
    "; arch: x86:LE:64:default:gcc",
    "",
    "; --- code section 0x1000..0x1020 ---",
    "",
    "main:  ; 0x1000",
    "; arg:   param_1 (int)",
    "  00001000: c3                        RET",
    "",
    "operator new(unsigned long):  ; 0x1010",
