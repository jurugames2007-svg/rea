          { address: "0x2000", value: "unique" },
          { address: "0x3000", value: "duplicate" },
          { address: "0x4000", value: "tail" },
        ]),
      );
    }
    return Promise.resolve(observe(null));
  };
  return {
    execute,
    executeIfReady: execute,
    close: () => Promise.resolve(resultOk(null)),
  };
