        view: { kind: "summary" },
      }),
    ).toMatchObject({ ok: false, error: { _tag: "AnalysisInputError" } });
});
it("rejects unavailable retention, invalid selectors and cancellation before provider execution", async () => {
  const execute = vi.fn();
  const provider = {
    execute,
    close: async () => {},
    inspectAvailability: vi.fn(),
  };
