      {
        encoding: "utf8",
        timeout: 10_000,
        env: {
          PATH: process.env.PATH,
          REA_TEST_KUNA_FIXTURE: JSON.stringify({ kuna, cacheRoot, target }),
        },
      },
    );
    expect(result.error).toBeUndefined();
