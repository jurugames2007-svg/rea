  onTestFinished(async () => {
    releaseLaunch?.();
    await client.close();
  });
  const starting = client.callTool("current_document");
  await entered;
  expect(client.requestActivity()).toBeNull();
  expect(client.operationHealth()).toMatchObject({
    state: "busy",
    stage: "launch",
    retryAction: "wait",
  });
