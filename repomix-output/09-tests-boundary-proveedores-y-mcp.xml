  expect(retainedOwner).toBeDefined();
  expect(retainedOwner?.handle.fd).toBeGreaterThanOrEqual(0);
  await client.close();
  await expect(server.close()).rejects.toThrow("REA session cleanup failed");
  expect(retainedOwner?.handle.fd).toBeGreaterThanOrEqual(0);
  allowClose = true;
