    vi.stubEnv("REA_NATIVE_AMBIENT", "ambient-only");
    const environment = {
      REA_NATIVE_SELECTED: "selected",
      PATH: "/selected-path",
    };
    const runner = new XcrunCommandRunner(environment, async () =>
