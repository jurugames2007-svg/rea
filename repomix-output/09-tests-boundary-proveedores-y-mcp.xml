        }),
      );
      expect(launcher.processes).toHaveLength(0);
      release?.();
      await expect(waits[1 - cancelledIndex]).resolves.toMatchObject({
        ok: true,
        value: { value: "live peer" },
      });
      expect(launcher.processes).toHaveLength(1);
      expect(client.isReady()).toBe(true);
