    const firstEntry = entries[0];
    const secondEntry = entries[1];
    if (firstEntry === undefined || secondEntry === undefined)
      throw new Error("Expected both universal Mach-O slice entries");
    expect(secondEntry).toMatchObject({
      path: "slices/arm64",
