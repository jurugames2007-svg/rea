            ? ["-n com.example/.Main"]
            : [
                "-a android.intent.action.MAIN",
                "-d https://example.invalid/launch",
                "-n com.example/.Main",
                "--es mode test",
              ]),
        ].join(" "),
      ),
    );
  },
);
